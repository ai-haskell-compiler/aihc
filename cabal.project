packages:
  core-libs/aihc-base
  core-libs/aihc-internal
  bin/aihc
  components/aihc-resolve
  components/aihc-tc
  components/aihc-fc
  components/aihc-grin
  components/aihc-native
  components/aihc-amd64
  components/aihc-arm64
  components/aihc-c
  components/aihc-wasm
  bin/aihc-fmt
  tooling/aihc-hackage
  tooling/aihc-testing
  tooling/aihc-resolve-tooling-common
  tooling/aihc-dev
  https://github.com/ai-haskell-compiler/aihc-cpp/releases/download/v1.0.0.3/aihc-cpp-1.0.0.3.tar.gz
  https://github.com/ai-haskell-compiler/aihc-parser/releases/download/v1.0.0.4/aihc-parser-1.0.0.4.tar.gz

constraints:
  aihc-cpp ==1.0.0.3,
  aihc-parser ==1.0.0.4

package aihc-tc
  flags: +fuzz

package aihc-grin
  flags: +fuzz

tests: True
