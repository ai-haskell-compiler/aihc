packages:
  core-libs/aihc-base
  core-libs/aihc-internal
  core-libs/aihc-prim
  core-libs/aihc-rts
  core-libs/aihc-template-haskell
  bin/aihc
  components/aihc-resolve
  components/aihc-tc
  bin/aihc-fmt
  bin/aihc-haddock
  tooling/aihc-hackage
  tooling/aihc-package-plan
  tooling/aihc-testing
  tooling/aihc-resolve-tooling-common
  tooling/aihc-tc-tooling-common

-- Pinned to a git commit until the next aihc-parser release is on Hackage.
-- Keep this commit equal to the rev in scripts/nix/haskell-packages.nix.
source-repository-package
  type: git
  location: https://github.com/ai-haskell-compiler/aihc-parser.git
  tag: 46420da73d505555b46c03c00bd7fe44cb72e331

constraints:
  aihc-cpp ==2.0.0.0

package aihc-tc
  flags: +fuzz

tests: True
jobs: $ncpus
semaphore: False
