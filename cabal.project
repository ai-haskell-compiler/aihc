packages:
  core-libs/aihc-base
  core-libs/aihc-heap
  core-libs/aihc-internal
  core-libs/aihc-prim
  core-libs/aihc-rts
  core-libs/aihc-template-haskell
  bin/aihc
  components/aihc-resolve
  components/aihc-tc
  bin/aihc-haddock
  bin/aihc-play
  tooling/aihc-hackage
  tooling/aihc-hackage-fetch
  tooling/aihc-http
  tooling/aihc-package-plan
  tooling/aihc-testing
  tooling/aihc-resolve-tooling-common
  tooling/aihc-tc-tooling-common

constraints:
  aihc-parser ==5.0.0.0,
  aihc-cabal-syntax ==2.0.0.0,
  aihc-cpp ==2.0.0.0

package aihc-tc
  flags: +fuzz

-- Aihc does not use pkg-config. Thus, zlib links with extra-libraries: z.
package zlib
  flags: -pkg-config

tests: True
jobs: $ncpus
semaphore: False
