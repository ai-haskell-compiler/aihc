{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "AIHC LIR",
  "scopeName": "source.lir",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#names"
    },
    {
      "include": "#labels"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#types"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#instructions"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    },
    {
      "include": "#bare-labels"
    }
  ],
  "repository": {
    "comments": {
      "name": "comment.line.semicolon.lir",
      "begin": ";",
      "end": "$"
    },
    "names": {
      "patterns": [
        {
          "name": "string.quoted.double.lir variable.other.local.lir",
          "begin": "%\"",
          "end": "\"",
          "patterns": [
            {
              "include": "#escapes"
            }
          ]
        },
        {
          "name": "string.quoted.double.lir variable.other.global.lir",
          "begin": "@\"",
          "end": "\"",
          "patterns": [
            {
              "include": "#escapes"
            }
          ]
        },
        {
          "name": "variable.other.local.lir",
          "match": "%[A-Za-z0-9_.$]+"
        },
        {
          "name": "variable.other.global.lir",
          "match": "@[A-Za-z0-9_.$]+"
        }
      ]
    },
    "labels": {
      "patterns": [
        {
          "name": "string.quoted.double.lir entity.name.label.lir",
          "begin": "\"(?=(?:[^\"\\\\]|\\\\.)*\"\\s*[:(])",
          "end": "\"",
          "patterns": [
            {
              "include": "#escapes"
            }
          ]
        },
        {
          "name": "entity.name.label.lir",
          "match": "(?<![A-Za-z0-9_.$%@])(?:[A-Za-z_][A-Za-z0-9_.$]*)(?![A-Za-z0-9_.$])(?=\\s*(?:\\([^)]*\\))?\\s*:)"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.lir",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "include": "#escapes"
            }
          ]
        },
        {
          "name": "string.quoted.single.lir",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "include": "#escapes"
            }
          ]
        }
      ]
    },
    "escapes": {
      "name": "constant.character.escape.lir",
      "match": "\\\\(?:[\\\\\"'nrt0]|x[0-9A-Fa-f]{2}|u\\{[0-9A-Fa-f]{1,6}\\})"
    },
    "types": {
      "name": "storage.type.lir",
      "match": "(?<![A-Za-z0-9_.$%@])(?:i1|i8|i16|i32|i64|f32|f64|ptr|code)(?![A-Za-z0-9_.$])"
    },
    "keywords": {
      "name": "keyword.control.lir",
      "match": "(?<![A-Za-z0-9_.$%@])(?:export|extern|func|global|data|mut|align|const|include|cc|word|words|bytes|zero|to|jump|br|switch|default|return|tailcall|tailcall\\.indirect|trap)(?![A-Za-z0-9_.$])"
    },
    "instructions": {
      "name": "keyword.operator.instruction.lir",
      "match": "(?<![A-Za-z0-9_.$%@])(?:add|sub|mul|div\\.s|div\\.u|rem\\.s|rem\\.u|and|or|xor|shl|shr\\.s|shr\\.u|mul\\.wide\\.s|mul\\.wide\\.u|add\\.carry|sub\\.borrow|clz|ctz|popcount|pdep|pext|eq|ne|lt\\.s|lt\\.u|le\\.s|le\\.u|gt\\.s|gt\\.u|ge\\.s|ge\\.u|flt|fle|fgt|fge|fadd|fsub|fmul|fdiv|fneg|fabs|fsqrt|sext|zext|trunc|itof\\.s|itof\\.u|ftoi\\.s|ftoi\\.u|fpext|fptrunc|bitcast|ptr\\.to_int|ptr\\.from_int|select|load|store|ptr\\.add|stack\\.alloc|global\\.get|global\\.set|call|call\\.indirect)(?![A-Za-z0-9_.$])"
    },
    "numbers": {
      "name": "constant.numeric.lir",
      "match": "(?<![A-Za-z0-9_.$%@])(?:[+-]?(?:inf|nan|[0-9]+(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?))(?![A-Za-z0-9_.$])"
    },
    "constants": {
      "name": "constant.language.lir",
      "match": "(?<![A-Za-z0-9_.$%@])(?:null|aihc|c)(?![A-Za-z0-9_.$])"
    },
    "operators": {
      "name": "keyword.operator.lir",
      "match": "->|[=+*/%\\-]"
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.section.brackets.lir",
          "match": "[{}()\\[\\]]"
        },
        {
          "name": "punctuation.separator.lir",
          "match": "[:,]"
        }
      ]
    },
    "bare-labels": {
      "name": "entity.name.label.lir",
      "match": "(?<![A-Za-z0-9_.$%@])(?:[A-Za-z_][A-Za-z0-9_.$]*)(?![A-Za-z0-9_.$])"
    }
  }
}
