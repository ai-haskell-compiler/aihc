{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "AIHC System FC",
  "scopeName": "source.aihc-fc",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#scope-line"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#characters"
    },
    {
      "include": "#arrow"
    },
    {
      "include": "#axiom-names"
    },
    {
      "include": "#top-names"
    },
    {
      "include": "#primitive-operators"
    },
    {
      "include": "#unique-names"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#abi-types"
    },
    {
      "include": "#short-axiom-names"
    },
    {
      "include": "#short-top-names"
    },
    {
      "include": "#local-names"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    },
    {
      "include": "#invalid"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-dash.aihc-fc",
          "match": "--.*$"
        },
        {
          "name": "comment.block.aihc-fc",
          "begin": "\\{-",
          "end": "-\\}"
        }
      ]
    },
    "scope-line": {
      "match": "^(scope)\\s+(\\d+)\\s+(=)\\s+(\\\"(?:[^\\\"\\\\]|\\\\.)*\\\")\\s+(\\S+)\\s*$",
      "captures": {
        "1": {
          "name": "keyword.control.aihc-fc"
        },
        "2": {
          "name": "constant.numeric.aihc-fc"
        },
        "3": {
          "name": "keyword.operator.aihc-fc"
        },
        "4": {
          "name": "string.quoted.double.aihc-fc"
        },
        "5": {
          "name": "entity.name.namespace.aihc-fc"
        }
      }
    },
    "strings": {
      "name": "string.quoted.double.aihc-fc",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.aihc-fc",
          "match": "\\\\(?:x\\{[0-9A-Fa-f]+\\}|x[0-9A-Fa-f]{2}|.)"
        }
      ]
    },
    "characters": {
      "name": "string.quoted.single.aihc-fc",
      "match": "'(?:\\\\(?:x\\{[0-9A-Fa-f]+\\}|.)|[^'\\\\])'"
    },
    "arrow": {
      "match": "(\\d+\\.)(\u2192)",
      "captures": {
        "1": {
          "name": "entity.name.namespace.aihc-fc"
        },
        "2": {
          "name": "keyword.operator.arrow.aihc-fc"
        }
      }
    },
    "axiom-names": {
      "match": "(\\d+\\.)(\\$ax\\$[^\\s,;(){}\\[\\]]*)",
      "captures": {
        "1": {
          "name": "entity.name.namespace.aihc-fc"
        },
        "2": {
          "name": "entity.name.function.axiom.aihc-fc"
        }
      }
    },
    "top-names": {
      "patterns": [
        {
          "match": "(\\d+\\.)([ts](?:[^\\s,;(){}\\[\\]]*(?:\\[\\]|\\([#,]*\\))|[^\\s,;(){}\\[\\]]+))",
          "captures": {
            "1": {
              "name": "entity.name.namespace.aihc-fc"
            },
            "2": {
              "name": "entity.name.type.aihc-fc"
            }
          }
        },
        {
          "match": "(\\d+\\.)(c(?:[^\\s,;(){}\\[\\]]*(?:\\[\\]|\\([#,]*\\))|[^\\s,;(){}\\[\\]]+))",
          "captures": {
            "1": {
              "name": "entity.name.namespace.aihc-fc"
            },
            "2": {
              "name": "entity.name.constructor.aihc-fc"
            }
          }
        },
        {
          "match": "(\\d+\\.)(v(?:[^\\s,;(){}\\[\\]]*(?:\\[\\]|\\([#,]*\\))|[^\\s,;(){}\\[\\]]+))",
          "captures": {
            "1": {
              "name": "entity.name.namespace.aihc-fc"
            },
            "2": {
              "name": "entity.name.function.aihc-fc"
            }
          }
        }
      ]
    },
    "unique-names": {
      "match": "(?<![\\w$'#.])([A-Za-z_$][\\w$'#]*)(\\{)(\\d+)(\\})",
      "captures": {
        "1": {
          "name": "variable.other.aihc-fc"
        },
        "2": {
          "name": "punctuation.definition.unique.aihc-fc"
        },
        "3": {
          "name": "constant.numeric.unique.aihc-fc"
        },
        "4": {
          "name": "punctuation.definition.unique.aihc-fc"
        }
      }
    },
    "keywords": {
      "name": "keyword.control.aihc-fc",
      "match": "(?<![\\w$'#-])(?:function\\-address|value\\-binders|unboxed\\-tuple|interruptible|type\\-binders|constructors|unboxed\\-sum|constructor|real\\-world|inlinable|forall\\-co|noinline|tycon\\-co|axiom\\-co|synonyms|coercion|foreign|headers|address|dynamic|wrapper|inline|import|module|axioms|strict|return|app\\-co|nth\\-co|fun\\-co|unsafe|axiom|where|trans|scope|using|ccall|rule|type|prims|prim|case|refl|safe|pure|pub|val|let|rec|FUN|lit|sym|in|as|of|_)(?![\\w$'#{-])"
    },
    "abi-types": {
      "name": "storage.type.aihc-fc",
      "match": "(?<![\\w$'#-])(?:Word16|Word32|Word64|Double|Int16|Int32|Int64|Word8|Float|Int8|Word|Addr|Void|Int)(?![\\w$'#-])"
    },
    "local-names": {
      "name": "variable.other.aihc-fc",
      "match": "(?<![\\w$'#])[A-Za-z_$][\\w$'#]*"
    },
    "numbers": {
      "name": "constant.numeric.aihc-fc",
      "match": "(?<![\\w$'#])-?\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?"
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.binder.aihc-fc",
          "match": "[\u03bb\u039b\u2200]"
        },
        {
          "name": "keyword.operator.aihc-fc",
          "match": "::|->|\u2192|\u25b7|~[NRP~]?|[=:.@#!]"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.section.brackets.aihc-fc",
          "match": "[(){}\\[\\]]"
        },
        {
          "name": "punctuation.separator.aihc-fc",
          "match": "[,;]"
        }
      ]
    },
    "invalid": {
      "name": "invalid.illegal.unrecognized.aihc-fc",
      "match": "\\S"
    },
    "short-top-names": {
      "patterns": [
        {
          "match": "(?<![\\w$'.])([ts](?:[^\\s,;(){}\\[\\]]*(?:\\[\\]|\\([#,]*\\))|[^\\s,;(){}\\[\\]]+))(?![\\w$'#]|\\{)",
          "captures": {
            "1": {
              "name": "entity.name.type.aihc-fc"
            }
          }
        },
        {
          "match": "(?<![\\w$'.])(c(?:[^\\s,;(){}\\[\\]]*(?:\\[\\]|\\([#,]*\\))|[^\\s,;(){}\\[\\]]+))(?![\\w$'#]|\\{)",
          "captures": {
            "1": {
              "name": "entity.name.constructor.aihc-fc"
            }
          }
        },
        {
          "match": "(?<![\\w$'.])(v(?:[^\\s,;(){}\\[\\]]*(?:\\[\\]|\\([#,]*\\))|[^\\s,;(){}\\[\\]]+))(?![\\w$'#]|\\{)",
          "captures": {
            "1": {
              "name": "entity.name.function.aihc-fc"
            }
          }
        }
      ]
    },
    "short-axiom-names": {
      "name": "entity.name.function.axiom.aihc-fc",
      "match": "(?<![\\w$'.])\\$ax\\$[^\\s,;(){}\\[\\]]*"
    },
    "primitive-operators": {
      "name": "entity.name.function.aihc-fc",
      "match": "(?<![\\w$'#.])[!#$%&*+./<=>?@\\\\^|:~-]+#(?:\\{\\d+\\})?"
    }
  }
}
