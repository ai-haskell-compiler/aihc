scope 1 = "" Example
scope 2 = "aihc-prim" GHC.Types

import headers
  constructors [2.cLifted, 2.cUnlifted] 2.tLevity :: 2.sType;
  2.sLiftedRep :: 2.tRuntimeRep;
  constructors [2.cAddrRep, 2.cBoxedRep, 2.cDoubleRep, 2.cFloatRep, 2.cInt16Rep, 2.cInt32Rep, 2.cInt64Rep, 2.cInt8Rep, 2.cIntRep, 2.cSumRep, 2.cTupleRep, 2.cVecRep, 2.cWord16Rep, 2.cWord32Rep, 2.cWord64Rep, 2.cWord8Rep, 2.cWordRep] 2.tRuntimeRep :: 2.sType;
  2.tTYPE :: ∀(rep : 2.tRuntimeRep). 2.sType;
  2.sType :: 2.sType;
  constructors [2.c[], 2.c:] 2.t[] :: ∀(a : 2.sType). 2.sType;
  2.c: :: ∀(a : 2.sType). a 2.→ 2.t[] a 2.→ 2.t[] a;
  2.cBoxedRep :: 2.tLevity 2.→ 2.tRuntimeRep;
  2.cLifted :: 2.tLevity;
  2.c[] :: ∀(a : 2.sType). 2.t[] a

import synonyms
  2.sLiftedRep = 2.cBoxedRep 2.cLifted;
  2.sType = 2.tTYPE 2.sLiftedRep

pub val 1.vappend :: ∀(a : 2.sType). 2.t[] a 2.→ 2.t[] a 2.→ 2.t[] a
 = Λ(a : 2.sType).
  λ(x : 2.t[] a).
    λ(y : 2.t[] a).
      case x as (_scrut : 2.t[] a) return (2.t[] a) of {
          2.c[] →
              y;
          2.c: (x{1} : a) (xs : 2.t[] a) →
              2.c: @a x{1} (1.vappend @a xs y)
      }

-- A line comment.
{- A block comment. -}
axiom 1.$ax$Age : 1.tAge ~R 2.tInt

val 1.vlocal :: 2.tInt
 = let {
    as{0} : 2.tInt =
        1#2.cIntRep
} in
    'x'#2.cIntRep ▷ sym (1.$ax$Age)
