cabal-version: 3.8
name: aihc-play
version: 0.1.0.0
build-type: Simple
license: Unlicense
license-file: LICENSE
author: David Himmelstrup
maintainer: lemmih@gmail.com
category: Development
synopsis: The playground helper of The Lazy Reader, the illustrated guide to aihc
description:
  A small program that runs the front end of aihc over one module and
  answers with JSON. The guide compiles it to WebAssembly and runs it in
  the browser of the reader.

library
  exposed-modules:
    Aihc.Cli.PlayBundle
    Aihc.Cli.PlayBundleStore
    Aihc.Play
    Aihc.Play.Json
    Aihc.Play.Names
    Aihc.Play.Protocol
    Aihc.Play.Session
    Aihc.Play.Tree
    Aihc.Play.Types

  -- The bundle codec, the bundle writer, and the artifact codecs they
  -- use are source modules of the compiler package, compiled here in
  -- place as the wiring is, so the helper does not depend on the whole
  -- compiler library. The browser build of the helper never reaches the
  -- writer, so it does not need the directory package.
  other-modules:
    Aihc.Cbor
    Aihc.Cli.InterfaceParts
    Aihc.Cli.InterfaceTyCons
    Aihc.Cli.PackageManifest
    Aihc.Cli.ResolveArtifact
    Aihc.Cli.TypeArtifact
    Aihc.Prim.Wiring

  hs-source-dirs:
    src
    ../aihc/prim-wiring
    ../aihc/src

  build-depends:
    aihc-parser,
    aihc-resolve,
    aihc-tc,
    array,
    base >=4.16 && <5,
    binary,
    bytestring,
    containers,
    deepseq,
    directory,
    filepath,
    text >=1.2,
    transformers,

  -- The compiler package compiles its modules with OverloadedStrings.
  default-extensions: OverloadedStrings
  ghc-options: -Wall
  default-language: GHC2021

executable aihc-play
  hs-source-dirs: app
  main-is: Main.hs
  build-depends:
    aihc-play,
    base >=4.16 && <5,
    bytestring,
    text,

  ghc-options: -Wall
  default-language: GHC2021

test-suite spec
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Spec.hs
  build-depends:
    aihc-play,
    base >=4.16 && <5,
    bytestring,
    directory,
    filepath,
    tasty,
    tasty-hunit,
    text,

  default-extensions: OverloadedStrings
  ghc-options:
    -Wall
    -threaded
    -rtsopts
    -with-rtsopts=-N

  default-language: GHC2021
