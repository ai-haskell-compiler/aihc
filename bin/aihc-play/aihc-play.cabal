cabal-version: 3.8
name: aihc-play
version: 0.1.0.0
build-type: Simple
license: Unlicense
license-file: LICENSE
author: David Himmelstrup
maintainer: lemmih@gmail.com
category: Development
synopsis: The playground helper of The Lazy Reader, the illustrated guide to aihc
description:
  This program checks one module and produces JSON diagnostics or WASM
  assembly. It uses the shared compiler modules. The guide compiles the
  helper to WebAssembly and runs it in the browser.

library
  exposed-modules:
    Aihc.Play
    Aihc.Play.Compile
    Aihc.Play.Json
    Aihc.Play.Names
    Aihc.Play.Protocol
    Aihc.Play.Session
    Aihc.Play.Tree
    Aihc.Play.Types

  hs-source-dirs:
    src

  build-depends:
    aihc,
    aihc-parser,
    aihc-resolve,
    aihc-tc,
    base >=4.16 && <5,
    bytestring,
    containers,
    text >=1.2,

  -- The compiler package compiles its modules with OverloadedStrings.
  default-extensions: OverloadedStrings
  ghc-options: -Wall
  default-language: GHC2021

executable aihc-play
  hs-source-dirs: app
  main-is: Main.hs
  build-depends:
    aihc,
    aihc-play,
    base >=4.16 && <5,
    bytestring,
    text,

  ghc-options: -Wall
  default-language: GHC2021

test-suite spec
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Spec.hs
  build-depends:
    aihc,
    aihc-play,
    base >=4.16 && <5,
    bytestring,
    directory,
    filepath,
    tasty,
    tasty-hunit,
    text,

  default-extensions: OverloadedStrings
  ghc-options:
    -Wall
    -threaded
    -rtsopts
    -with-rtsopts=-N

  default-language: GHC2021
