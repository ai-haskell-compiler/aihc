cabal-version: 3.0
name: main-module
version: 0.1.0.0
build-type: Simple

-- The main-is file declares a module that is not Main.
executable named-main
  main-is: App/Run.hs
  hs-source-dirs: app
  build-depends: base
  default-language: Haskell2010

-- The module header comes from the preprocessed source.
executable cpp-main
  main-is: App/Cpp.hs
  hs-source-dirs: app
  build-depends: base
  default-language: Haskell2010
