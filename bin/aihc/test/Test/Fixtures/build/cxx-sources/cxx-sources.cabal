cabal-version: 3.0
name: cxx-sources
version: 0.1.0.0
build-type: Simple

library
  exposed-modules: Triangle
  hs-source-dirs: src
  cxx-sources: cbits/triangle.cpp
  cxx-options: -std=c++17
  build-depends: base
  default-language: Haskell2010

executable triangle
  main-is: Main.hs
  hs-source-dirs: app
  build-depends:
    base,
    cxx-sources,

  default-language: Haskell2010
