cabal-version: 3.0
name: shared-module-name
version: 0.1.0.0
build-type: Simple

executable shared
  main-is: Main.hs
  hs-source-dirs: app
  build-depends:
    base,
    same-a,
    same-b,

  default-language: Haskell2010
  default-extensions:
    DerivingStrategies
    GeneralizedNewtypeDeriving
    PackageImports
    StandaloneDeriving
