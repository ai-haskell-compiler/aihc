cabal-version: 3.0
name: custom-type-error
version: 0.1.0.0

library
  exposed-modules: Demand
  hs-source-dirs: src
  build-depends: base
  default-language: Haskell2010
  default-extensions:
    DataKinds
    FlexibleContexts
    NoImplicitPrelude
    TypeFamilies
    TypeOperators
    UndecidableInstances
