cabal-version: 3.0
name: newtype-polykinds
version: 0.1.0.0

library
  exposed-modules: Capture
  other-modules: Continuation
  hs-source-dirs: src
  build-depends: aihc-prim
  default-language: Haskell2010
  default-extensions:
    DerivingVia
    ExplicitForAll
    FlexibleInstances
    KindSignatures
    NoImplicitPrelude
    PolyKinds
    StandaloneDeriving
