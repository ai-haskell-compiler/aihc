cabal-version: 3.0
name: type-error-instance-context
version: 0.1.0.0

library
  exposed-modules: Whoops
  hs-source-dirs: src
  build-depends: base
  default-language: Haskell2010
  default-extensions:
    DataKinds
    FlexibleContexts
    FlexibleInstances
    KindSignatures
    NoImplicitPrelude
    TypeFamilies
    UndecidableInstances
