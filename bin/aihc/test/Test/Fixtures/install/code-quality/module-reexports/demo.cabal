cabal-version: 3.0
name: reexport-paths
version: 1.2.3

library tabular
  exposed-modules: Paths_reexport_paths
  autogen-modules: Paths_reexport_paths
  reexported-modules: Paths_reexport_paths as Happy.Paths
  build-depends: base
  default-language: Haskell2010

library backend
  exposed-modules: Backend
  hs-source-dirs: src
  build-depends:
    base,
    tabular,

  default-language: Haskell2010

library
  reexported-modules: Backend
  build-depends: backend
  default-language: Haskell2010
