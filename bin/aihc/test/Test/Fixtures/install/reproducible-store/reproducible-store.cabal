cabal-version: 3.0
name: reproducible-store
version: 0.1.0.0
build-type: Configure
extra-source-files: configure

library
  exposed-modules:
    Repro.Capi
    Repro.Constants

  hs-source-dirs: src
  include-dirs: include
  autogen-includes: ReproConfig.h
  build-depends: base
  default-language: Haskell2010
  default-extensions: CApiFFI
