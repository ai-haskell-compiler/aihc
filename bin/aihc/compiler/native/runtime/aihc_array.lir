; The boxed-array runtime, written in Lir. See docs/lir.md.
;
; An array object is a heap value whose header is @aihc_array_info, whose
; first field is the length, and whose elements follow. Every slot is eight
; bytes on every target, so the offsets below hold on a 64-bit and on a
; 32-bit target alike, and a header pointer travels through ptr.to_int.
;
;   offset 0        header      = @aihc_array_info
;   offset 8        fields[0]   = length
;   offset 16 + 8i  elements[i]
;
; The collector keeps aihc_array_length and aihc_array_elements in C: it
; walks arrays that the GC fuzz harness builds with info tables of its own,
; so the object-kind check stays where the collector can share it.

include "aihc_constants.lir"

extern func @aihc_fail(ptr) cc c
extern func @aihc_gc_allocate(ptr, i64) -> ptr cc c
extern func @aihc_record_allocation(ptr) cc c
extern func @aihc_array_length(ptr) -> i64 cc c

; The info table of every array. The collector reaches an array's elements
; from the length rather than from field_is_pointer, which stays null as it
; does for the C table this replaces.
data @aihc_array_info align 8 = {
  ptr null,   ; identity
  code null,  ; entry
  word 1,     ; field_count
  word 0,     ; remaining_arity
  ptr null,   ; field_is_pointer
  ptr null,   ; next
  code null,  ; backend_entry
  word @AIHC_FRAME_NONE,    ; frame_kind
  word @AIHC_OBJECT_ARRAY,  ; object_kind
  ptr null    ; srt
}

data @aihc_array_size_message align 1 = {
  bytes "boxed-array size is invalid", zero 1
}

data @aihc_array_bounds_message align 1 = {
  bytes "boxed-array index is out of bounds", zero 1
}

; Allocate an array of %count elements, each holding %initial.
;
; aihc_gc_allocate rejects a word count the address space cannot hold, so
; this checks only that %count is a plausible length. The upper bound is the
; largest count whose slots fit a 64-bit address space.
export func @aihc_array_new(%machine: ptr, %count: i64, %initial: i64) -> ptr cc c {
entry:
  %negative = lt.s i64 %count, 0
  %huge = gt.u i64 %count, 2305843009213693949
  %invalid = or i1 %negative, %huge
  br %invalid, invalid_size, allocate

invalid_size:
  call @aihc_fail(@aihc_array_size_message)
  trap "boxed-array size is invalid"

allocate:
  %words = add i64 %count, 2
  %array = call @aihc_gc_allocate(%machine, %words)
  call @aihc_record_allocation(%machine)
  %header = ptr.to_int @aihc_array_info
  store i64 %header, [%array] align 8
  store i64 %count, [%array + 8] align 8
  jump fill(0)

fill(%index: i64):
  %filled = ge.u i64 %index, %count
  br %filled, done, fill_slot

fill_slot:
  %offset = mul i64 %index, 8
  %slot = ptr.add %array, %offset
  store i64 %initial, [%slot + 16] align 8
  %next = add i64 %index, 1
  jump fill(%next)

done:
  return %array
}

; The address of element %index, after the bounds check. aihc_array_length
; rejects a value that is not an array before the comparison runs.
func @aihc_array_element(%array: ptr, %index: i64) -> ptr cc c {
entry:
  %count = call @aihc_array_length(%array)
  %negative = lt.s i64 %index, 0
  %past_end = ge.u i64 %index, %count
  %invalid = or i1 %negative, %past_end
  br %invalid, out_of_bounds, element

out_of_bounds:
  call @aihc_fail(@aihc_array_bounds_message)
  trap "boxed-array index is out of bounds"

element:
  %offset = mul i64 %index, 8
  %slot = ptr.add %array, %offset
  %address = ptr.add %slot, 16
  return %address
}

export func @aihc_array_index(%array: ptr, %index: i64) -> i64 cc c {
entry:
  %address = call @aihc_array_element(%array, %index)
  %value = load i64 [%address] align 8
  return %value
}

export func @aihc_array_write(%array: ptr, %index: i64, %value: i64) -> i64 cc c {
entry:
  %address = call @aihc_array_element(%array, %index)
  store i64 %value, [%address] align 8
  return 0
}

data @aihc_array_copy_message align 1 = {
  bytes "boxed-array copy length is invalid", zero 1
}

; Copy one element between two arrays. Both accesses go through
; aihc_array_element, so each one is bounds checked on its own array.
func @aihc_array_copy_element(%source: ptr, %source_offset: i64, %target: ptr, %target_offset: i64, %index: i64) cc c {
entry:
  %from = add i64 %source_offset, %index
  %to = add i64 %target_offset, %index
  %source_address = call @aihc_array_element(%source, %from)
  %value = load i64 [%source_address] align 8
  %target_address = call @aihc_array_element(%target, %to)
  store i64 %value, [%target_address] align 8
  return
}

; Copy %count elements from one array to another. The source and the target
; may be the same array, so a copy that moves a run towards a higher index
; within one array runs backwards and leaves the overlap intact.
export func @aihc_array_copy(%source: ptr, %source_offset: i64, %target: ptr, %target_offset: i64, %count: i64) -> i64 cc c {
entry:
  %negative = lt.s i64 %count, 0
  br %negative, invalid_length, choose

invalid_length:
  call @aihc_fail(@aihc_array_copy_message)
  trap "boxed-array copy length is invalid"

choose:
  %same = eq ptr %source, %target
  %after = gt.u i64 %target_offset, %source_offset
  %backwards = and i1 %same, %after
  br %backwards, backward(%count), forward(0)

forward(%index: i64):
  %reached_end = ge.u i64 %index, %count
  br %reached_end, done, forward_step

forward_step:
  call @aihc_array_copy_element(%source, %source_offset, %target, %target_offset, %index)
  %next = add i64 %index, 1
  jump forward(%next)

backward(%remaining: i64):
  %empty = eq i64 %remaining, 0
  br %empty, done, backward_step

backward_step:
  %previous = sub i64 %remaining, 1
  call @aihc_array_copy_element(%source, %source_offset, %target, %target_offset, %previous)
  jump backward(%previous)

done:
  return 0
}

; A fresh array holding the %count elements that start at %offset. Freezing a
; run, thawing one, and cloning one all land here: the three differ only in
; the type their caller gives the result.
export func @aihc_array_clone(%machine: ptr, %source: ptr, %offset: i64, %count: i64) -> ptr cc c {
entry:
  ; A null slot is a valid non-pointer to the collector, and nothing between
  ; the allocation and the copy allocates, so the fresh array is never
  ; scanned while it still holds the placeholder.
  %clone = call @aihc_array_new(%machine, %count, 0)
  %ignored = call @aihc_array_copy(%source, %offset, %clone, 0, %count)
  return %clone
}

; Drop the tail of a mutable array. The length lives in the object, and the
; collector reaches the elements from it, so the dropped slots stop being
; roots as soon as the length changes.
export func @aihc_array_shrink(%array: ptr, %count: i64) -> i64 cc c {
entry:
  %length = call @aihc_array_length(%array)
  %negative = lt.s i64 %count, 0
  %past_end = gt.u i64 %count, %length
  %invalid = or i1 %negative, %past_end
  br %invalid, invalid_size, shrink

invalid_size:
  call @aihc_fail(@aihc_array_size_message)
  trap "boxed-array size is invalid"

shrink:
  store i64 %count, [%array + 8] align 8
  return 0
}

; A mutable array of %count elements holding the prefix of %array that fits,
; with %initial in any slot beyond the old length.
export func @aihc_array_resize(%machine: ptr, %array: ptr, %count: i64, %initial: i64) -> ptr cc c {
entry:
  %length = call @aihc_array_length(%array)
  %shorter = lt.u i64 %count, %length
  %kept = select i64 %shorter, %count, %length
  %resized = call @aihc_array_new(%machine, %count, %initial)
  %ignored = call @aihc_array_copy(%array, 0, %resized, 0, %kept)
  return %resized
}
