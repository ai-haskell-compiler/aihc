scope 1 = "" Test
scope 2 = "aihc-prim" GHC.Types

import headers
  2.tLevity :: sType;
  2.sLiftedRep :: tRuntimeRep;
  2.tRuntimeRep :: sType;
  2.tTYPE :: ∀(rep : tRuntimeRep). sType;
  2.sType :: sType;
  2.t[] :: ∀(a : sType). sType;
  2.cBoxedRep :: tLevity → tRuntimeRep;
  2.cLifted :: tLevity;
  2.cTupleRep :: t[] tRuntimeRep → tRuntimeRep;
  2.c[] :: ∀(a : sType). t[] a

import synonyms
  2.sLiftedRep = cBoxedRep cLifted;
  2.sType = tTYPE sLiftedRep

pub type 1.tProxy (k : sType) (a : k) :: sType {
  pub 1.cProxy :: ∀(k : sType) (a : k). tProxy a
}

pub type 1.tSome :: sType {
  pub 1.cSome :: ∀(k : sType) (a : k). tProxy a → tSome
}

pub type 1.tIsFun (k : sType) :: sType {
  pub 1.cIsFun :: ∀(k : sType). FUN @(cTupleRep (c[] tRuntimeRep)) @sLiftedRep (k ~ (sType → sType)) (tIsFun k)
}

val 1.vrebuild :: ∀(k : sType) (f : k) (x : sType). tIsFun k → tSome
  = Λ(k : sType) (f : k) (x : sType). λ(evidence : tIsFun k).
    let! cIsFun (_ : k ~ (sType → sType)) = evidence;
    cSome @{sType} @(f x) (cProxy @{sType} @(f x))
