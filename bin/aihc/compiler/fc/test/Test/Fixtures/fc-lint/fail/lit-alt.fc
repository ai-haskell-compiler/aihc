scope 1 = "" Test
scope 2 = "aihc-prim" GHC.Types
scope 3 = "aihc-prim" GHC.Prim

import headers
  3.tInt# :: 2.tTYPE 2.cIntRep;
  2.tLevity :: 2.sType;
  2.sLiftedRep :: 2.tRuntimeRep;
  2.tRuntimeRep :: 2.sType;
  2.tTYPE :: ∀(rep : 2.tRuntimeRep). 2.sType;
  2.sType :: 2.sType;
  2.cBoxedRep :: 2.tLevity 2.→ 2.tRuntimeRep;
  2.cIntRep :: 2.tRuntimeRep;
  2.cLifted :: 2.tLevity

import synonyms
  2.sLiftedRep = 2.cBoxedRep 2.cLifted;
  2.sType = 2.tTYPE 2.sLiftedRep

pub type 1.tBool :: 2.sType {
    pub 1.cFalse :: 1.tBool;
    pub 1.cTrue :: 1.tBool
}

pub type 1.tIntRep :: 2.tRuntimeRep {}

pub type 1.tInt# :: 2.tTYPE 1.tIntRep {}

val 1.vbad :: 1.tBool
 = case 1.cTrue as (w : 1.tBool) return (1.tBool) of {
    1#1.tIntRep →
        1.cFalse;
    _ →
        1.cTrue
}
