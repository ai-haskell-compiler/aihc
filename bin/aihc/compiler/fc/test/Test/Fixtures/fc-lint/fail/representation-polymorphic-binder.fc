scope 1 = "" Test
scope 2 = "aihc-prim" GHC.Types

import headers
  2.tLevity :: sType;
  2.sLiftedRep :: tRuntimeRep;
  2.tRuntimeRep :: sType;
  2.tTYPE :: ∀(rep : tRuntimeRep). sType;
  2.sType :: sType;
  2.cBoxedRep :: tLevity → tRuntimeRep;
  2.cLifted :: tLevity

import synonyms
  2.sLiftedRep = cBoxedRep cLifted;
  2.sType = tTYPE sLiftedRep

pub type 1.tUnit :: sType {
  pub 1.cUnit :: tUnit
}

val 1.vbad :: ∀(rep : tRuntimeRep) (a : tTYPE rep). (tUnit → a) → a
  = Λ(rep : tRuntimeRep) (a : tTYPE rep). λ(k : tUnit → a).
    let x : a =
      k cUnit;
    x
