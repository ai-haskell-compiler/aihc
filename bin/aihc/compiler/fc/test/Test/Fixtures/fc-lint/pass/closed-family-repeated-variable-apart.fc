scope 1 = "" Test
scope 2 = "aihc-prim" GHC.Types

import headers
  2.tLevity :: 2.sType;
  2.sLiftedRep :: 2.tRuntimeRep;
  2.tRuntimeRep :: 2.sType;
  2.tTYPE :: ∀(rep : 2.tRuntimeRep). 2.sType;
  2.sType :: 2.sType;
  2.cBoxedRep :: 2.tLevity 2.→ 2.tRuntimeRep;
  2.cLifted :: 2.tLevity;
  2.tBool :: 2.sType;
  2.cTrue :: 2.tBool;
  2.cFalse :: 2.tBool

import synonyms
  2.sLiftedRep = 2.cBoxedRep 2.cLifted;
  2.sType = 2.tTYPE 2.sLiftedRep

pub type 1.tCon (c : 2.tBool) :: 2.sType {
    pub 1.cCon :: ∀(c : 2.tBool). 1.tCon c
}

pub type 1.tSame (left : 2.tBool) (right : 2.tBool) :: 2.tBool {}

axiom 1.$ax$Same$0 (same : 2.tBool) : 1.tSame same same ~N 2.cTrue
axiom 1.$ax$Same$1 (left : 2.tBool) (right : 2.tBool) : 1.tSame left right ~N 2.cFalse

val 1.vequal :: 1.tCon (1.tSame 2.cTrue 2.cTrue)
 = 1.cCon @2.cTrue

val 1.vdifferent :: 1.tCon (1.tSame 2.cTrue 2.cFalse)
 = 1.cCon @2.cFalse
