scope 1 = "" Test
scope 2 = "aihc-prim" GHC.Types

import headers
  2.tLevity :: 2.sType;
  2.sLiftedRep :: 2.tRuntimeRep;
  2.tRuntimeRep :: 2.sType;
  2.tTYPE :: ∀(rep : 2.tRuntimeRep). 2.sType;
  2.sType :: 2.sType;
  2.cBoxedRep :: 2.tLevity 2.→ 2.tRuntimeRep;
  2.cLifted :: 2.tLevity

import synonyms
  2.sLiftedRep = 2.cBoxedRep 2.cLifted;
  2.sType = 2.tTYPE 2.sLiftedRep

pub type 1.tBool :: 2.sType {
    pub 1.cFalse :: 1.tBool;
    pub 1.cTrue :: 1.tBool
}

val 1.vid :: ∀(a : 2.sType). a 2.→ a
 = Λ(a : 2.sType).
  λ(x : a).
    x

val 1.vnot :: 1.tBool 2.→ 1.tBool
 = λ(x : 1.tBool).
  case x as (w : 1.tBool) return (1.tBool) of {
      1.cTrue →
          1.cFalse;
      1.cFalse →
          1.cTrue
  }

val 1.vtrue :: 1.tBool
 = 1.vid @1.tBool 1.cTrue

val 1.vapply :: 1.tBool
 = 1.vnot 1.vtrue
