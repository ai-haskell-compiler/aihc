scope 1 = "" Test
scope 2 = "aihc-prim" GHC.Types

import headers
  2.tLevity :: 2.sType;
  2.sLiftedRep :: 2.tRuntimeRep;
  2.tRuntimeRep :: 2.sType;
  2.tTYPE :: ∀(rep : 2.tRuntimeRep). 2.sType;
  2.sType :: 2.sType;
  2.t[] :: ∀(a : 2.sType). 2.sType;
  2.cBoxedRep :: 2.tLevity 2.→ 2.tRuntimeRep;
  2.cLifted :: 2.tLevity;
  2.cTupleRep :: 2.t[] 2.tRuntimeRep 2.→ 2.tRuntimeRep;
  2.c[] :: ∀(a : 2.sType). 2.t[] a

import synonyms
  2.sLiftedRep = 2.cBoxedRep 2.cLifted;
  2.sType = 2.tTYPE 2.sLiftedRep

val 1.vid :: ∀(a : 2.sType). a 2.→ a
 = Λ(a : 2.sType).
  λ(x : a).
    x

val 1.vuse :: ∀(r : 2.tRuntimeRep) (s : 2.tRuntimeRep) (a : 2.tTYPE r). FUN @(2.cTupleRep (2.c[] 2.tRuntimeRep)) @2.sLiftedRep (r ~ s) (FUN @(2.cTupleRep (2.c[] 2.tRuntimeRep)) @2.sLiftedRep (2.sLiftedRep ~ s) (FUN @r @r a a))
 = Λ(r : 2.tRuntimeRep).
  Λ(s : 2.tRuntimeRep).
    Λ(a : 2.tTYPE r).
      λ(first : r ~ s).
        λ(second : 2.sLiftedRep ~ s).
          1.vid @a
