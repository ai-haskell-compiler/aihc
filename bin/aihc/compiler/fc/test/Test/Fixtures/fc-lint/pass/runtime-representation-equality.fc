scope 1 = "" Test
scope 2 = "aihc-prim" GHC.Types

import headers
  2.tLevity :: sType;
  2.sLiftedRep :: tRuntimeRep;
  2.tRuntimeRep :: sType;
  2.tTYPE :: ∀(rep : tRuntimeRep). sType;
  2.sType :: sType;
  2.t[] :: ∀(a : sType). sType;
  2.cBoxedRep :: tLevity → tRuntimeRep;
  2.cLifted :: tLevity;
  2.cTupleRep :: t[] tRuntimeRep → tRuntimeRep;
  2.c[] :: ∀(a : sType). t[] a

import synonyms
  2.sLiftedRep = cBoxedRep cLifted;
  2.sType = tTYPE sLiftedRep

val 1.vid :: ∀(a : sType). a → a
  = Λ(a : sType). λ(x : a).
    x

val 1.vuse :: ∀(r : tRuntimeRep) (s : tRuntimeRep) (a : tTYPE r). FUN @(cTupleRep (c[] tRuntimeRep)) @sLiftedRep (r ~ s) (FUN @(cTupleRep (c[] tRuntimeRep)) @sLiftedRep (sLiftedRep ~ s) (a → a))
  = Λ(r : tRuntimeRep) (s : tRuntimeRep) (a : tTYPE r). λ(_ : r ~ s) (_ : sLiftedRep ~ s).
    vid @a
