scope 1 = "" Test
scope 2 = "aihc-prim" GHC.Types
scope 3 = "dependency" Dependency

import headers
  2.tLevity :: 2.sType;
  2.sLiftedRep :: 2.tRuntimeRep;
  2.tRuntimeRep :: 2.sType;
  2.tTYPE :: ∀(rep : 2.tRuntimeRep). 2.sType;
  2.sType :: 2.sType;
  2.cBoxedRep :: 2.tLevity 2.→ 2.tRuntimeRep;
  2.cLifted :: 2.tLevity;
  2.tBool :: 2.sType;
  2.cFalse :: 2.tBool;
  3.tAnd :: ∀(a : 2.tBool). ∀(b : 2.tBool). 2.tBool

import synonyms
  2.sLiftedRep = 2.cBoxedRep 2.cLifted;
  2.sType = 2.tTYPE 2.sLiftedRep

import axioms
  3.$ax$And$9 (_ : 2.tBool) : 3.tAnd 2.cFalse _ ~N 2.cFalse;
  3.$ax$And$10 (a : 2.tBool) : 3.tAnd a 2.cFalse ~N 2.cFalse

pub type 1.tSing (b : 2.tBool) :: 2.sType {
    pub 1.cSing :: ∀(b : 2.tBool). 1.tSing b
}

val 1.vfalseAnd :: ∀(b : 2.tBool). 1.tSing (3.tAnd 2.cFalse b)
 = Λ(b : 2.tBool).
  1.cSing @2.cFalse
