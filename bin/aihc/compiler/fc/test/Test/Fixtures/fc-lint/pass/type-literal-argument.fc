scope 1 = "" Test
scope 2 = "aihc-prim" GHC.Types
scope 3 = "aihc-prim" GHC.Prim.Natural

import headers
  2.tLevity :: sType;
  2.sLiftedRep :: tRuntimeRep;
  3.tNatural :: sType;
  2.tRuntimeRep :: sType;
  2.tTYPE :: ∀(rep : tRuntimeRep). sType;
  2.sType :: sType;
  2.cBoxedRep :: tLevity → tRuntimeRep;
  2.cLifted :: tLevity

import synonyms
  2.sLiftedRep = cBoxedRep cLifted;
  2.sType = tTYPE sLiftedRep

pub type 1.tTagged (n : tNatural) :: sType {
  pub 1.cTagged :: ∀(n : tNatural). tTagged n
}

val 1.vsixteen :: tTagged (lit tNatural 16)
  = cTagged @(lit tNatural 16)

val 1.vsame :: tTagged (lit tNatural 16) → tTagged (lit tNatural 16)
  = λ(x : tTagged (lit tNatural 16)).
    x

val 1.vuse :: tTagged (lit tNatural 16)
  = vsame vsixteen
