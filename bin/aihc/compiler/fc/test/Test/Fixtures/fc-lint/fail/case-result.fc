scope 1 = "" Test
scope 2 = "aihc-prim" GHC.Types

import headers
  2.tLevity :: 2.sType;
  2.sLiftedRep :: 2.tRuntimeRep;
  2.tRuntimeRep :: 2.sType;
  2.tTYPE :: ∀(rep : 2.tRuntimeRep). 2.sType;
  2.sType :: 2.sType;
  2.cBoxedRep :: 2.tLevity 2.→ 2.tRuntimeRep;
  2.cLifted :: 2.tLevity

import synonyms
  2.sLiftedRep = 2.cBoxedRep 2.cLifted;
  2.sType = 2.tTYPE 2.sLiftedRep

pub type 1.tBool :: 2.sType {
    pub 1.cFalse :: 1.tBool;
    pub 1.cTrue :: 1.tBool
}

pub type 1.tOnly :: 2.sType {
    pub 1.cOnly :: 1.tBool 2.→ 1.tOnly
}

val 1.vbad :: 1.tBool
 = case 1.cOnly 1.cTrue as (w : 1.tOnly) return (1.tOnly) of {
    1.cOnly (value : 1.tBool) →
        value
}
