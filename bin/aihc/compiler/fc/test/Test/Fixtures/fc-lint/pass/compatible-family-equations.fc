scope 1 = "" Test
scope 2 = "aihc-prim" GHC.Types

import headers
  2.tLevity :: 2.sType;
  2.sLiftedRep :: 2.tRuntimeRep;
  2.tRuntimeRep :: 2.sType;
  2.tTYPE :: ∀(rep : 2.tRuntimeRep). 2.sType;
  2.sType :: 2.sType;
  2.cBoxedRep :: 2.tLevity 2.→ 2.tRuntimeRep;
  2.cLifted :: 2.tLevity;
  2.tBool :: 2.sType

import synonyms
  2.sLiftedRep = 2.cBoxedRep 2.cLifted;
  2.sType = 2.tTYPE 2.sLiftedRep

pub type 1.tIndex (a : 2.sType) :: 2.sType {}
pub type 1.tDimension (a : 2.sType) :: 2.sType {}
pub type 1.tProxy (a : 2.sType) :: 2.sType {}

axiom 1.$ax$Dimension$0 : 1.tDimension (1.tIndex 2.tBool) ~N 2.tBool
axiom 1.$ax$Dimension$1 (a : 2.sType) : 1.tDimension (1.tIndex a) ~N a

val 1.vcast :: ∀(a : 2.sType). 1.tProxy (1.tDimension (1.tIndex a)) 2.→ 1.tProxy a
 = Λ(a : 2.sType).
  λ(x : 1.tProxy (1.tDimension (1.tIndex a))).
    x
