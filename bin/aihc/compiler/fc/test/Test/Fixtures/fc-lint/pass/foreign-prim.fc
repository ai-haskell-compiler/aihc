scope 1 = "" Test
scope 2 = "aihc-prim" GHC.Types

import headers
  2.tLevity :: 2.sType;
  2.sLiftedRep :: 2.tRuntimeRep;
  2.tRuntimeRep :: 2.sType;
  2.tTYPE :: ∀(rep : 2.tRuntimeRep). 2.sType;
  2.sType :: 2.sType;
  2.cBoxedRep :: 2.tLevity 2.→ 2.tRuntimeRep;
  2.cLifted :: 2.tLevity

import synonyms
  2.sLiftedRep = 2.cBoxedRep 2.cLifted;
  2.sType = 2.tTYPE 2.sLiftedRep

val 1.vboom :: ∀(a : 2.sType) (b : 2.sType). a 2.→ b
 = Λ(a : 2.sType).
  Λ(b : 2.sType).
    λ(x : a).
      foreign {prim 1.vraise# :: ∀(a : 2.sType) (b : 2.sType). a 2.→ b} @a @b x
