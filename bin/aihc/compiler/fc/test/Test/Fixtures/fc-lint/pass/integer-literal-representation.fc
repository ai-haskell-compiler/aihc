scope 1 = "" Test
scope 2 = "aihc-prim" GHC.Types

import headers
  2.tLevity :: sType;
  2.sLiftedRep :: tRuntimeRep;
  2.tRuntimeRep :: sType;
  2.tTYPE :: ∀(rep : tRuntimeRep). sType;
  2.sType :: sType;
  2.cBoxedRep :: tLevity → tRuntimeRep;
  2.cLifted :: tLevity

import synonyms
  2.sLiftedRep = cBoxedRep cLifted;
  2.sType = tTYPE sLiftedRep

pub type 1.tIntRep :: tRuntimeRep {}

pub type 1.tSecret# :: tTYPE tIntRep {}

val 1.vsecret :: tSecret#
  = 1 :: tSecret#

val 1.vmakeSecret :: tSecret# → tSecret#
  = λ(_ : tSecret#).
    1 :: tSecret#

val 1.vapplySecret :: tSecret#
  = vmakeSecret (1 :: tSecret#)

val 1.vcaseSecret :: tSecret#
  = case 1 :: tSecret# of {
    1 →
      1 :: tSecret#;
    _ →
      1 :: tSecret#
  }
