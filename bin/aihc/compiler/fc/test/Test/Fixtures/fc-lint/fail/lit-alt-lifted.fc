scope 1 = "" Test
scope 2 = "aihc-prim" GHC.Types

import headers
  2.tLevity :: 2.tType;
  2.tLiftedRep :: 2.tRuntimeRep;
  2.tRuntimeRep :: 2.tType;
  2.tTYPE :: ∀(rep : 2.tRuntimeRep). 2.tType;
  2.tType :: 2.tType;
  2.vBoxedRep :: 2.tLevity 2.→ 2.tRuntimeRep;
  2.vLifted :: 2.tLevity

import synonyms
  2.tLiftedRep = 2.vBoxedRep 2.vLifted;
  2.tType = 2.tTYPE 2.tLiftedRep

pub type 1.tBool :: 2.tType {
    pub 1.vFalse :: 1.tBool;
    pub 1.vTrue :: 1.tBool
}

val 1.vbad :: 1.tBool
 = case 1.vTrue as (w : 1.tBool) return (1.tBool) of {
    1#2.tLiftedRep →
        1.vFalse;
    _ →
        1.vTrue
}
