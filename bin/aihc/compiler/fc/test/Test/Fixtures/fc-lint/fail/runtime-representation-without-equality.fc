scope 1 = "" Test
scope 2 = "aihc-prim" GHC.Types

import headers
  2.tLevity :: sType;
  2.sLiftedRep :: tRuntimeRep;
  2.tRuntimeRep :: sType;
  2.tTYPE :: ∀(rep : tRuntimeRep). sType;
  2.sType :: sType;
  2.cBoxedRep :: tLevity → tRuntimeRep;
  2.cLifted :: tLevity

import synonyms
  2.sLiftedRep = cBoxedRep cLifted;
  2.sType = tTYPE sLiftedRep

val 1.vid :: ∀(a : sType). a → a
  = Λ(a : sType). λ(x : a).
    x

val 1.vbad :: ∀(r : tRuntimeRep) (a : tTYPE r). a → a
  = Λ(r : tRuntimeRep) (a : tTYPE r).
    vid @a
