scope 1 = "" Test
scope 2 = "aihc-prim" GHC.Types

import headers
  2.tLevity :: sType;
  2.sLiftedRep :: tRuntimeRep;
  2.tRuntimeRep :: sType;
  2.tTYPE :: ∀(rep : tRuntimeRep). sType;
  2.sType :: sType;
  2.cBoxedRep :: tLevity → tRuntimeRep;
  2.cLifted :: tLevity

import synonyms
  2.sLiftedRep = cBoxedRep cLifted;
  2.sType = tTYPE sLiftedRep

pub type 1.tMark :: sType {
  pub 1.cMarked :: tMark
}

pub type 1.t$Dict$Markable (a : sType) :: sType {
  pub 1.c$Dict$Markable :: ∀(a : sType). (a → tMark) → t$Dict$Markable a
}

pub type 1.tBox :: sType {
  pub 1.cBox :: ∀(a : sType). t$Dict$Markable a → a → tBox
}

pub val 1.vinspect :: tBox → tMark
  = λ(x : tBox).
    let! cBox @(a : sType) (_ : t$Dict$Markable b) (_ : b) = x;
    cMarked
