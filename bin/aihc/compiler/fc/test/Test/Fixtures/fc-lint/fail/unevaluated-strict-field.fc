scope 1 = "" Test
scope 2 = "aihc-prim" GHC.Types

import headers
  2.tLevity :: sType;
  2.sLiftedRep :: tRuntimeRep;
  2.tRuntimeRep :: sType;
  2.tTYPE :: ∀(rep : tRuntimeRep). sType;
  2.sType :: sType;
  2.cBoxedRep :: tLevity → tRuntimeRep;
  2.cLifted :: tLevity

import synonyms
  2.sLiftedRep = cBoxedRep cLifted;
  2.sType = tTYPE sLiftedRep

pub type 1.tBool :: sType {
  pub 1.cFalse :: tBool;
  pub 1.cTrue :: tBool
}

pub type 1.tBox :: sType {
  pub strict [0] 1.cBox :: tBool → tBool → tBox
}

val 1.vbox :: tBool → tBox
  = λ(x : tBool).
    cBox x x
