scope 1 = "" Test
scope 2 = "aihc-prim" GHC.Types

import headers
  2.tLevity :: sType;
  2.sLiftedRep :: tRuntimeRep;
  2.tRuntimeRep :: sType;
  2.tTYPE :: ∀(rep : tRuntimeRep). sType;
  2.sType :: sType;
  2.cBoxedRep :: tLevity → tRuntimeRep;
  2.cLifted :: tLevity

import synonyms
  2.sLiftedRep = cBoxedRep cLifted;
  2.sType = tTYPE sLiftedRep

pub type 1.tInt :: sType {
  pub 1.cI :: tInt
}

pub type 1.tAge :: sType {}

axiom 1.$ax$Age : tAge ~R tInt

pub type 1.tBox (a : sType) :: sType {}

val 1.vproof :: tBox tAge ~ tBox tInt
  = coercion (app-co (refl tBox) (axiom-co $ax$Age))
