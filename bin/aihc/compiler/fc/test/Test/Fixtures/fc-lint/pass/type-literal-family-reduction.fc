scope 1 = "" Test
scope 2 = "aihc-prim" GHC.Types
scope 3 = "aihc-prim" GHC.Prim.Natural
scope 4 = "aihc-base" GHC.TypeNats

import headers
  4.t+ :: tNatural → tNatural → tNatural;
  4.tCmpNat :: tNatural → tNatural → tOrdering;
  2.tLevity :: sType;
  2.sLiftedRep :: tRuntimeRep;
  3.tNatural :: sType;
  2.tOrdering :: sType;
  2.tRuntimeRep :: sType;
  2.tTYPE :: ∀(rep : tRuntimeRep). sType;
  2.sType :: sType;
  2.cBoxedRep :: tLevity → tRuntimeRep;
  2.cLT :: tOrdering;
  2.cLifted :: tLevity

import synonyms
  2.sLiftedRep = cBoxedRep cLifted;
  2.sType = tTYPE sLiftedRep

pub type 1.tOrd (o : tOrdering) :: sType {
  pub 1.cOrd :: ∀(o : tOrdering). tOrd o
}

pub type 1.tTagged (n : tNatural) :: sType {
  pub 1.cTagged :: ∀(n : tNatural). tTagged n
}

val 1.vless :: tOrd (tCmpNat (lit tNatural 1) (lit tNatural 2))
  = cOrd @cLT

val 1.vsum :: tTagged (t+ (lit tNatural 2) (lit tNatural 3))
  = cTagged @(lit tNatural 5)
