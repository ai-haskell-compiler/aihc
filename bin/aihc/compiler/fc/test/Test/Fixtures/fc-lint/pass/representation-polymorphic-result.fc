scope 1 = "" Test
scope 2 = "aihc-prim" GHC.Types

import headers
  2.tLevity :: 2.sType;
  2.sLiftedRep :: 2.tRuntimeRep;
  2.tRuntimeRep :: 2.sType;
  2.tTYPE :: ∀(rep : 2.tRuntimeRep). 2.sType;
  2.sType :: 2.sType;
  2.cBoxedRep :: 2.tLevity 2.→ 2.tRuntimeRep;
  2.cLifted :: 2.tLevity

import synonyms
  2.sLiftedRep = 2.cBoxedRep 2.cLifted;
  2.sType = 2.tTYPE 2.sLiftedRep

pub type 1.tUnit :: 2.sType {
    pub 1.cUnit :: 1.tUnit
}

val 1.vtransfer :: ∀(r : 2.tRuntimeRep) (a : 2.tTYPE r). FUN @2.sLiftedRep @r (FUN @2.sLiftedRep @r 1.tUnit a) a
 = Λ(r : 2.tRuntimeRep).
  Λ(a : 2.tTYPE r).
    λ(k : FUN @2.sLiftedRep @r 1.tUnit a).
      k 1.cUnit
