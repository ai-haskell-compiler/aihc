scope 1 = "" Test
scope 2 = "aihc-prim" GHC.Types

import headers
  2.tLevity :: 2.sType;
  2.sLiftedRep :: 2.tRuntimeRep;
  2.tRuntimeRep :: 2.sType;
  2.tTYPE :: ∀(rep : 2.tRuntimeRep). 2.sType;
  2.sType :: 2.sType;
  2.cBoxedRep :: 2.tLevity 2.→ 2.tRuntimeRep;
  2.cLifted :: 2.tLevity

import synonyms
  2.sLiftedRep = 2.cBoxedRep 2.cLifted;
  2.sType = 2.tTYPE 2.sLiftedRep

pub type 1.tBool :: 2.sType {
    pub 1.cFalse :: 1.tBool;
    pub 1.cTrue :: 1.tBool
}

pub type 1.tBox :: 2.sType {
    pub strict [0] 1.cBox :: 1.tBool 2.→ 1.tBool 2.→ 1.tBox
}

val 1.vforced :: 1.tBool 2.→ 1.tBox
 = λ(x : 1.tBool).
  case x as (y : 1.tBool) return (1.tBox) of {
      _ →
          1.cBox y x
  }

val 1.vscrutinee :: 1.tBool 2.→ 1.tBox
 = λ(x : 1.tBool).
  case x as (y : 1.tBool) return (1.tBox) of {
      _ →
          1.cBox x x
  }

val 1.vfield :: 1.tBox 2.→ 1.tBox
 = λ(box : 1.tBox).
  case box as (z : 1.tBox) return (1.tBox) of {
      1.cBox (first : 1.tBool) (second : 1.tBool) →
          1.cBox first second
  }

val 1.vvalue :: 1.tBool 2.→ 1.tBox
 = λ(x : 1.tBool).
  let {
      v : 1.tBool = 1.cTrue
  } in
      1.cBox v x

val 1.vconstructor :: 1.tBool 2.→ 1.tBox
 = λ(x : 1.tBool).
  1.cBox 1.cFalse x
