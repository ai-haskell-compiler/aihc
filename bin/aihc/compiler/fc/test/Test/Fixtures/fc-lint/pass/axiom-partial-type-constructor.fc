scope 1 = "" Test
scope 2 = "aihc-prim" GHC.Types

import headers
  2.tLevity :: 2.tType;
  2.tLiftedRep :: 2.tRuntimeRep;
  2.tRuntimeRep :: 2.tType;
  2.tTYPE :: ∀(rep : 2.tRuntimeRep). 2.tType;
  2.tType :: 2.tType;
  2.vBoxedRep :: 2.tLevity 2.→ 2.tRuntimeRep;
  2.vLifted :: 2.tLevity

import synonyms
  2.tLiftedRep = 2.vBoxedRep 2.vLifted;
  2.tType = 2.tTYPE 2.tLiftedRep

pub type 1.tSum (f : 2.tType 2.→ 2.tType) (g : 2.tType 2.→ 2.tType) (p : 2.tType) :: 2.tType {
    pub 1.vL1 :: ∀(f : 2.tType 2.→ 2.tType) (g : 2.tType 2.→ 2.tType) (p : 2.tType). f p 2.→ 1.tSum f g p
}

pub type 1.tTagged (s : 2.tType 2.→ 2.tType) (b : 2.tType) :: 2.tType {}

axiom 1.$ax$Tagged (s : 2.tType 2.→ 2.tType) (b : 2.tType) : 1.tTagged s b ~R b

pub type 1.tUnit :: 2.tType {
    pub 1.vUnit :: 1.tUnit
}

val 1.vtagged :: ∀(a : 2.tType 2.→ 2.tType) (b : 2.tType 2.→ 2.tType). 1.tTagged (1.tSum a b) 1.tUnit
 = Λ(a : 2.tType 2.→ 2.tType).
  Λ(b : 2.tType 2.→ 2.tType).
    1.vUnit ▷ sym (axiom-co 1.$ax$Tagged @(1.tSum a b) @1.tUnit)

val 1.vretagged :: ∀(a : 2.tType 2.→ 2.tType) (b : 2.tType 2.→ 2.tType). 1.tTagged (1.tSum a b) 1.tUnit 2.→ 1.tTagged (1.tSum a b) 1.tUnit
 = Λ(a : 2.tType 2.→ 2.tType).
  Λ(b : 2.tType 2.→ 2.tType).
    λ(x : 1.tTagged (1.tSum a b) 1.tUnit).
      x ▷ tycon-co 1.tTagged (refl (1.tSum a b)) (refl 1.tUnit)
