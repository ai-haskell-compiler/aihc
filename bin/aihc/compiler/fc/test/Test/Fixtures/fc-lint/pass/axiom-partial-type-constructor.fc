scope 1 = "" Test
scope 2 = "aihc-prim" GHC.Types

import headers
  2.tLevity :: sType;
  2.sLiftedRep :: tRuntimeRep;
  2.tRuntimeRep :: sType;
  2.tTYPE :: ∀(rep : tRuntimeRep). sType;
  2.sType :: sType;
  2.cBoxedRep :: tLevity → tRuntimeRep;
  2.cLifted :: tLevity

import synonyms
  2.sLiftedRep = cBoxedRep cLifted;
  2.sType = tTYPE sLiftedRep

pub type 1.tSum (f : sType → sType) (g : sType → sType) (p : sType) :: sType {
  pub 1.cL1 :: ∀(f : sType → sType) (g : sType → sType) (p : sType). f p → tSum f g p
}

pub type 1.tTagged (s : sType → sType) (b : sType) :: sType {}

axiom 1.$ax$Tagged (s : sType → sType) (b : sType) : tTagged s b ~R b

pub type 1.tUnit :: sType {
  pub 1.cUnit :: tUnit
}

val 1.vtagged :: ∀(a : sType → sType) (b : sType → sType). tTagged (tSum a b) tUnit
  = Λ(a : sType → sType) (b : sType → sType).
    cUnit ▷ sym (axiom-co $ax$Tagged @(tSum a b) @tUnit)

val 1.vretagged :: ∀(a : sType → sType) (b : sType → sType). tTagged (tSum a b) tUnit → tTagged (tSum a b) tUnit
  = Λ(a : sType → sType) (b : sType → sType). λ(x : tTagged (tSum a b) tUnit).
    x ▷ tycon-co tTagged (refl (tSum a b)) (refl tUnit)
