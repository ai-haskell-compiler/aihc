scope 1 = "" Test
scope 2 = "aihc-prim" GHC.Types

import headers
  2.tLevity :: 2.sType;
  2.sLiftedRep :: 2.tRuntimeRep;
  2.tRuntimeRep :: 2.sType;
  2.tTYPE :: ∀(rep : 2.tRuntimeRep). 2.sType;
  2.sType :: 2.sType;
  2.cBoxedRep :: 2.tLevity 2.→ 2.tRuntimeRep;
  2.cLifted :: 2.tLevity

import synonyms
  2.sLiftedRep = 2.cBoxedRep 2.cLifted;
  2.sType = 2.tTYPE 2.sLiftedRep

pub type 1.tMark :: 2.sType {
    pub 1.cMarked :: 1.tMark
}

pub type 1.t$Dict$Markable (a : 2.sType) :: 2.sType {
    pub 1.c$Dict$Markable :: ∀(a : 2.sType). (a 2.→ 1.tMark) 2.→ 1.t$Dict$Markable a
}

pub type 1.tBox :: 2.sType {
    pub 1.cBox :: ∀(a : 2.sType). 1.t$Dict$Markable a 2.→ a 2.→ 1.tBox
}

pub val 1.vinspect :: 1.tBox 2.→ 1.tMark
 = λ(x : 1.tBox).
  case x as (_scrut : 1.tBox) return (1.tMark) of {
      1.cBox ($pattern_d0 : 1.t$Dict$Markable a) (value : a) →
          1.cMarked
  }
