scope 1 = "" Test
scope 2 = "aihc-prim" GHC.Types

import headers
  2.tLevity :: 2.sType;
  2.sLiftedRep :: 2.tRuntimeRep;
  2.tRuntimeRep :: 2.sType;
  2.tTYPE :: ∀(rep : 2.tRuntimeRep). 2.sType;
  2.sType :: 2.sType;
  2.cBoxedRep :: 2.tLevity 2.→ 2.tRuntimeRep;
  2.cLifted :: 2.tLevity

import synonyms
  2.sLiftedRep = 2.cBoxedRep 2.cLifted;
  2.sType = 2.tTYPE 2.sLiftedRep

pub type 1.tInt :: 2.sType {
    pub 1.cI :: 1.tInt
}

pub type 1.tAge :: 2.sType {}

axiom 1.$ax$Age : 1.tAge ~R 1.tInt

pub type 1.tBox (a : 2.sType) :: 2.sType {}

val 1.vproof :: 1.tAge ~ 1.tInt
 = coercion (nth-co 0 (app-co (refl 1.tBox) (axiom-co 1.$ax$Age)))
