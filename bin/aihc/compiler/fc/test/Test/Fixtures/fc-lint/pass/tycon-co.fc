scope 1 = "" Test
scope 2 = "aihc-prim" GHC.Types

import headers
  2.tLevity :: 2.sType;
  2.sLiftedRep :: 2.tRuntimeRep;
  2.tRuntimeRep :: 2.sType;
  2.tTYPE :: ∀(rep : 2.tRuntimeRep). 2.sType;
  2.sType :: 2.sType;
  2.cBoxedRep :: 2.tLevity 2.→ 2.tRuntimeRep;
  2.cLifted :: 2.tLevity

import synonyms
  2.sLiftedRep = 2.cBoxedRep 2.cLifted;
  2.sType = 2.tTYPE 2.sLiftedRep

pub type 1.tMaybe (a : 2.sType) :: 2.sType {
    pub 1.cNothing :: ∀(a : 2.sType). 1.tMaybe a
}

val 1.vidMaybe :: ∀(a : 2.sType). 1.tMaybe a 2.→ 1.tMaybe a
 = Λ(a : 2.sType).
  λ(x : 1.tMaybe a).
    x ▷ tycon-co 1.tMaybe (refl a)
