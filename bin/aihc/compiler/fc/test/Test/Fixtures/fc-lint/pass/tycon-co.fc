scope 1 = "" Test
scope 2 = "aihc-prim" GHC.Types

import headers
  2.tLevity :: sType;
  2.sLiftedRep :: tRuntimeRep;
  2.tRuntimeRep :: sType;
  2.tTYPE :: ∀(rep : tRuntimeRep). sType;
  2.sType :: sType;
  2.cBoxedRep :: tLevity → tRuntimeRep;
  2.cLifted :: tLevity

import synonyms
  2.sLiftedRep = cBoxedRep cLifted;
  2.sType = tTYPE sLiftedRep

pub type 1.tMaybe (a : sType) :: sType {
  pub 1.cNothing :: ∀(a : sType). tMaybe a
}

val 1.vidMaybe :: ∀(a : sType). tMaybe a → tMaybe a
  = Λ(a : sType). λ(x : tMaybe a).
    x ▷ tycon-co tMaybe (refl a)
