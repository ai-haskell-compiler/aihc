scope 1 = "" Test
scope 2 = "aihc-prim" GHC.Types
scope 3 = "aihc-prim" GHC.Classes

import headers
  3.t$Dict$CTuple0 :: sType;
  2.tBool :: sType;
  2.tLevity :: sType;
  2.sLiftedRep :: tRuntimeRep;
  2.tRuntimeRep :: sType;
  2.tTYPE :: ∀(rep : tRuntimeRep). sType;
  2.sType :: sType;
  2.cBoxedRep :: tLevity → tRuntimeRep;
  2.cFalse :: tBool;
  2.cLifted :: tLevity;
  2.cTrue :: tBool

import synonyms
  2.sLiftedRep = cBoxedRep cLifted;
  2.sType = tTYPE sLiftedRep

pub type 1.tCon (c : sType) :: sType {
  pub 1.cCon :: ∀(c : sType). tCon c
}

pub type 1.tAssert (check : tBool) (message : sType) :: sType {}

axiom 1.$ax$Assert$0 (_ : sType) : tAssert cTrue _ ~N t$Dict$CTuple0

axiom 1.$ax$Assert$1 (message : sType) (_ : tBool) : tAssert _ message ~N message

pub type 1.tInt :: sType {}

pub type 1.tCheck (g : sType) :: tBool {}

axiom 1.$ax$Check$Int : tCheck tInt ~N cTrue

val 1.vfirst :: tCon (tAssert cTrue tBool)
  = cCon @t$Dict$CTuple0

val 1.vsecond :: tCon (tAssert cFalse tBool)
  = cCon @tBool

val 1.vstuck :: ∀(g : sType). tCon (tAssert (tCheck g) tBool) → tCon (tAssert (tCheck g) tBool)
  = Λ(g : sType). λ(x : tCon (tAssert (tCheck g) tBool)).
    x
