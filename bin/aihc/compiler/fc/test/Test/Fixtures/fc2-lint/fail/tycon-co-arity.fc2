scope 1 = "" Test
scope 2 = "aihc-prim" GHC.Types

import header 2.tLevity :: 2.tType

import header 2.tLiftedRep :: 2.tRuntimeRep

import header 2.tRuntimeRep :: 2.tType

import header 2.tTYPE :: ∀(rep : 2.tRuntimeRep). 2.tType

import header 2.tType :: 2.tType

import header 2.vBoxedRep :: 2.tLevity 2.→ 2.tRuntimeRep

import header 2.vLifted :: 2.tLevity

import synonym 2.tLiftedRep = 2.vBoxedRep 2.vLifted

import synonym 2.tType = 2.tTYPE 2.tLiftedRep

pub type 1.tMaybe (a : 2.tType) :: 2.tType {
    pub 1.vNothing :: ∀(a : 2.tType). 1.tMaybe a
}

val 1.vbad :: ∀(a : 2.tType). 1.tMaybe a 2.→ 1.tMaybe a
 = Λ(a : 2.tType).
  λ(x : 1.tMaybe a).
    x ▷ tycon-co 1.tMaybe (refl a) (refl a)
