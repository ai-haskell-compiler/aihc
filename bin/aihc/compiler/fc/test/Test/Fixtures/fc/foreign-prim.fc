scope 1 = "" Test
scope 2 = "aihc-prim" GHC.Types

import prims
  raise# = 1.vraise# :: ∀(a : 2.tType) (b : 2.tType). FUN @2.sLiftedRep @2.sLiftedRep a b

pub val 1.vboom :: ∀(a : 2.tType) (b : 2.tType). FUN @2.sLiftedRep @2.sLiftedRep a b
  = Λ(a : 2.tType) (b : 2.tType). λ(x : a).
    prim raise# @a @b x
