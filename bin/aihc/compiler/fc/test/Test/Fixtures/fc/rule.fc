scope 1 = "" Test
scope 2 = "aihc-prim" GHC.Types

import headers
  2.tLevity :: sType;
  2.sLiftedRep :: tRuntimeRep;
  2.tRuntimeRep :: sType;
  2.tTYPE :: ∀(rep : tRuntimeRep). sType;
  2.sType :: sType;
  2.cBoxedRep :: tLevity 2.→ tRuntimeRep;
  2.cLifted :: tLevity

import synonyms
  2.sLiftedRep = cBoxedRep cLifted;
  2.sType = tTYPE sLiftedRep

pub type 1.tNat :: sType {
  pub 1.cZ :: tNat;
  pub 1.cS :: tNat 2.→ tNat
}

pub type 1.tList (a : sType) :: sType {
  pub 1.cNil :: ∀(a : sType). tList a;
  pub 1.cCons :: ∀(a : sType). a 2.→ tList a 2.→ tList a
}

pub type 1.t$Dict$C (a : sType) :: sType {
  pub 1.c$Dict$C :: ∀(a : sType). (a 2.→ a) 2.→ t$Dict$C a
}

pub val 1.vop :: ∀(a : sType). t$Dict$C a 2.→ a 2.→ a
  = Λ(a : sType). λ($d0 : t$Dict$C a).
    let! c$Dict$C ($method0 : a 2.→ a) as ($dict : t$Dict$C a) = $d0;
    $method0

pub val 1.vmap :: ∀(a : sType) (b : sType). (a 2.→ b) 2.→ tList a 2.→ tList b
  = Λ(a : sType) (b : sType). λ(x : a 2.→ b) (y : tList a).
    case y as (_scrut : tList a) of {
      cNil →
        cNil @b;
      cCons (y{1} : a) (ys : tList a) →
        cCons @b (x y{1}) (vmap @a @b x ys)
    }

pub val 1.videntity :: ∀(a : sType). a 2.→ a
  = Λ(a : sType). λ(x : a).
    x

rule "map/map" [2] Λ(a : sType). λ(f : a 2.→ a). λ(g : a 2.→ a). λ(xs : tList a).
  vmap @a @a f (vmap @a @a g xs)
 = vmap @a @a g (vmap @a @a f xs)
 :: tList a

rule "map/id" Λ(a : sType). λ(xs : tList a).
  vmap @a @a (videntity @a) xs
 = xs
 :: tList a

rule "op/op" [~1] Λ(a : sType). λ($rd0 : t$Dict$C a). λ(x : a).
  vop @a $rd0 (vop @a $rd0 x)
 = vop @a $rd0 x
 :: a
