scope 1 = "" StrictLet
scope 2 = "aihc-prim" GHC.Types

pub type 1.tFlag :: 2.tType {
  pub 1.cOff :: tFlag;
  pub 1.cOn :: tFlag
}

pub type 1.tPair :: 2.tType {
  pub 1.cPair :: FUN @2.sLiftedRep @2.sLiftedRep tFlag (FUN @2.sLiftedRep @2.sLiftedRep tFlag tPair)
}

pub val 1.vfirst :: FUN @2.sLiftedRep @2.sLiftedRep tPair tFlag
  = λ(pair : tPair).
    let! cPair (left : tFlag) (_ : tFlag) = pair;
    left

pub val 1.vforce :: FUN @2.sLiftedRep @2.sLiftedRep tFlag tFlag
  = λ(flag : tFlag).
    let! _ = flag;
    cOn

pub val 1.vnested :: FUN @2.sLiftedRep @2.sLiftedRep tPair tFlag
  = λ(pair : tPair).
    let! _ as (inner : tFlag) =
      let! cPair (_ : tFlag) (right : tFlag) = pair;
      right;
    case inner of {
      cOff →
        let! cPair (other : tFlag) (_ : tFlag) = pair;
        other;
      cOn →
        cOff
    }
