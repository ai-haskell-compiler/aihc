scope 1 = "" Keywords
scope 2 = "aihc-prim" GHC.Types

pub type 1.tFlag :: 2.tType {
  pub 1.cOff :: tFlag;
  pub 1.cOn :: tFlag
}

pub val 1.vtoggle :: FUN @2.sLiftedRep @2.sLiftedRep tFlag tFlag
  = λ(letter : tFlag).
    let recent : tFlag =
      letter;
    case recent of {
      cOff →
        cOn;
      cOn →
        cOff
    }
