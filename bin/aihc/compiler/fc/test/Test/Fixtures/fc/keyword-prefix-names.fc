scope 1 = "" Keywords
scope 2 = "aihc-prim" GHC.Types

pub type 1.tFlag :: 2.tType {
  pub 1.cOff :: tFlag;
  pub 1.cOn :: tFlag
}

pub val 1.vtoggle :: tFlag 2.→ tFlag
  = λ(letter : tFlag).
    let recent : tFlag =
        letter;
      case recent as (cases : tFlag) of {
        cOff →
          cOn;
        cOn →
          cOff
      }
