scope 1 = "" Keywords
scope 2 = "aihc-prim" GHC.Types

pub type 1.tFlag :: 2.tType {
    pub 1.cOff :: 1.tFlag;
    pub 1.cOn :: 1.tFlag
}

pub val 1.vtoggle :: 1.tFlag 2.→ 1.tFlag
 = λ(letter : 1.tFlag).
  let {
      recent : 1.tFlag =
          letter
  } in
      case recent as (cases : 1.tFlag) return (1.tFlag) of {
          1.cOff →
              1.cOn;
          1.cOn →
              1.cOff
      }
