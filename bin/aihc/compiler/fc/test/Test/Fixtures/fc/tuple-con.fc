scope 1 = "" Test
scope 2 = "aihc-prim" GHC.Types

pub type 1.tPair (a : 2.tType) (b : 2.tType) :: 2.tType {
  pub 1.c(,) :: ∀(a : 2.tType) (b : 2.tType). FUN @2.sLiftedRep @2.sLiftedRep a (FUN @2.sLiftedRep @2.sLiftedRep b (tPair a b))
}

pub type 1.tUPair (r1 : 2.tRuntimeRep) (r2 : 2.tRuntimeRep) (a : 2.tTYPE r1) (b : 2.tTYPE r2) :: 2.tTYPE (2.cTupleRep (2.c: 2.tRuntimeRep r1 (2.c: 2.tRuntimeRep r2 (2.c[] 2.tRuntimeRep)))) {
  pub 1.cTuple2# :: ∀(r1 : 2.tRuntimeRep) (r2 : 2.tRuntimeRep) (a : 2.tTYPE r1) (b : 2.tTYPE r2). FUN @r1 @2.tLiftedRep a (b → tUPair a b)
}
