; The entry of a frame, as a continue helper does it. A conversion between a
; pointer and an integer, and a pointer addition of zero, do not change the
; bits. The backend reads the operand where the program reads the result, so
; no conversion makes a move. The or reads the frame directly, and the
; addition computes the stack limit straight into its argument register.
; The stack pointer then is a copy of the frame, and it moves into its
; argument register only at the tail call.
func @enter(%machine: ptr, %hp: ptr, %hp_limit: ptr, %sp: ptr, %sp_limit: ptr, %frame: ptr, %value: ptr) {
entry:
  %stack = ptr.add %frame, 0
  %word = ptr.to_int %frame
  %last = or i64 %word, 4095
  %end = add i64 %last, 1
  %limit = ptr.from_int %end
  %header = load ptr [%frame] align 8
  %code = load code [%header + 24] align 8
  tailcall.indirect %code(%machine, %hp, %hp_limit, %stack, %limit, %frame, null, %value) : (ptr, ptr, ptr, ptr, ptr, ptr, ptr, ptr)
}
