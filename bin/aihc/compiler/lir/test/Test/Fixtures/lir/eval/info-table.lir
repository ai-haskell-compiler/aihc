; expect: 42, 1, 1, 0x10000
; An info table in the layout of the "Info tables" section: five word-sized
; fields, one of them a code field with the fixed entry signature, followed
; by four byte fields.

data @bitmap align 1 = { bytes "\x01\x00" }
data @info align 8 = {
  ptr null,
  ptr @bitmap,
  ptr null,
  code @entry,
  ptr null,
  i8 2,
  i8 0,
  i8 0,
  i8 3
}
data mut @result align 8 = { i64 0 }

func @entry(%args: ptr) {
entry:
  %x = load i64 [%args] align 8
  %y = load i64 [%args + 8] align 8
  %sum = add i64 %x, %y
  store i64 %sum, [@result] align 8
  return
}

func @main() -> (i64, i1, i1, ptr) {
entry:
  %args = stack.alloc 16 align 8
  store i64 40, [%args] align 8
  store i64 2, [%args + 8] align 8
  %enter = load code [@info + 24] align 8
  call.indirect %enter(%args) : (ptr)
  %r = load i64 [@result] align 8
  %identity = load ptr [@info] align 8
  %none = eq ptr %identity, null
  %bitmap = load ptr [@info + 8] align 8
  %first = load i8 [%bitmap] align 1
  %pointer = eq i8 %first, 1
  %next = load ptr [@info + 16] align 8
  %count = load i8 [@info + 40] align 1
  %kind = load i8 [@info + 43] align 1
  %countIsTwo = eq i8 %count, 2
  %kindIsThree = eq i8 %kind, 3
  %entryIsEntry = eq code %enter, @entry
  %both = and i1 %none, %entryIsEntry
  %counts = and i1 %countIsTwo, %kindIsThree
  %all = and i1 %both, %counts
  return %r, %all, %pointer, %bitmap
}
