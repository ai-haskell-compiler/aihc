func @main() -> i64 {
entry:
  jump loop(0)

loop(%index: i64):
  %done = eq i64 %index, 38
  br %done, success, divide

divide:
  %offset = mul i64 %index, 40
  %row = ptr.add @cases, %offset
  %high = load i64 [%row] align 8
  %low = load i64 [%row + 8] align 8
  %divisor = load i64 [%row + 16] align 8
  %expected_q = load i64 [%row + 24] align 8
  %expected_r = load i64 [%row + 32] align 8
  %q, %r = quotrem.wide.u i64 %high, %low, %divisor
  %q_ok = eq i64 %q, %expected_q
  %r_ok = eq i64 %r, %expected_r
  %ok = and i1 %q_ok, %r_ok
  %next = add i64 %index, 1
  br %ok, loop(%next), failure

success:
  return 0

failure:
  return %next
}
