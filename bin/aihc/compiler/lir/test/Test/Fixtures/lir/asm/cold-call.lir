; A heap check with a collection on a cold path. The machine and the context
; arrive in registers that a C call preserves. %x and %k arrive in volatile
; registers. A value that lives across the collection keeps the register of
; the convention when the moves that register spares outweigh a save and a
; restore around the call. The cold block saves the values: in pairs to the
; frame where the backend stores two registers at once, and otherwise in a
; preserved register that nothing holds at the call. On AArch64 %x and %k
; keep their registers and go to the frame as one pair. On AMD64 the
; context fills the preserved registers, so %x and %k also keep their
; registers. The cold block keeps them in the registers of %hp and
; %hp_limit, which are dead at the call.
extern func @collect(ptr, i64) cc c
extern func @next(ptr, ptr, ptr, ptr, ptr, ptr, ptr, ptr)

func @reserve(%machine: ptr, %hp: ptr, %hp_limit: ptr, %sp: ptr, %sp_limit: ptr, %x: ptr, %k: ptr) {
entry:
  %end = ptr.add %hp, 16
  %fits = le.u ptr %end, %hp_limit
  br %fits, reserved(%hp, %hp_limit), collect

cold collect:
  store ptr %hp, [%machine + 24] align 8
  call @collect(%machine, 2)
  %collected = load ptr [%machine + 24] align 8
  %collected_limit = load ptr [%machine + 32] align 8
  jump reserved(%collected, %collected_limit)

reserved(%object: ptr, %limit: ptr):
  %after = ptr.add %object, 16
  store ptr %k, [%object + 8] align 8
  tailcall @next(%machine, %after, %limit, %sp, %sp_limit, %x, %k, %object)
}
