; expect: 1, 3, -64, 3, -16384, 3, -1073741824, -4611686018427387904
; Detect absent rotates and incorrect width or count reduction.
func @main() -> (i1, i8, i8, i16, i16, i32, i32, i64) {
entry:
  %bit = rotl i1 1, 1
  %byte_left = rotl i8 129, 9
  %byte_right = rotr i8 129, 9
  %half_left = rotl i16 32769, 17
  %half_right = rotr i16 32769, 17
  %word_left = rotl i32 2147483649, 33
  %word_right = rotr i32 2147483649, 33
  %wide_right = rotr i64 -9223372036854775807, 65
  return %bit, %byte_left, %byte_right, %half_left, %half_right, %word_left, %word_right, %wide_right
}
