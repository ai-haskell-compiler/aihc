; expect: -3, -1, -64, 1, -2, 255, 1, 4
; Signed division rounds toward zero. Wide multiplication gives both halves.

func @main() -> (i64, i64, i8, i64, i64, i64, i1, i32) {
entry:
  %q = div.s i64 -7, 2
  %r = rem.s i64 -7, 2
  %s = shr.s i8 -128, 1
  %lo, %hi = mul.wide.u i64 -1, -1
  %z = zext i8 -1 to i64
  %sum, %carry = add.carry i64 -1, 1
  %shifted = shl i32 1, 34
  return %q, %r, %s, %lo, %hi, %z, %carry, %shifted
}
