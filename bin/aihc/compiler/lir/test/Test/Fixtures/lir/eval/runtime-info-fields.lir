; expect: 252, 254, 255, 42, 1, 1, 129, 7
; runtime-unit: native/aihc_constants.lir
; Named offsets select unsigned bytes and pointer-sized fields on each target.
; The fifth result also checks the needs_eval byte of @info.

data @bitmap align 1 = { bytes "\x81" }
data @next align 8 = {
  ptr null, ptr null, ptr null, code null, ptr null,
  i8 7, i8 0, i8 0, i8 0, i8 0
}
data @info align 8 = {
  ptr @next, ptr @bitmap, ptr @next, code @entry, ptr @bitmap,
  i8 255, i8 254, i8 253, i8 252, i8 251
}
data @empty align 8 = {
  ptr null, ptr null, ptr null, code null, ptr null,
  i8 0, i8 0, i8 0, i8 0, i8 0
}

func @entry() -> i64 {
entry:
  return 42
}

func @main() -> (i64, i64, i64, i64, i1, i1, i64, i64) {
entry:
  %kind_byte = load i8 [@info + @AIHC_INFO_KIND_OFFSET] align 1
  %kind = zext i8 %kind_byte to i64
  %arity_byte = load i8 [@info + @AIHC_INFO_ARITY_OFFSET] align 1
  %arity = zext i8 %arity_byte to i64
  %count_byte = load i8 [@info + @AIHC_INFO_COUNT_OFFSET] align 1
  %count = zext i8 %count_byte to i64
  %needs_eval_byte = load i8 [@info + @AIHC_INFO_NEEDS_EVAL_OFFSET] align 1
  %needs_eval = zext i8 %needs_eval_byte to i64
  %needs_eval_matches = eq i64 %needs_eval, 251
  %entry = load code [@info + @AIHC_INFO_ENTRY_OFFSET] align 1 word
  %answer = call.indirect %entry() : () -> i64
  %next = load ptr [@info + @AIHC_INFO_NEXT_OFFSET] align 1 word
  %bitmap = load ptr [@info + @AIHC_INFO_BITMAP_OFFSET] align 1 word
  %next_matches = eq ptr %next, @next
  %bitmap_matches = eq ptr %bitmap, @bitmap
  %next_and_bitmap_match = and i1 %next_matches, %bitmap_matches
  %pointers_match = and i1 %next_and_bitmap_match, %needs_eval_matches
  %flag = load i8 [%bitmap] align 1
  %flag_word = zext i8 %flag to i64
  %next_count_byte = load i8 [%next + @AIHC_INFO_COUNT_OFFSET] align 1
  %next_count = zext i8 %next_count_byte to i64

  %zero_kind_byte = load i8 [@empty + @AIHC_INFO_KIND_OFFSET] align 1
  %zero_kind = zext i8 %zero_kind_byte to i64
  %zero_arity_byte = load i8 [@empty + @AIHC_INFO_ARITY_OFFSET] align 1
  %zero_arity = zext i8 %zero_arity_byte to i64
  %zero_count_byte = load i8 [@empty + @AIHC_INFO_COUNT_OFFSET] align 1
  %zero_count = zext i8 %zero_count_byte to i64
  %zero_needs_eval_byte = load i8 [@empty + @AIHC_INFO_NEEDS_EVAL_OFFSET] align 1
  %zero_needs_eval = zext i8 %zero_needs_eval_byte to i64
  %zero_kind_arity = or i64 %zero_kind, %zero_arity
  %zero_kind_arity_count = or i64 %zero_kind_arity, %zero_count
  %zero_bytes = or i64 %zero_kind_arity_count, %zero_needs_eval
  %bytes_clear = eq i64 %zero_bytes, 0
  %null_entry = load code [@empty + @AIHC_INFO_ENTRY_OFFSET] align 1 word
  %null_next = load ptr [@empty + @AIHC_INFO_NEXT_OFFSET] align 1 word
  %null_bitmap = load ptr [@empty + @AIHC_INFO_BITMAP_OFFSET] align 1 word
  %entry_clear = eq code %null_entry, null
  %next_clear = eq ptr %null_next, null
  %bitmap_clear = eq ptr %null_bitmap, null
  %code_and_bytes_clear = and i1 %bytes_clear, %entry_clear
  %pointers_clear = and i1 %next_clear, %bitmap_clear
  %all_clear = and i1 %code_and_bytes_clear, %pointers_clear
  return %kind, %arity, %count, %answer, %pointers_match, %all_clear, %flag_word, %next_count
}
