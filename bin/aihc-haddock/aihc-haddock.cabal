cabal-version: 3.8
name: aihc-haddock
version: 0.1.0.0
build-type: Simple
license: Unlicense
license-file: LICENSE
author: David Himmelstrup
maintainer: lemmih@gmail.com
category: Development
synopsis: Documentation tool for aihc packages with a Haddock comparison harness

flag hackage
  description:
    Read the Hackage index and download the Hackage releases that a plan
    needs. Without this flag, aihc-haddock does not depend on
    aihc-hackage-fetch and its network, tar, and zlib packages, and a plan
    uses only local packages and the core libraries.

  default: True
  manual: True

library
  exposed-modules:
    Aihc.Haddock.Build
    Aihc.Haddock.Cli
    Aihc.Haddock.Comment
    Aihc.Haddock.Compare
    Aihc.Haddock.Hoogle
    Aihc.Haddock.Markup
    Aihc.Haddock.Model
    Aihc.Haddock.Package
    Aihc.Haddock.Reference.Hoogle
    Aihc.Haddock.Reference.Json
    Aihc.Haddock.Render
    Aihc.Haddock.Store

  other-modules:
    Aihc.Haddock.Hackage

  hs-source-dirs: src
  build-depends:
    aeson >=2.0 && <2.3,
    aeson-pretty,
    aihc-cabal-syntax >=2.0 && <2.1,
    aihc-hackage,
    aihc-package-plan,
    aihc-parser,
    base >=4.16 && <5,
    bytestring >=0.10.8 && <0.13,
    containers >=0.5 && <0.9,
    directory >=1.2.3 && <1.5,
    filepath >=1.3.0.1 && <1.6,
    optparse-applicative >=0.16 && <0.19,
    prettyprinter,
    text >=2.1.4 && <2.2,
    transformers,

  if flag(hackage)
    hs-source-dirs: hackage/enabled
    build-depends: aihc-hackage-fetch
  else
    hs-source-dirs: hackage/disabled

  ghc-options: -Wall
  default-language: GHC2021

executable aihc-haddock
  main-is: Main.hs
  hs-source-dirs: app
  build-depends:
    aihc-haddock,
    base >=4.16 && <5,

  ghc-options: -Wall
  default-language: GHC2021

test-suite spec
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Spec.hs
  other-modules:
    Test.Haddock.Fixtures
    Test.Haddock.Units

  build-depends:
    aihc-hackage,
    aihc-haddock,
    base >=4.16 && <5,
    bytestring,
    directory,
    filepath,
    tasty,
    tasty-hedgehog,
    tasty-hunit,
    text,

  ghc-options:
    -Wall
    -threaded
    -rtsopts
    "-with-rtsopts=-N -M10G"

  default-language: GHC2021
