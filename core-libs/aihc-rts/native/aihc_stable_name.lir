; A stable name has four slots on every target: header, referent, hash, and link.
; The caller reserves four slots. This operation must not collect.
; The collector treats the referent and lookup link as weak pointers.
; A live name preserves its hash after its referent dies.

include "aihc_constants.lir"

extern func @aihc_gc_allocate(ptr, i64) -> ptr cc c

data @aihc_stable_name_info align 8 = {
  ptr null,
  ptr null,
  ptr null,
  code null,
  ptr null,
  i8 0,
  i8 0,
  i8 @AIHC_FRAME_NONE,
  i8 @AIHC_OBJECT_STABLE_NAME
}

extern func @aihc_fail(ptr) cc c
; The address of the machine's stable-name list head.
extern func @aihc_stable_names(ptr) -> ptr cc c
; The next hash, after which the machine's counter advances.
extern func @aihc_stable_name_take_hash(ptr) -> i64 cc c

data @aihc_stable_name_null_message align 1 = {
  bytes "stable-name primitive received null", zero 1
}

; Reuse a live name while its referent remains live.
; Compiled code compares names as pointers and reads the stored hash.
export func @aihc_stable_name_make(%machine: ptr, %value: ptr) -> ptr cc c {
entry:
  %missing = eq ptr %value, null
  br %missing, invalid, search

invalid:
  call @aihc_fail(@aihc_stable_name_null_message)
  trap "stable-name primitive received null"

search:
  %head = call @aihc_stable_names(%machine)
  %first = load ptr [%head] align 8
  jump visit(%first)

visit(%name: ptr):
  %exhausted = eq ptr %name, null
  br %exhausted, allocate, compare

compare:
  %referent = load ptr [%name + 8] align 8
  %found = eq ptr %referent, %value
  br %found, known, advance

advance:
  %next = load ptr [%name + 24] align 8
  jump visit(%next)

known:
  return %name

allocate:
  %fresh = call @aihc_gc_allocate(%machine, 4)
  %hash = call @aihc_stable_name_take_hash(%machine)
  %info = ptr.to_int @aihc_stable_name_info
  store i64 %info, [%fresh] align 8
  store ptr %value, [%fresh + 8] align 8
  store i64 %hash, [%fresh + 16] align 8
  store ptr %first, [%fresh + 24] align 8
  store ptr %fresh, [%head] align 8
  return %fresh
}
