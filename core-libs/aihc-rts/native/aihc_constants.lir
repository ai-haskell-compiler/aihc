; The constants the runtime units share. See the "Constants" section of
; docs/lir.md. A unit takes them with
;
;   include "aihc_constants.lir"
;
; This file holds nothing but constants, so every unit can include it.

; Info-table offsets use target words for pointer fields.
; Byte fields follow the five pointer fields.
const @AIHC_INFO_BITMAP_OFFSET = 1 word
const @AIHC_INFO_NEXT_OFFSET = 2 words
const @AIHC_INFO_ENTRY_OFFSET = 3 words
const @AIHC_INFO_COUNT_OFFSET = 5 words
const @AIHC_INFO_ARITY_OFFSET = 5 words + 1
const @AIHC_INFO_KIND_OFFSET = 5 words + 3
const @AIHC_INFO_FRAME_OFFSET = 5 words + 2

; Object kinds occupy the object_kind field of an info table.
; AIHC_OBJECT_RUNTIME is a reserved legacy kind.
const @AIHC_OBJECT_NODE = 0
const @AIHC_OBJECT_CLOSURE = 1
const @AIHC_OBJECT_THUNK = 2
const @AIHC_OBJECT_PARTIAL_CONSTRUCTOR = 3
const @AIHC_OBJECT_INDIRECTION = 4
const @AIHC_OBJECT_BLACKHOLE = 5
const @AIHC_OBJECT_ARRAY = 6
const @AIHC_OBJECT_THREAD = 7
const @AIHC_OBJECT_RUNTIME = 8
const @AIHC_OBJECT_TRANSACTION = 9
const @AIHC_OBJECT_TRANSACTION_WRITE = 10
const @AIHC_OBJECT_TRANSACTION_TIMER = 11
const @AIHC_OBJECT_MVAR = 12
const @AIHC_OBJECT_MVAR_WAITER = 13
const @AIHC_OBJECT_BLACKHOLE_WAITER = 14
const @AIHC_OBJECT_BLACKHOLE_RECORD = 15
const @AIHC_OBJECT_STABLE_NAME = 16
const @AIHC_OBJECT_BYTE_ARRAY = 17

; Frame kinds, the frame_kind field of an info table.
const @AIHC_FRAME_NONE = 0
const @AIHC_FRAME_NORMAL = 1
const @AIHC_FRAME_CATCH = 2
const @AIHC_FRAME_UPDATE = 3
const @AIHC_FRAME_RESTORE_MASK = 4
const @AIHC_FRAME_STOP = 5
const @AIHC_FRAME_PROMPT = 6
const @AIHC_FRAME_FORWARD = 7

; Scheduler resumption kinds, the kind field of AihcResume.
const @AIHC_RESUME_NONE = 0
const @AIHC_RESUME_APPLY = 1
const @AIHC_RESUME_CONTINUE = 2
const @AIHC_RESUME_RAISE = 3

; Heap slots have eight bytes on every target.
; Fourteen slots cover a blackhole record or waiter on every target.
const @AIHC_EVAL_RECORD_WORDS = 14
const @AIHC_UPDATE_FRAME_WORDS = 3
const @AIHC_UPDATE_FRAME_BYTES = @AIHC_UPDATE_FRAME_WORDS * 8
const @AIHC_EVAL_THUNK_WORDS = @AIHC_EVAL_RECORD_WORDS + @AIHC_UPDATE_FRAME_WORDS
