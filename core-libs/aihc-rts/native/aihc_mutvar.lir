; The mutable-reference runtime, written in Lir. See docs/lir.md.
;
; A MutVar# is a boxed array of one element, so it inherits the info table
; of the array unit in aihc_array.lir, and compiled code reads and writes
; its one element as it does an array element. Only the allocation is a
; runtime call.

extern func @aihc_array_new(ptr, i64, i64) -> ptr cc c

export func @aihc_mutvar_new(%machine: ptr, %initial: i64) -> ptr cc c {
entry:
  %mutvar = call @aihc_array_new(%machine, 1, %initial)
  return %mutvar
}
