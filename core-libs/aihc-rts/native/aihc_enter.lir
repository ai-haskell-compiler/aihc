export func @aihc_lir_enter_1_0(%machine: ptr, %object: ptr, %continuation: ptr) {
entry:
  %header = call @aihc_info_table(%object)
  %code = call @aihc_info_identity(%header)
  %stored0_word = load i64 [%object + 8] align 8
  %stored0 = ptr.from_int %stored0_word
  tailcall.indirect %code(%machine, %stored0) : (ptr, ptr)
}

