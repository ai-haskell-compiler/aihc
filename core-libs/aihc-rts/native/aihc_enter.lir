include "aihc_object.lir"

; The shared enter functions. An info table names one of these in its
; backend_entry field when every stored field and every supplied value of
; the object is a pointer: the lowering then emits no stub of its own for
; the object. See "Info tables" in docs/lir.md and sharedEnterSymbol in
; Aihc.Lir.Lower.
;
; aihc_lir_enter_S_V takes the machine, the object, the continuation, and V
; supplied values. It loads the S stored fields of the object and
; tail-calls the code in the identity field of the info table with the
; machine, the stored fields, and the supplied values. aihc_lir_enter_S_V_k
; passes the continuation after them. A continuation object ignores the
; continuation parameter, so it uses the form without the suffix.
;
; The header and the identity field are read through the inline functions of
; aihc_object.lir. A stored field is one eight-byte slot on every target,
; which is why it is loaded as i64 and converted.
;
; V goes up to four because an application supplies at most four argument
; groups (grinApplyGroupLimit), and each closure stage whose remaining
; arity is at most four has an entry that takes all its remaining values.

export func @aihc_lir_enter_0_0(%machine: ptr, %object: ptr, %continuation: ptr) {
entry:
  %header = call @aihc_info_table(%object)
  %code = call @aihc_info_identity(%header)
  tailcall.indirect %code(%machine) : (ptr)
}

export func @aihc_lir_enter_0_0_k(%machine: ptr, %object: ptr, %continuation: ptr) {
entry:
  %header = call @aihc_info_table(%object)
  %code = call @aihc_info_identity(%header)
  tailcall.indirect %code(%machine, %continuation) : (ptr, ptr)
}

