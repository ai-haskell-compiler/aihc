; Byte arrays have six descriptor slots followed by an inline payload.
; Ordinary arrays move. Pinned arrays use separate GC-owned blocks.
; The caller reserves the complete charge before these functions run.
include "aihc_constants.lir"

extern func @aihc_byte_array_words(i64, i64, i64) -> i64 cc c
extern func @aihc_gc_allocate(ptr, i64) -> ptr cc c
extern func @aihc_gc_allocate_pinned(ptr, i64) -> ptr cc c

data @aihc_byte_array_info align 8 = {
  ptr null, ptr null, ptr null, code null, ptr null,
  i8 0, i8 0, i8 @AIHC_FRAME_NONE, i8 @AIHC_OBJECT_BYTE_ARRAY
}

extern func @aihc_fail(ptr) cc c
extern func @aihc_memory_copy(ptr, ptr, i64) cc c
extern func @aihc_memory_move(ptr, ptr, i64) cc c
extern func @aihc_memory_set(ptr, i64, i64) cc c

data @aihc_byte_array_size_message align 1 = {
  bytes "invalid byte array size", zero 1
}



data @aihc_byte_array_null_message align 1 = {
  bytes "attempted to inspect a null byte array", zero 1
}

data @aihc_byte_array_resize_message align 1 = {
  bytes "attempted to resize a null byte array", zero 1
}

data @aihc_byte_array_shrink_message align 1 = {
  bytes "invalid byte array shrink", zero 1
}

data @aihc_byte_array_copy_message align 1 = {
  bytes "invalid byte array copy", zero 1
}

data @aihc_byte_array_compare_message align 1 = {
  bytes "invalid byte array comparison", zero 1
}

data @aihc_byte_array_word_index_message align 1 = {
  bytes "invalid byte array word index", zero 1
}

data @aihc_byte_array_bounds_message align 1 = {
  bytes "byte array access is out of bounds", zero 1
}

data @aihc_byte_array_set_message align 1 = {
  bytes "invalid byte array set", zero 1
}

; A count the caller gave: a size, an offset, or a length. Every one of them
; is non-negative, so this rejects the rest before any arithmetic on it.
func @aihc_byte_array_count(%value: i64) -> i64 {
entry:
  %negative = lt.s i64 %value, 0
  br %negative, invalid, valid

invalid:
  call @aihc_fail(@aihc_byte_array_size_message)
  trap "invalid byte array size"

valid:
  return %value
}

; The size of %array, or a failure with %message when %array is null.
func @aihc_byte_array_size_or_fail(%array: ptr, %message: ptr) -> i64 {
entry:
  %missing = eq ptr %array, null
  br %missing, invalid, size

invalid:
  call @aihc_fail(%message)
  trap "byte array primitive received null"

size:
  %value = load i64 [%array + 8] align 8
  return %value
}

; Fail with %message unless the %length bytes at %offset lie inside an array
; of %size bytes. Both counts have passed @aihc_byte_array_count, so the
; comparisons are unsigned and no sum overflows.
func @aihc_byte_array_range(%size: i64, %offset: i64, %length: i64, %message: ptr) {
entry:
  %past_end = gt.u i64 %offset, %size
  %remaining = sub i64 %size, %offset
  %too_long = gt.u i64 %length, %remaining
  %invalid = or i1 %past_end, %too_long
  br %invalid, fail, inside

fail:
  call @aihc_fail(%message)
  trap "byte array access is out of bounds"

inside:
  return
}

; The address of byte %offset of %array.
func @aihc_byte_array_address(%array: ptr, %offset: i64) -> ptr {
entry:
  %contents = load ptr [%array + 16] align 8
  %address = ptr.add %contents, %offset
  return %address
}

func @aihc_byte_array_allocate(%machine: ptr, %size: i64, %pinned: i64, %alignment: i64) -> ptr {
entry:
  %charged = call @aihc_byte_array_words(%size, %pinned, %alignment)
  %is_pinned = ne i64 %pinned, 0
  br %is_pinned, pinned, movable

pinned:
  %pinned_words = sub i64 %charged, 2
  %fixed = call @aihc_gc_allocate_pinned(%machine, %pinned_words)
  jump initialize(%fixed, %pinned_words)

movable:
  %moving = call @aihc_gc_allocate(%machine, %charged)
  jump initialize(%moving, %charged)

initialize(%array: ptr, %words: i64):
  %raw = ptr.add %array, 48
  %raw_address = ptr.to_int %raw
  %slack = sub i64 %alignment, 1
  %biased = add i64 %raw_address, %slack
  %mask = xor i64 %slack, -1
  %aligned_address = and i64 %biased, %mask
  %aligned = ptr.from_int %aligned_address
  %info = ptr.to_int @aihc_byte_array_info
  store i64 %info, [%array] align 8
  store i64 %size, [%array + 8] align 8
  store ptr %aligned, [%array + 16] align 8
  store i64 %pinned, [%array + 24] align 8
  store i64 %alignment, [%array + 32] align 8
  store i64 %words, [%array + 40] align 8
  return %array
}

export func @aihc_byte_array_new(%machine: ptr, %size: i64) -> ptr cc c {
entry:
  %array = call @aihc_byte_array_allocate(%machine, %size, 0, 8)
  return %array
}

export func @aihc_byte_array_new_pinned(%machine: ptr, %size: i64) -> ptr cc c {
entry:
  %array = call @aihc_byte_array_allocate(%machine, %size, 1, 8)
  return %array
}

export func @aihc_byte_array_new_aligned_pinned(%machine: ptr, %size: i64, %alignment: i64) -> ptr cc c {
entry:
  %array = call @aihc_byte_array_allocate(%machine, %size, 1, %alignment)
  return %array
}

export func @aihc_byte_array_is_pinned(%array: ptr) -> i64 cc c {
entry:
  %ignored = call @aihc_byte_array_size_or_fail(%array, @aihc_byte_array_null_message)
  %pinned = load i64 [%array + 24] align 8
  return %pinned
}

export func @aihc_byte_array_contents(%array: ptr) -> ptr cc c {
entry:
  %ignored = call @aihc_byte_array_size_or_fail(%array, @aihc_byte_array_null_message)
  %contents = load ptr [%array + 16] align 8
  return %contents
}

export func @aihc_byte_array_get_size(%array: ptr) -> i64 cc c {
entry:
  %size = call @aihc_byte_array_size_or_fail(%array, @aihc_byte_array_null_message)
  return %size
}

; Shrink an array in place. Only the recorded size changes; the contents keep
; their allocation, so the bytes beyond the new size are simply unreachable.
export func @aihc_byte_array_shrink(%array: ptr, %size: i64) -> i64 cc c {
entry:
  %checked = call @aihc_byte_array_count(%size)
  %current = call @aihc_byte_array_size_or_fail(%array, @aihc_byte_array_shrink_message)
  %grows = gt.u i64 %checked, %current
  br %grows, invalid, shrink

invalid:
  call @aihc_fail(@aihc_byte_array_shrink_message)
  trap "invalid byte array shrink"

shrink:
  store i64 %checked, [%array + 8] align 8
  return 0
}

; Resize an array by copying it. The result keeps the pinning and the
; alignment of the original, and the shorter of the two sizes is copied over.
export func @aihc_byte_array_resize(%machine: ptr, %array: ptr, %size: i64) -> ptr cc c {
entry:
  %current = call @aihc_byte_array_size_or_fail(%array, @aihc_byte_array_resize_message)
  %pinned = load i64 [%array + 24] align 8
  %alignment = load i64 [%array + 32] align 8
  %resized = call @aihc_byte_array_allocate(%machine, %size, %pinned, %alignment)
  %new_size = load i64 [%resized + 8] align 8
  %shrinks = lt.u i64 %current, %new_size
  %copied = select i64 %shrinks, %current, %new_size
  %source = call @aihc_byte_array_address(%array, 0)
  %destination = call @aihc_byte_array_address(%resized, 0)
  call @aihc_memory_copy(%destination, %source, %copied)
  return %resized
}

export func @aihc_byte_array_copy_from_addr(%source: ptr, %array: ptr, %offset: i64, %length: i64) -> i64 cc c {
entry:
  %checked_offset = call @aihc_byte_array_count(%offset)
  %checked_length = call @aihc_byte_array_count(%length)
  %size = call @aihc_byte_array_size_or_fail(%array, @aihc_byte_array_copy_message)
  call @aihc_byte_array_range(%size, %checked_offset, %checked_length, @aihc_byte_array_copy_message)
  %missing = eq ptr %source, null
  %nonempty = ne i64 %checked_length, 0
  %invalid = and i1 %missing, %nonempty
  br %invalid, fail, copy

fail:
  call @aihc_fail(@aihc_byte_array_copy_message)
  trap "invalid byte array copy"

copy:
  %destination = call @aihc_byte_array_address(%array, %checked_offset)
  call @aihc_memory_copy(%destination, %source, %checked_length)
  return 0
}

export func @aihc_byte_array_copy_to_addr(%array: ptr, %offset: i64, %destination: ptr, %length: i64) -> i64 cc c {
entry:
  %checked_offset = call @aihc_byte_array_count(%offset)
  %checked_length = call @aihc_byte_array_count(%length)
  %size = call @aihc_byte_array_size_or_fail(%array, @aihc_byte_array_copy_message)
  call @aihc_byte_array_range(%size, %checked_offset, %checked_length, @aihc_byte_array_copy_message)
  %missing = eq ptr %destination, null
  %nonempty = ne i64 %checked_length, 0
  %invalid = and i1 %missing, %nonempty
  br %invalid, fail, copy

fail:
  call @aihc_fail(@aihc_byte_array_copy_message)
  trap "invalid byte array copy"

copy:
  %source = call @aihc_byte_array_address(%array, %checked_offset)
  call @aihc_memory_copy(%destination, %source, %checked_length)
  return 0
}

; Copy between two byte arrays. The ranges may overlap, so this moves rather
; than copies.
export func @aihc_byte_array_copy(%source: ptr, %source_offset: i64, %destination: ptr, %destination_offset: i64, %length: i64) -> i64 cc c {
entry:
  %checked_source_offset = call @aihc_byte_array_count(%source_offset)
  %checked_destination_offset = call @aihc_byte_array_count(%destination_offset)
  %checked_length = call @aihc_byte_array_count(%length)
  %source_size = call @aihc_byte_array_size_or_fail(%source, @aihc_byte_array_copy_message)
  %destination_size = call @aihc_byte_array_size_or_fail(%destination, @aihc_byte_array_copy_message)
  call @aihc_byte_array_range(%source_size, %checked_source_offset, %checked_length, @aihc_byte_array_copy_message)
  call @aihc_byte_array_range(%destination_size, %checked_destination_offset, %checked_length, @aihc_byte_array_copy_message)
  %from = call @aihc_byte_array_address(%source, %checked_source_offset)
  %to = call @aihc_byte_array_address(%destination, %checked_destination_offset)
  call @aihc_memory_move(%to, %from, %checked_length)
  return 0
}

; Fill a range with one byte. The byte is the low eight bits of %value, as in
; setByteArray#, and the bulk store goes through the memory helper of the C
; runtime rather than a loop here.
export func @aihc_byte_array_set(%array: ptr, %offset: i64, %length: i64, %value: i64) -> i64 cc c {
entry:
  %checked_offset = call @aihc_byte_array_count(%offset)
  %checked_length = call @aihc_byte_array_count(%length)
  %size = call @aihc_byte_array_size_or_fail(%array, @aihc_byte_array_set_message)
  call @aihc_byte_array_range(%size, %checked_offset, %checked_length, @aihc_byte_array_set_message)
  %destination = call @aihc_byte_array_address(%array, %checked_offset)
  %byte = and i64 %value, 255
  call @aihc_memory_set(%destination, %byte, %checked_length)
  return 0
}

; Compare two ranges byte by byte. The result is minus one, zero, or one, in
; the order of the first byte that differs.
export func @aihc_byte_array_compare(%left: ptr, %left_offset: i64, %right: ptr, %right_offset: i64, %length: i64) -> i64 cc c {
entry:
  %checked_left_offset = call @aihc_byte_array_count(%left_offset)
  %checked_right_offset = call @aihc_byte_array_count(%right_offset)
  %checked_length = call @aihc_byte_array_count(%length)
  %left_size = call @aihc_byte_array_size_or_fail(%left, @aihc_byte_array_compare_message)
  %right_size = call @aihc_byte_array_size_or_fail(%right, @aihc_byte_array_compare_message)
  call @aihc_byte_array_range(%left_size, %checked_left_offset, %checked_length, @aihc_byte_array_compare_message)
  call @aihc_byte_array_range(%right_size, %checked_right_offset, %checked_length, @aihc_byte_array_compare_message)
  %left_bytes = call @aihc_byte_array_address(%left, %checked_left_offset)
  %right_bytes = call @aihc_byte_array_address(%right, %checked_right_offset)
  jump step(0)

step(%index: i64):
  %done = ge.u i64 %index, %checked_length
  br %done, equal, examine

examine:
  %left_byte_address = ptr.add %left_bytes, %index
  %right_byte_address = ptr.add %right_bytes, %index
  %left_byte = load i8 [%left_byte_address] align 1
  %right_byte = load i8 [%right_byte_address] align 1
  %same = eq i8 %left_byte, %right_byte
  br %same, advance, differs

advance:
  %next = add i64 %index, 1
  jump step(%next)

differs:
  %below = lt.u i8 %left_byte, %right_byte
  %result = select i64 %below, -1, 1
  return %result

equal:
  return 0
}

; The failure of an element access that compiled code checks itself: under
; --check-prim-bounds the Lir lowering emits the bounds check of the index,
; read, and write primitives, and calls this when it fails.
export func @aihc_byte_array_bounds_fail() cc c {
entry:
  call @aihc_fail(@aihc_byte_array_bounds_message)
  trap "byte array access is out of bounds"
}

; The byte offset of word %index, after the bounds check.
func @aihc_byte_array_word_address(%array: ptr, %index: i64) -> ptr {
entry:
  %negative = lt.s i64 %index, 0
  %huge = gt.u i64 %index, 2305843009213693951
  %invalid = or i1 %negative, %huge
  br %invalid, bad_index, bounds

bad_index:
  call @aihc_fail(@aihc_byte_array_word_index_message)
  trap "invalid byte array word index"

bounds:
  %missing = eq ptr %array, null
  br %missing, bad_index, offset

offset:
  %byte_offset = mul i64 %index, 8
  %size = load i64 [%array + 8] align 8
  call @aihc_byte_array_range(%size, %byte_offset, 8, @aihc_byte_array_bounds_message)
  %address = call @aihc_byte_array_address(%array, %byte_offset)
  return %address
}

; The word at %index, and its replacement, for the atomic operations below.
func @aihc_byte_array_read_word(%array: ptr, %index: i64) -> i64 {
entry:
  %address = call @aihc_byte_array_word_address(%array, %index)
  %value = load i64 [%address] align 1
  return %value
}

func @aihc_byte_array_write_word(%array: ptr, %index: i64, %value: i64) {
entry:
  %address = call @aihc_byte_array_word_address(%array, %index)
  store i64 %value, [%address] align 1
  return
}

; The read-modify-write operations of the atomic Int# array primitives. The
; runtime runs one Haskell thread, thus each is a plain read, combine and
; write, and each returns the value the element held before the write.
export func @aihc_byte_array_fetch_add_word(%array: ptr, %index: i64, %value: i64) -> i64 cc c {
entry:
  %old = call @aihc_byte_array_read_word(%array, %index)
  %new = add i64 %old, %value
  call @aihc_byte_array_write_word(%array, %index, %new)
  return %old
}

export func @aihc_byte_array_fetch_sub_word(%array: ptr, %index: i64, %value: i64) -> i64 cc c {
entry:
  %old = call @aihc_byte_array_read_word(%array, %index)
  %new = sub i64 %old, %value
  call @aihc_byte_array_write_word(%array, %index, %new)
  return %old
}

export func @aihc_byte_array_fetch_and_word(%array: ptr, %index: i64, %value: i64) -> i64 cc c {
entry:
  %old = call @aihc_byte_array_read_word(%array, %index)
  %new = and i64 %old, %value
  call @aihc_byte_array_write_word(%array, %index, %new)
  return %old
}

export func @aihc_byte_array_fetch_nand_word(%array: ptr, %index: i64, %value: i64) -> i64 cc c {
entry:
  %old = call @aihc_byte_array_read_word(%array, %index)
  %combined = and i64 %old, %value
  %new = xor i64 %combined, -1
  call @aihc_byte_array_write_word(%array, %index, %new)
  return %old
}

export func @aihc_byte_array_fetch_or_word(%array: ptr, %index: i64, %value: i64) -> i64 cc c {
entry:
  %old = call @aihc_byte_array_read_word(%array, %index)
  %new = or i64 %old, %value
  call @aihc_byte_array_write_word(%array, %index, %new)
  return %old
}

export func @aihc_byte_array_fetch_xor_word(%array: ptr, %index: i64, %value: i64) -> i64 cc c {
entry:
  %old = call @aihc_byte_array_read_word(%array, %index)
  %new = xor i64 %old, %value
  call @aihc_byte_array_write_word(%array, %index, %new)
  return %old
}

; The compare and swap of casIntArray#. The result is the value the element
; held, which tells the caller whether the swap happened.
export func @aihc_byte_array_compare_and_swap_word(%array: ptr, %index: i64, %expected: i64, %replacement: i64) -> i64 cc c {
entry:
  %old = call @aihc_byte_array_read_word(%array, %index)
  %matches = eq i64 %old, %expected
  br %matches, swap, unchanged

swap:
  call @aihc_byte_array_write_word(%array, %index, %replacement)
  return %old

unchanged:
  return %old
}
