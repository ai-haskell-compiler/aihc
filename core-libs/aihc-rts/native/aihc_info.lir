; Info tables contain five pointer-sized fields and four unsigned bytes.
; Word offsets preserve the C layout on 32-bit and 64-bit targets.
; These accessors use the Lir calling convention.

include "aihc_constants.lir"

export func @aihc_lir_info_kind(%info: ptr) -> i64 {
entry:
  %byte = load i8 [%info + @AIHC_INFO_KIND_OFFSET] align 1
  %kind = zext i8 %byte to i64
  return %kind
}

export func @aihc_lir_info_arity(%info: ptr) -> i64 {
entry:
  %byte = load i8 [%info + @AIHC_INFO_ARITY_OFFSET] align 1
  %arity = zext i8 %byte to i64
  return %arity
}

export func @aihc_lir_info_count(%info: ptr) -> i64 {
entry:
  %byte = load i8 [%info + @AIHC_INFO_COUNT_OFFSET] align 1
  %count = zext i8 %byte to i64
  return %count
}

export func @aihc_lir_info_entry(%info: ptr) -> code {
entry:
  %entry = load code [%info + @AIHC_INFO_ENTRY_OFFSET] align 1 word
  return %entry
}

export func @aihc_lir_info_next(%info: ptr) -> ptr {
entry:
  %next = load ptr [%info + @AIHC_INFO_NEXT_OFFSET] align 1 word
  return %next
}

export func @aihc_lir_info_bitmap(%info: ptr) -> ptr {
entry:
  %bitmap = load ptr [%info + @AIHC_INFO_BITMAP_OFFSET] align 1 word
  return %bitmap
}
