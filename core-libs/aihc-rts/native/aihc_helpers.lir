; Shared evaluation, application, continuation, and scalar helpers.
; Common argument shapes are [], [ptr], and [i64].
; The compiler emits other shapes in the module that needs them.
; Heap slots have eight bytes on every target.
; The reads of a header and of an info table go through the inline
; functions of aihc_object.lir, which cost what they would written out.
; C code transfers scheduler records.
;
; A helper that runs Haskell code takes the context of the thread: the heap
; pointer %hp, the stack pointer %sp, and the capability %base. It gives the
; context to each function it transfers control to. The heap limit and the
; stack limit are fields of the capability, and a check loads them. The
; capability holds a copy of the heap pointer and the stack pointer only
; while a C call can read them. See "Lowering from GC-GRIN" in docs/lir.md.

include "aihc_object.lir"

const @WORD_BITS = 64
const @WORD_HIGH_BIT = 63

extern func @aihc_lir_take_resume(ptr, ptr, ptr) cc c

extern func @aihc_apply_slow(ptr, ptr, i64, i64, ptr, ptr) -> ptr cc c

extern func @aihc_block_on_blackhole(ptr, ptr, ptr) -> ptr cc c

extern func @aihc_no_match() cc c

extern func @aihc_raise(ptr, ptr, ptr) -> ptr cc c

extern func @aihc_stack_grow(ptr, ptr, i64, ptr) -> ptr cc c

; The end of the stack chunk that holds an address. A chunk has
; AIHC_STACK_CHUNK_BYTES bytes and the same alignment.
inline func @aihc_stack_chunk_end(%address: ptr) -> ptr {
entry:
  %word = ptr.to_int %address
  %last = or i64 %word, @AIHC_STACK_CHUNK_LAST
  %end = add i64 %last, 1
  %limit = ptr.from_int %end
  return %limit
}

; The heap limit and the stack limit of the capability.
inline func @aihc_heap_limit(%base: ptr) -> ptr {
entry:
  %limit = load ptr [%base + @AIHC_CAPABILITY_HEAP_LIMIT_OFFSET] align 1 word
  return %limit
}

inline func @aihc_stack_limit(%base: ptr) -> ptr {
entry:
  %limit = load ptr [%base + @AIHC_CAPABILITY_STACK_LIMIT_OFFSET] align 1 word
  return %limit
}

; A blackhole requires a heap reservation. A thunk pushes its update frame
; on the stack of the thread. The push fits in the current chunk when the
; new stack pointer is not above the stack limit. Otherwise the runtime
; continues the stack in the next chunk and charges that chunk to the
; nursery. When the charge uses the nursery, the evaluation collects and
; starts again, because each minor collection scans the young chunks. A
; chain of thunks that only evaluate other thunks thus pushes about one
; nursery of stack between two collections.
;
; The entry is a safepoint: it collects when the heap pointer is above the
; heap limit. A frame push can put the limit there when it charges a new
; stack chunk to the nursery. Compiled code pushes the frame of an
; evaluation with no reservation of its own, so this check is the one that
; collects after that charge. The value and the continuation are then the
; only roots, because the continuation frame holds every other live value.
export func @aihc_lir_eval(%hp: ptr, %sp: ptr, %base: ptr, %value: ptr, %continuation: ptr) {
entry:
  %roots = stack.alloc 16 align 8
  %hp_limit = call @aihc_heap_limit(%base)
  %entry_fits = le.u ptr %hp, %hp_limit
  br %entry_fits, loop(%value), entry_collect

cold entry_collect:
  store ptr %hp, [%base + @AIHC_CAPABILITY_HEAP_NEXT_OFFSET] align 1 word
  store ptr %sp, [%base + @AIHC_CAPABILITY_STACK_NEXT_OFFSET] align 1 word
  %entry_value_word = ptr.to_int %value
  store i64 %entry_value_word, [%roots] align 8
  %entry_continuation_word = ptr.to_int %continuation
  store i64 %entry_continuation_word, [%roots + 8] align 8
  ; The value and continuation carry the required static reference tables.
  call @aihc_heap_collect(%base, 0, 2, %roots, null)
  %moved_entry_value_word = load i64 [%roots] align 8
  %moved_entry_value = ptr.from_int %moved_entry_value_word
  %moved_entry_continuation_word = load i64 [%roots + 8] align 8
  %moved_entry_continuation = ptr.from_int %moved_entry_continuation_word
  %entry_hp = load ptr [%base + @AIHC_CAPABILITY_HEAP_NEXT_OFFSET] align 1 word
  tailcall @aihc_lir_eval(%entry_hp, %sp, %base, %moved_entry_value, %moved_entry_continuation)

loop(%current: ptr):
  %header_word = call @aihc_object_header_word_dependent(%current)
  %evaluating = call @aihc_header_is_evaluating(%header_word)
  br %evaluating, claimed, inspect

; Bit zero marks a claimed or an evaluated thunk. Both bits mark a claim
; between its two stores, which lasts two stores of another thread, so the
; header is read again. Field zero names the owner, a thread record or a
; blackhole queue, or it is the value. No Haskell value has the kind of a
; thread record or a queue.
claimed:
  %tag = and i64 %header_word, @AIHC_HEADER_TAG_MASK
  %claiming = eq i64 %tag, @AIHC_HEADER_TAG_MASK
  br %claiming, loop(%current), owned

owned:
  %word = call @aihc_thunk_field_zero(%current)
  %word_header_word = call @aihc_object_header_word_dependent(%word)
  %word_header = call @aihc_info_table_of_header(%word_header_word)
  %word_kind = call @aihc_info_kind(%word_header)
  %is_thread = eq i64 %word_kind, @AIHC_OBJECT_THREAD
  %is_queue = eq i64 %word_kind, @AIHC_OBJECT_BLACKHOLE_QUEUE
  %has_owner = or i1 %is_thread, %is_queue
  br %has_owner, blackhole, loop(%word)

inspect:
  %header = call @aihc_info_table_of_header(%header_word)
  %kind = call @aihc_info_kind(%header)
  switch i64 %kind {
    @AIHC_OBJECT_THUNK -> thunk
    @AIHC_OBJECT_INDIRECTION -> indirection
    @AIHC_OBJECT_BLACKHOLE -> blackhole
    default -> ready
  }

thunk:
  %update_end = ptr.add %sp, @AIHC_UPDATE_FRAME_BYTES
  %sp_limit = call @aihc_stack_limit(%base)
  %update_fits = le.u ptr %update_end, %sp_limit
  br %update_fits, push(%sp, %update_end, %continuation), stack_grow

; The runtime puts a forward frame at the start of the new chunk, whose
; parent is the continuation, and gives the frame after it. The rest of the
; chunk follows that frame, and the update frame takes the forward frame as
; its parent. The runtime sets the stack limit of the capability to the end
; of the new chunk. The charge compares the heap limit with the capability
; copy of the heap pointer, so that copy is stored first.
cold stack_grow:
  store ptr %hp, [%base + @AIHC_CAPABILITY_HEAP_NEXT_OFFSET] align 1 word
  %grown = call @aihc_stack_grow(%base, %sp, @AIHC_UPDATE_FRAME_WORDS, %continuation)
  %grown_end = ptr.add %grown, @AIHC_UPDATE_FRAME_BYTES
  %grown_parent = ptr.add %grown, -16
  %grown_hp_limit = call @aihc_heap_limit(%base)
  %heap_left = le.u ptr %hp, %grown_hp_limit
  br %heap_left, push(%grown, %grown_end, %grown_parent), stack_collect

; The new chunk stays empty above the stack pointer, and the next push uses
; it again. The stack growth set the stack limit to the end of the new
; chunk, but the stack pointer stays in the old chunk. Thus this path sets
; the limit back to the end of the old chunk. This is the only store of the
; stack limit in compiled code.
cold stack_collect:
  store ptr %sp, [%base + @AIHC_CAPABILITY_STACK_NEXT_OFFSET] align 1 word
  %sp_below = ptr.add %sp, -1
  %old_sp_limit = call @aihc_stack_chunk_end(%sp_below)
  store ptr %old_sp_limit, [%base + @AIHC_CAPABILITY_STACK_LIMIT_OFFSET] align 1 word
  %thunk_word = ptr.to_int %current
  store i64 %thunk_word, [%roots] align 8
  %thunk_continuation_word = ptr.to_int %continuation
  store i64 %thunk_continuation_word, [%roots + 8] align 8
  ; The value and continuation carry the required static reference tables.
  call @aihc_heap_collect(%base, 0, 2, %roots, null)
  %moved_thunk_word = load i64 [%roots] align 8
  %moved_thunk = ptr.from_int %moved_thunk_word
  %moved_thunk_continuation_word = load i64 [%roots + 8] align 8
  %moved_thunk_continuation = ptr.from_int %moved_thunk_continuation_word
  %collected_hp = load ptr [%base + @AIHC_CAPABILITY_HEAP_NEXT_OFFSET] align 1 word
  tailcall @aihc_lir_eval(%collected_hp, %sp, %base, %moved_thunk, %moved_thunk_continuation)

push(%update: ptr, %pushed_sp: ptr, %parent: ptr):
  %update_info_word = ptr.to_int @aihc_lir_cps_update_info
  store i64 %update_info_word, [%update] align 8
  %parent_word = ptr.to_int %parent
  store i64 %parent_word, [%update + 8] align 8
  %value_word = ptr.to_int %current
  store i64 %value_word, [%update + 16] align 8
  ; The entry writes nothing into the thunk. A pause claims it later, when
  ; the evaluation has not ended by then.
  %entry = call @aihc_info_entry(%header)
  tailcall.indirect %entry(%hp, %pushed_sp, %base, %current, %update) : (ptr, ptr, ptr, ptr, ptr)

indirection:
  %next = call @aihc_indirection_target(%current)
  jump loop(%next)

; The waiter comes from the heap, and the thread gives control to the
; scheduler. Both read the context of the capability.
blackhole:
  store ptr %hp, [%base + @AIHC_CAPABILITY_HEAP_NEXT_OFFSET] align 1 word
  store ptr %sp, [%base + @AIHC_CAPABILITY_STACK_NEXT_OFFSET] align 1 word
  ; A charge of the runtime can put the heap limit below the heap pointer,
  ; so the room is valid only when the limit is not below the pointer.
  %heap_word = ptr.to_int %hp
  %heap_end_word = ptr.to_int %hp_limit
  %heap_below_limit = le.u i64 %heap_word, %heap_end_word
  %heap_room = sub i64 %heap_end_word, %heap_word
  %heap_enough = ge.u i64 %heap_room, @AIHC_EVAL_WAITER_BYTES
  %heap_fits = and i1 %heap_below_limit, %heap_enough
  br %heap_fits, block(%current, %continuation), collect

cold collect:
  %current_word = ptr.to_int %current
  store i64 %current_word, [%roots] align 8
  %continuation_word = ptr.to_int %continuation
  store i64 %continuation_word, [%roots + 8] align 8
  ; The value and continuation carry the required static reference tables.
  call @aihc_heap_collect(%base, @AIHC_EVAL_WAITER_WORDS, 2, %roots, null)
  %moved_value_word = load i64 [%roots] align 8
  %moved_value = ptr.from_int %moved_value_word
  %moved_continuation_word = load i64 [%roots + 8] align 8
  %moved_continuation = ptr.from_int %moved_continuation_word
  jump block(%moved_value, %moved_continuation)

block(%live_value: ptr, %live_continuation: ptr):
  %result = call @aihc_block_on_blackhole(%base, %live_value, %live_continuation)
  tailcall @aihc_lir_resume(%base, %result)

ready:
  tailcall @aihc_lir_continue_p(%hp, %sp, %base, %continuation, %current)
}

; Evaluate a value whose thunk, if it has one, no other evaluation reaches.
; The compiler proved this, and it proved that the thunk gives a value in
; weak-head normal form. Thus the thunk gets no update frame, no
; evaluation mark, and no heap reservation: its entry continues directly to
; the continuation of this evaluation. A value that the ordinary
; evaluation must look at, such as an indirection or a blackhole, goes to
; @aihc_lir_eval. These values do not occur when the proof is correct.
; The entry is a safepoint, as the entry of @aihc_lir_eval is.
export func @aihc_lir_eval_single_entry(%hp: ptr, %sp: ptr, %base: ptr, %value: ptr, %continuation: ptr) {
entry:
  %roots = stack.alloc 16 align 8
  %hp_limit = call @aihc_heap_limit(%base)
  %entry_fits = le.u ptr %hp, %hp_limit
  br %entry_fits, check, entry_collect

cold entry_collect:
  store ptr %hp, [%base + @AIHC_CAPABILITY_HEAP_NEXT_OFFSET] align 1 word
  store ptr %sp, [%base + @AIHC_CAPABILITY_STACK_NEXT_OFFSET] align 1 word
  %value_word = ptr.to_int %value
  store i64 %value_word, [%roots] align 8
  %continuation_word = ptr.to_int %continuation
  store i64 %continuation_word, [%roots + 8] align 8
  ; The value and continuation carry the required static reference tables.
  call @aihc_heap_collect(%base, 0, 2, %roots, null)
  %moved_value_word = load i64 [%roots] align 8
  %moved_value = ptr.from_int %moved_value_word
  %moved_continuation_word = load i64 [%roots + 8] align 8
  %moved_continuation = ptr.from_int %moved_continuation_word
  %collected_hp = load ptr [%base + @AIHC_CAPABILITY_HEAP_NEXT_OFFSET] align 1 word
  tailcall @aihc_lir_eval_single_entry(%collected_hp, %sp, %base, %moved_value, %moved_continuation)

check:
  %header_word = call @aihc_object_header_word_dependent(%value)
  %evaluating = call @aihc_header_is_evaluating(%header_word)
  br %evaluating, shared, inspect

inspect:
  %header = call @aihc_info_table_of_header(%header_word)
  %kind = call @aihc_info_kind(%header)
  switch i64 %kind {
    @AIHC_OBJECT_THUNK -> enter
    @AIHC_OBJECT_INDIRECTION -> shared
    @AIHC_OBJECT_BLACKHOLE -> shared
    default -> ready
  }

enter:
  %entry = call @aihc_info_entry(%header)
  tailcall.indirect %entry(%hp, %sp, %base, %value, %continuation) : (ptr, ptr, ptr, ptr, ptr)

shared:
  tailcall @aihc_lir_eval(%hp, %sp, %base, %value, %continuation)

ready:
  tailcall @aihc_lir_continue_p(%hp, %sp, %base, %continuation, %value)
}

; A null resumption returns control to the host. The capability holds the
; context of the thread there.
; Clear the selected record before the next scheduler operation. The record
; can select another thread, so the context comes from the capability after the
; record is taken: the heap context, and the stack pointer of the thread
; that runs next. A resumption that continues a frame sets the stack pointer
; to that frame when it enters it.
export func @aihc_lir_resume(%capability: ptr, %resume: ptr) {
entry:
  %slots = stack.alloc 40 align 8
  %no_resume = eq ptr %resume, null
  br %no_resume, suspend, dispatch

suspend:
  return

dispatch:
  call @aihc_lir_take_resume(%capability, %resume, %slots)
  %kind = load i64 [%slots] align 8
  %function_word = load i64 [%slots + 8] align 8
  %function = ptr.from_int %function_word
  %continuation_word = load i64 [%slots + 16] align 8
  %continuation = ptr.from_int %continuation_word
  %value = load i64 [%slots + 24] align 8
  %count = load i64 [%slots + 32] align 8
  %hp = load ptr [%capability + @AIHC_CAPABILITY_HEAP_NEXT_OFFSET] align 1 word
  %sp = load ptr [%capability + @AIHC_CAPABILITY_STACK_NEXT_OFFSET] align 1 word
  ; The take of the record set the stack limit of the capability.
  %base = ptr.add %capability, 0
  switch i64 %kind {
    @AIHC_RESUME_APPLY -> apply
    @AIHC_RESUME_CONTINUE -> continue
    @AIHC_RESUME_RAISE -> raise
    default -> invalid
  }

apply:
  switch i64 %count {
    0 -> apply_zero
    1 -> apply_one
    default -> invalid
  }

apply_zero:
  tailcall @aihc_lir_apply_(%hp, %sp, %base, %function, %continuation)

apply_one:
  tailcall @aihc_lir_apply_slot(%hp, %sp, %base, %function, %continuation, %value)

continue:
  switch i64 %count {
    0 -> continue_zero
    1 -> continue_one
    default -> invalid
  }

continue_zero:
  tailcall @aihc_lir_continue_(%hp, %sp, %base, %function)

continue_one:
  tailcall @aihc_lir_continue_slot(%hp, %sp, %base, %function, %value)

raise:
  %result = call @aihc_raise(%capability, %function, %continuation)
  tailcall @aihc_lir_resume(%capability, %result)

invalid:
  call @aihc_no_match()
  trap "invalid scheduler resumption"
}

; The entry of a worker on its own OS thread: a C function that resumes the
; thread the scheduler selected. It returns only when the capability
; suspends, which a host with workers never does.
export func @aihc_lir_worker_enter(%capability: ptr, %resume: ptr) cc c {
entry:
  call @aihc_lir_resume(%capability, %resume)
  return
}

; A C function, so that a caller keeps its values in the registers a C
; call preserves.
export func @aihc_lir_cstring_length(%address: ptr) -> i64 cc c {
entry:
  jump loop(%address, 0)

loop(%current: ptr, %count: i64):
  %byte = load i8 [%current] align 1
  %at_end = eq i8 %byte, 0
  br %at_end, finish(%count), step

step:
  %next_address = ptr.add %current, 1
  %next_count = add i64 %count, 1
  jump loop(%next_address, %next_count)

finish(%length: i64):
  return %length
}

export func @aihc_lir_continue_(%hp: ptr, %sp: ptr, %base: ptr, %continuation: ptr) {
entry:
  jump loop(%continuation)

loop(%current: ptr):
  %header = call @aihc_info_table(%current)
  %entry = call @aihc_info_entry(%header)
  %forward = eq code %entry, null
  br %forward, forward, enter

; A forward frame has no entry. It passes the values to its parent.
cold forward:
  %parent = call @aihc_forward_parent(%current, %header)
  jump loop(%parent)

enter:
  ; Entering a frame pops it and every frame above it: the frame is the new
  ; stack pointer. The stack pointer is a value of its own, so the frame can
  ; stay in the register of the object argument and only the copy moves.
  %entered_sp = ptr.add %current, 0
  %entered_limit = call @aihc_stack_chunk_end(%current)
  %entered_limit_word = ptr.to_int %entered_limit
  %sp_limit = call @aihc_stack_limit(%base)
  %sp_limit_word = ptr.to_int %sp_limit
  %same_chunk = eq i64 %entered_limit_word, %sp_limit_word
  br %same_chunk, enter_frame, enter_chunk

; The frame is in a lower chunk than the stack pointer was. New frames go
; above it, so the collector must scan the chunk again. The runtime also
; sets the stack limit of the capability to the end of the chunk.
cold enter_chunk:
  call @aihc_stack_enter_chunk(%base, %current)
  jump enter_frame

enter_frame:
  tailcall.indirect %entry(%hp, %entered_sp, %base, %current) : (ptr, ptr, ptr, ptr)
}

export func @aihc_lir_continue_i(%hp: ptr, %sp: ptr, %base: ptr, %continuation: ptr, %value: i64) {
entry:
  jump loop(%continuation)

loop(%current: ptr):
  %header = call @aihc_info_table(%current)
  %entry = call @aihc_info_entry(%header)
  %forward = eq code %entry, null
  br %forward, forward, enter

; A forward frame has no entry. It passes the values to its parent.
cold forward:
  %parent = call @aihc_forward_parent(%current, %header)
  jump loop(%parent)

enter:
  ; Entering a frame pops it and every frame above it: the frame is the new
  ; stack pointer. The stack pointer is a value of its own, so the frame can
  ; stay in the register of the object argument and only the copy moves.
  %entered_sp = ptr.add %current, 0
  %entered_limit = call @aihc_stack_chunk_end(%current)
  %entered_limit_word = ptr.to_int %entered_limit
  %sp_limit = call @aihc_stack_limit(%base)
  %sp_limit_word = ptr.to_int %sp_limit
  %same_chunk = eq i64 %entered_limit_word, %sp_limit_word
  br %same_chunk, enter_frame, enter_chunk

; The frame is in a lower chunk than the stack pointer was. New frames go
; above it, so the collector must scan the chunk again. The runtime also
; sets the stack limit of the capability to the end of the chunk.
cold enter_chunk:
  call @aihc_stack_enter_chunk(%base, %current)
  jump enter_frame

enter_frame:
  tailcall.indirect %entry(%hp, %entered_sp, %base, %current, %value) : (ptr, ptr, ptr, ptr, i64)
}

export func @aihc_lir_continue_p(%hp: ptr, %sp: ptr, %base: ptr, %continuation: ptr, %value: ptr) {
entry:
  jump loop(%continuation)

loop(%current: ptr):
  %header = call @aihc_info_table(%current)
  %entry = call @aihc_info_entry(%header)
  %forward = eq code %entry, null
  br %forward, forward, enter

; A forward frame has no entry. It passes the values to its parent.
cold forward:
  %parent = call @aihc_forward_parent(%current, %header)
  jump loop(%parent)

enter:
  ; Entering a frame pops it and every frame above it: the frame is the new
  ; stack pointer. The stack pointer is a value of its own, so the frame can
  ; stay in the register of the object argument and only the copy moves.
  %entered_sp = ptr.add %current, 0
  %entered_limit = call @aihc_stack_chunk_end(%current)
  %entered_limit_word = ptr.to_int %entered_limit
  %sp_limit = call @aihc_stack_limit(%base)
  %sp_limit_word = ptr.to_int %sp_limit
  %same_chunk = eq i64 %entered_limit_word, %sp_limit_word
  br %same_chunk, enter_frame, enter_chunk

; The frame is in a lower chunk than the stack pointer was. New frames go
; above it, so the collector must scan the chunk again. The runtime also
; sets the stack limit of the capability to the end of the chunk.
cold enter_chunk:
  call @aihc_stack_enter_chunk(%base, %current)
  jump enter_frame

enter_frame:
  tailcall.indirect %entry(%hp, %entered_sp, %base, %current, %value) : (ptr, ptr, ptr, ptr, ptr)
}

; Arity counts application stages, not the number of Lir values.
; Each common shape below supplies one application stage.
export func @aihc_lir_apply_(%hp: ptr, %sp: ptr, %base: ptr, %function: ptr, %continuation: ptr) {
entry:
  %slot = stack.alloc 8 align 8
  jump loop(%function)

loop(%current: ptr):
  %header = call @aihc_info_table(%current)
  %kind = call @aihc_info_kind(%header)
  %indirection = eq i64 %kind, @AIHC_OBJECT_INDIRECTION
  br %indirection, indirection, apply

indirection:
  %next = call @aihc_indirection_target(%current)
  jump loop(%next)

apply:
  %arity = call @aihc_info_arity(%header)
  %closure = eq i64 %kind, @AIHC_OBJECT_CLOSURE
  %saturated = eq i64 %arity, 1
  %fast = and i1 %closure, %saturated
  br %fast, fast, slow

fast:
  %entry = call @aihc_info_entry(%header)
  tailcall.indirect %entry(%hp, %sp, %base, %current, %continuation) : (ptr, ptr, ptr, ptr, ptr)

; The runtime can allocate and collect, so the capability gets the context
; first and the heap context comes back after.
slow:
  store ptr %continuation, [%slot] align 8
  store ptr %hp, [%base + @AIHC_CAPABILITY_HEAP_NEXT_OFFSET] align 1 word
  store ptr %sp, [%base + @AIHC_CAPABILITY_STACK_NEXT_OFFSET] align 1 word
  %result = call @aihc_apply_slow(%base, %current, 1, 0, null, %slot)
  %adjusted = load ptr [%slot] align 8
  %applied_hp = load ptr [%base + @AIHC_CAPABILITY_HEAP_NEXT_OFFSET] align 1 word
  tailcall @aihc_lir_continue_p(%applied_hp, %sp, %base, %adjusted, %result)
}

export func @aihc_lir_apply_i(%hp: ptr, %sp: ptr, %base: ptr, %function: ptr, %continuation: ptr, %value: i64) {
entry:
  %arguments = stack.alloc 8 align 8
  %slot = stack.alloc 8 align 8
  jump loop(%function)

loop(%current: ptr):
  %header = call @aihc_info_table(%current)
  %kind = call @aihc_info_kind(%header)
  %indirection = eq i64 %kind, @AIHC_OBJECT_INDIRECTION
  br %indirection, indirection, apply

indirection:
  %next = call @aihc_indirection_target(%current)
  jump loop(%next)

apply:
  %arity = call @aihc_info_arity(%header)
  %closure = eq i64 %kind, @AIHC_OBJECT_CLOSURE
  %saturated = eq i64 %arity, 1
  %fast = and i1 %closure, %saturated
  br %fast, fast, slow

fast:
  %entry = call @aihc_info_entry(%header)
  tailcall.indirect %entry(%hp, %sp, %base, %current, %continuation, %value) : (ptr, ptr, ptr, ptr, ptr, i64)

; The runtime can allocate and collect, so the capability gets the context
; first and the heap context comes back after.
slow:
  store i64 %value, [%arguments] align 8
  store ptr %continuation, [%slot] align 8
  store ptr %hp, [%base + @AIHC_CAPABILITY_HEAP_NEXT_OFFSET] align 1 word
  store ptr %sp, [%base + @AIHC_CAPABILITY_STACK_NEXT_OFFSET] align 1 word
  %result = call @aihc_apply_slow(%base, %current, 1, 1, %arguments, %slot)
  %adjusted = load ptr [%slot] align 8
  %applied_hp = load ptr [%base + @AIHC_CAPABILITY_HEAP_NEXT_OFFSET] align 1 word
  tailcall @aihc_lir_continue_p(%applied_hp, %sp, %base, %adjusted, %result)
}

export func @aihc_lir_apply_p(%hp: ptr, %sp: ptr, %base: ptr, %function: ptr, %continuation: ptr, %value: ptr) {
entry:
  %arguments = stack.alloc 8 align 8
  %slot = stack.alloc 8 align 8
  jump loop(%function)

loop(%current: ptr):
  %header = call @aihc_info_table(%current)
  %kind = call @aihc_info_kind(%header)
  %indirection = eq i64 %kind, @AIHC_OBJECT_INDIRECTION
  br %indirection, indirection, apply

indirection:
  %next = call @aihc_indirection_target(%current)
  jump loop(%next)

apply:
  %arity = call @aihc_info_arity(%header)
  %closure = eq i64 %kind, @AIHC_OBJECT_CLOSURE
  %saturated = eq i64 %arity, 1
  %fast = and i1 %closure, %saturated
  br %fast, fast, slow

fast:
  %entry = call @aihc_info_entry(%header)
  tailcall.indirect %entry(%hp, %sp, %base, %current, %continuation, %value) : (ptr, ptr, ptr, ptr, ptr, ptr)

; The runtime can allocate and collect, so the capability gets the context
; first and the heap context comes back after.
slow:
  %argument_word = ptr.to_int %value
  store i64 %argument_word, [%arguments] align 8
  store ptr %continuation, [%slot] align 8
  store ptr %hp, [%base + @AIHC_CAPABILITY_HEAP_NEXT_OFFSET] align 1 word
  store ptr %sp, [%base + @AIHC_CAPABILITY_STACK_NEXT_OFFSET] align 1 word
  %result = call @aihc_apply_slow(%base, %current, 1, 1, %arguments, %slot)
  %adjusted = load ptr [%slot] align 8
  %applied_hp = load ptr [%base + @AIHC_CAPABILITY_HEAP_NEXT_OFFSET] align 1 word
  tailcall @aihc_lir_continue_p(%applied_hp, %sp, %base, %adjusted, %result)
}

; The bitmap of the frame selects a pointer or an integer argument. The
; bitmap of an object that wants arguments describes its full layout, so the
; entry at the stored count is the kind of the slot that arrives.
; Follow forward frames before the bitmap check, because the frame that
; takes the value is the first frame with an entry.
export func @aihc_lir_continue_slot(%hp: ptr, %sp: ptr, %base: ptr, %continuation: ptr, %value: i64) {
entry:
  jump loop(%continuation)

loop(%current: ptr):
  %header = call @aihc_info_table(%current)
  %frame_entry = call @aihc_info_entry(%header)
  %forward = eq code %frame_entry, null
  br %forward, forward, check

cold forward:
  %parent = call @aihc_forward_parent(%current, %header)
  jump loop(%parent)

check:
  %kind = call @aihc_info_kind(%header)
  %arity = call @aihc_info_arity(%header)
  %wants = ne i64 %arity, 0
  br %wants, count, word

count:
  %kind_is_partial = eq i64 %kind, @AIHC_OBJECT_PARTIAL_CONSTRUCTOR
  br %kind_is_partial, partial_count, info_count

partial_count:
  %applied = load i64 [%current + 8] align 8
  jump bitmap(%applied)

info_count:
  %count = call @aihc_info_count(%header)
  jump bitmap(%count)

bitmap(%count_2: i64):
  %bitmap = call @aihc_info_bitmap(%header)
  %entry = ptr.add %bitmap, %count_2
  %flag = load i8 [%entry] align 1
  %is_pointer = ne i8 %flag, 0
  br %is_pointer, pointer, word

pointer:
  %pointer = ptr.from_int %value
  tailcall @aihc_lir_continue_p(%hp, %sp, %base, %current, %pointer)

word:
  tailcall @aihc_lir_continue_i(%hp, %sp, %base, %current, %value)
}

export func @aihc_lir_apply_slot(%hp: ptr, %sp: ptr, %base: ptr, %function: ptr, %continuation: ptr, %value: i64) {
entry:
  jump loop(%function)

loop(%current: ptr):
  %header = call @aihc_info_table(%current)
  %kind = call @aihc_info_kind(%header)
  %indirection = eq i64 %kind, @AIHC_OBJECT_INDIRECTION
  br %indirection, indirection, check

indirection:
  %next = call @aihc_indirection_target(%current)
  jump loop(%next)

check:
  %arity = call @aihc_info_arity(%header)
  %wants = ne i64 %arity, 0
  br %wants, count, word

count:
  %kind_is_partial = eq i64 %kind, @AIHC_OBJECT_PARTIAL_CONSTRUCTOR
  br %kind_is_partial, partial_count, info_count

partial_count:
  %applied = load i64 [%current + 8] align 8
  jump bitmap(%applied)

info_count:
  %count = call @aihc_info_count(%header)
  jump bitmap(%count)

bitmap(%count_2: i64):
  %bitmap = call @aihc_info_bitmap(%header)
  %entry = ptr.add %bitmap, %count_2
  %flag = load i8 [%entry] align 1
  %is_pointer = ne i8 %flag, 0
  br %is_pointer, pointer, word

pointer:
  %pointer = ptr.from_int %value
  tailcall @aihc_lir_apply_p(%hp, %sp, %base, %current, %continuation, %pointer)

word:
  tailcall @aihc_lir_apply_i(%hp, %sp, %base, %current, %continuation, %value)
}

; The update frame stores the parent continuation and the entered thunk.
; Complete the blackhole update before evaluation of the result.
; Eval creates another update frame only if it enters another thunk.
; The update neither allocates nor reads the stack pointer, so the capability
; does not need the context for it.
extern func @aihc_heap_collect(ptr, i64, i64, ptr, ptr) cc c
extern func @aihc_update_blackhole(ptr, ptr, ptr) -> ptr cc c
extern func @aihc_escape_collect(ptr, i64, ptr, ptr) cc c
extern func @aihc_write_barrier(ptr, ptr) cc c
extern func @aihc_stack_enter_chunk(ptr, ptr) cc c

; A pointer store into the local nursery needs no runtime call.
; Use its aligned base because the heap pointer can equal the nursery end.
inline func @aihc_object_is_young(%capability: ptr, %object: ptr) -> i1 {
entry:
  %object_word = ptr.to_int %object
  %start = load ptr [%capability + @AIHC_CAPABILITY_HEAP_START_OFFSET] align 1 word
  %start_word = ptr.to_int %start
  %offset = xor i64 %object_word, %start_word
  %bytes = load i64 [%capability + @AIHC_CAPABILITY_NURSERY_BYTES_OFFSET] align 8
  %young = lt.u i64 %offset, %bytes
  return %young
}

; Update a thunk with the result of its evaluation: the result goes into
; field zero, and the header keeps the thunk table with bit zero. Most
; thunks are young, and no pause claimed them, so the two stores do the
; update here. An old thunk goes to the C update, which records it in the
; remembered set. A claimed thunk goes there as well, and the C update wakes
; the waiters of its queue. An object that is not a thunk also goes to the C
; update, which stops the program.
inline func @aihc_update_blackhole_inline(%base: ptr, %outer: ptr, %blackhole: ptr, %result: ptr) -> i1 {
entry:
  %header_word = call @aihc_object_header_word(%blackhole)
  %tag = and i64 %header_word, @AIHC_HEADER_TAG_MASK
  %unclaimed = eq i64 %tag, 0
  %young = call @aihc_object_is_young(%base, %blackhole)
  %plain = and i1 %unclaimed, %young
  br %plain, plain, waiters

; Both stores are release stores. The value is in field zero before a
; reader can see bit zero, and the stores of the evaluation are visible to
; a reader that loads the value with a dependency.
plain:
  %result_word = ptr.to_int %result
  store.atomic release i64 %result_word, [%blackhole + 8]
  %evaluated_word = or i64 %header_word, @AIHC_HEADER_EVALUATING
  store.atomic release i64 %evaluated_word, [%blackhole]
  return 1

; The C update gives null when the update is an escape whose promotion
; needs a collection. The parent continuation is the top frame of the
; thread, from which a promotion runs the pause walk.
cold waiters:
  store ptr %outer, [%base + @AIHC_CAPABILITY_PAUSE_TOP_OFFSET] align 1 word
  %stored = call @aihc_update_blackhole(%base, %blackhole, %result)
  %updated = ne ptr %stored, null
  return %updated
}

; Whether the result of a thunk is a value. The result is usually a value,
; and then the parent continuation takes it directly. Another object goes
; to @aihc_lir_eval.
inline func @aihc_result_ready(%result: ptr) -> i1 {
entry:
  %header = call @aihc_info_table(%result)
  %needs_eval = load i8 [%header + @AIHC_INFO_NEEDS_EVAL_OFFSET] align 1
  %ready = eq i8 %needs_eval, @AIHC_NEEDS_EVAL_NONE
  return %ready
}

; Update the blackhole with the result of its thunk. When the update is an
; escape whose promotion needs a collection, the collection moves every
; young survivor into gen2, and the update runs again. The parent
; continuation, the blackhole, and the result are the roots.
export func @aihc_lir_cps_update(%hp: ptr, %sp: ptr, %base: ptr, %outer: ptr, %blackhole: ptr, %result: ptr) {
entry:
  %roots = stack.alloc 24 align 8
  jump update(%hp, %outer, %blackhole, %result)

update(%current_hp: ptr, %current_outer: ptr, %current_blackhole: ptr, %current_result: ptr):
  %updated = call @aihc_update_blackhole_inline(%base, %current_outer, %current_blackhole, %current_result)
  br %updated, check, collect

check:
  %ready = call @aihc_result_ready(%current_result)
  br %ready, ready, evaluate

ready:
  tailcall @aihc_lir_continue_p(%current_hp, %sp, %base, %current_outer, %current_result)

evaluate:
  tailcall @aihc_lir_eval(%current_hp, %sp, %base, %current_result, %current_outer)

cold collect:
  store ptr %current_hp, [%base + @AIHC_CAPABILITY_HEAP_NEXT_OFFSET] align 1 word
  store ptr %sp, [%base + @AIHC_CAPABILITY_STACK_NEXT_OFFSET] align 1 word
  %outer_word = ptr.to_int %current_outer
  store i64 %outer_word, [%roots] align 8
  %blackhole_word = ptr.to_int %current_blackhole
  store i64 %blackhole_word, [%roots + 8] align 8
  %result_word = ptr.to_int %current_result
  store i64 %result_word, [%roots + 16] align 8
  call @aihc_escape_collect(%base, 3, %roots, null)
  %moved_outer_word = load i64 [%roots] align 8
  %moved_outer = ptr.from_int %moved_outer_word
  %moved_blackhole_word = load i64 [%roots + 8] align 8
  %moved_blackhole = ptr.from_int %moved_blackhole_word
  %moved_result_word = load i64 [%roots + 16] align 8
  %moved_result = ptr.from_int %moved_result_word
  %collected_hp = load ptr [%base + @AIHC_CAPABILITY_HEAP_NEXT_OFFSET] align 1 word
  jump update(%collected_hp, %moved_outer, %moved_blackhole, %moved_result)
}

; The backend entry of the update frame. A continue helper enters the frame
; with the result, and this entry reads the two stored fields itself.
export func @aihc_lir_cps_update_entry(%hp: ptr, %sp: ptr, %base: ptr, %frame: ptr, %result: ptr) {
entry:
  %outer_word = load i64 [%frame + 8] align 8
  %outer = ptr.from_int %outer_word
  %blackhole_word = load i64 [%frame + 16] align 8
  %blackhole = ptr.from_int %blackhole_word
  %header_word = call @aihc_object_header_word(%blackhole)
  %tag = and i64 %header_word, @AIHC_HEADER_TAG_MASK
  %unclaimed = eq i64 %tag, 0
  br %unclaimed, young_check, shared

; The usual update: a young thunk that no pause claimed, and a result that
; is a value. The update and the return to the parent continuation happen
; here, as @aihc_lir_cps_update and @aihc_lir_continue_p do them. Any other
; case goes to @aihc_lir_cps_update.
young_check:
  %young = call @aihc_object_is_young(%base, %blackhole)
  br %young, ready_check, shared

ready_check:
  %ready = call @aihc_result_ready(%result)
  br %ready, update, shared

update:
  %result_word = ptr.to_int %result
  store.atomic release i64 %result_word, [%blackhole + 8]
  %evaluated_word = or i64 %header_word, @AIHC_HEADER_EVALUATING
  store.atomic release i64 %evaluated_word, [%blackhole]
  ; A frame with an entry is in the chunk of the stack pointer: a chunk
  ; boundary has a forward frame, which goes to the continue helper.
  %outer_header = call @aihc_info_table(%outer)
  %entry = call @aihc_info_entry(%outer_header)
  %forward = eq code %entry, null
  br %forward, continue, enter

enter:
  tailcall.indirect %entry(%hp, %outer, %base, %outer, %result) : (ptr, ptr, ptr, ptr, ptr)

cold continue:
  tailcall @aihc_lir_continue_p(%hp, %sp, %base, %outer, %result)

cold shared:
  tailcall @aihc_lir_cps_update(%hp, %sp, %base, %outer, %blackhole, %result)
}

data @aihc_indirection_bitmap align 1 = {
  bytes "\x01"
}

; The info table of an updated thunk: one stored field, the result. The C
; runtime also writes it in aihc_update.
export data @aihc_indirection_info align 8 = {
  code null,                         ; identity
  ptr @aihc_indirection_bitmap,      ; field_is_pointer
  ptr null,                          ; next
  code null,                         ; backend_entry
  ptr null,                          ; srt
  i8 1,                              ; field_count
  i8 0,                              ; remaining_arity
  i8 @AIHC_FRAME_NONE,               ; frame_kind
  i8 @AIHC_OBJECT_INDIRECTION,       ; object_kind
  i8 @AIHC_NEEDS_EVAL_FOLLOW,        ; needs_eval
  i8 0,                              ; padding
  i16 0                              ; constructor_index
}

; The forward frame at the start of each chunk after the first one of a
; stack. Its one field is the continuation in the chunk below. A return to
; it goes through a continue helper, which follows it to that continuation,
; sets the stack limit of the entered chunk, and makes the chunk young
; again. Thus a frame with an entry is always in the chunk of the stack
; pointer, and the inline return of compiled code tests no chunk.
; aihc_stack_grow writes this frame.
export data @aihc_lir_chunk_forward_info align 8 = {
  code null,                         ; identity
  ptr @aihc_indirection_bitmap,      ; field_is_pointer
  ptr null,                          ; next
  code null,                         ; backend_entry
  ptr null,                          ; srt
  i8 1,                              ; field_count
  i8 0,                              ; remaining_arity
  i8 @AIHC_FRAME_FORWARD,            ; frame_kind
  i8 @AIHC_OBJECT_CLOSURE,           ; object_kind
  i8 @AIHC_NEEDS_EVAL_NONE,          ; needs_eval
  i8 0,                              ; padding
  i16 0                              ; constructor_index
}

data @aihc_lir_cps_update_bitmap align 1 = {
  bytes "\x01\x01\x01"
}

; The closure before the thunk's result is applied to it: two stored fields
; and one still wanted. The bitmap also describes the wanted field.
export data @aihc_lir_cps_update_info align 8 = {
  code @aihc_lir_cps_update,              ; identity
  ptr @aihc_lir_cps_update_bitmap,        ; field_is_pointer
  ptr null,                               ; next
  code @aihc_lir_cps_update_entry,       ; backend_entry
  ptr null,                               ; srt
  i8 2,                                   ; field_count
  i8 1,                                   ; remaining_arity
  i8 @AIHC_FRAME_UPDATE,                  ; frame_kind
  i8 @AIHC_OBJECT_CLOSURE,                ; object_kind
  i8 @AIHC_NEEDS_EVAL_NONE,               ; needs_eval
  i8 0,                                   ; padding
  i16 0                                   ; constructor_index
}
