; Shared evaluation, application, continuation, and scalar helpers.
; Common argument shapes are [], [ptr], and [i64].
; The compiler emits other shapes in the module that needs them.
; Heap slots have eight bytes on every target.
; The reads of a header and of an info table go through the inline
; functions of aihc_object.lir, which cost what they would written out.
; C code transfers scheduler records.
;
; A helper that runs Haskell code takes the machine and then the context of
; the running thread: the heap pointer %hp, the heap limit %hp_limit, the
; stack pointer %sp, and the stack limit %sp_limit. It gives the context to
; each function it transfers control to. The machine holds a copy of the
; heap pointer and the stack pointer only while a C call can read them. See
; "Lowering from GC-GRIN" in docs/lir.md.

include "aihc_object.lir"

const @WORD_BITS = 64
const @WORD_HIGH_BIT = 63

extern func @aihc_lir_take_resume(ptr, ptr, ptr) cc c

extern func @aihc_apply_slow(ptr, ptr, i64, i64, ptr, ptr) -> ptr cc c

extern func @aihc_block_on_blackhole(ptr, ptr, ptr) -> ptr cc c

extern func @aihc_no_match() cc c

extern func @aihc_raise(ptr, ptr, ptr) -> ptr cc c

extern func @aihc_stack_grow(ptr, ptr, i64) -> ptr cc c

; The end of the stack chunk that holds an address. A chunk has
; AIHC_STACK_CHUNK_BYTES bytes and the same alignment.
inline func @aihc_stack_chunk_end(%address: ptr) -> ptr {
entry:
  %word = ptr.to_int %address
  %last = or i64 %word, @AIHC_STACK_CHUNK_LAST
  %end = add i64 %last, 1
  %limit = ptr.from_int %end
  return %limit
}

; Push a frame of the given words on the stack of the running thread. Give
; back the frame, the new stack pointer, and the new stack limit. The caller
; writes the header and every field. The frame fits in the current chunk
; when the new stack pointer is not above the stack limit. Otherwise the
; runtime continues the stack in the next chunk. Neither path collects.
inline func @aihc_stack_push_frame(%machine: ptr, %sp: ptr, %sp_limit: ptr, %words: i64) -> (ptr, ptr, ptr) {
entry:
  %bytes = mul i64 %words, 8
  %end = ptr.add %sp, %bytes
  %fits = le.u ptr %end, %sp_limit
  br %fits, fits, grow

fits:
  return %sp, %end, %sp_limit

; The runtime gives the first frame of a chunk, so the rest of the chunk
; follows the frame.
grow:
  %grown = call @aihc_stack_grow(%machine, %sp, %words)
  %grown_end = ptr.add %grown, %bytes
  %grown_limit = ptr.add %grown, @AIHC_STACK_CHUNK_FRAME_BYTES
  return %grown, %grown_end, %grown_limit
}

; Only blackholes require a heap reservation. A thunk pushes its update
; frame on the stack of the thread, which never collects.
export func @aihc_lir_eval(%machine: ptr, %hp: ptr, %hp_limit: ptr, %sp: ptr, %sp_limit: ptr, %value: ptr, %continuation: ptr) {
entry:
  %roots = stack.alloc 16 align 8
  jump loop(%value)

loop(%current: ptr):
  %header_word = call @aihc_object_header_word(%current)
  %evaluating = call @aihc_header_is_evaluating(%header_word)
  br %evaluating, blackhole, inspect

inspect:
  %header = call @aihc_info_table_of_header(%header_word)
  %kind = call @aihc_info_kind(%header)
  switch i64 %kind {
    @AIHC_OBJECT_THUNK -> thunk
    @AIHC_OBJECT_INDIRECTION -> indirection
    @AIHC_OBJECT_BLACKHOLE -> blackhole
    default -> ready
  }

thunk:
  %update, %pushed_sp, %pushed_sp_limit = call @aihc_stack_push_frame(%machine, %sp, %sp_limit, @AIHC_UPDATE_FRAME_WORDS)
  %update_info_word = ptr.to_int @aihc_lir_cps_update_info
  store i64 %update_info_word, [%update] align 8
  %parent_word = ptr.to_int %continuation
  store i64 %parent_word, [%update + 8] align 8
  %value_word = ptr.to_int %current
  store i64 %value_word, [%update + 16] align 8
  ; The thunk payload and original info table remain intact.
  %entry = call @aihc_info_entry(%header)
  %marked = or i64 %header_word, @AIHC_HEADER_EVALUATING
  store i64 %marked, [%current] align 8
  tailcall.indirect %entry(%machine, %hp, %hp_limit, %pushed_sp, %pushed_sp_limit, %current, %update) : (ptr, ptr, ptr, ptr, ptr, ptr, ptr)

indirection:
  %next = call @aihc_indirection_target(%current)
  jump loop(%next)

; The waiter comes from the heap, and the thread gives control to the
; scheduler. Both read the context of the machine.
blackhole:
  store ptr %hp, [%machine + @AIHC_MACHINE_HEAP_NEXT_OFFSET] align 1 word
  store ptr %sp, [%machine + @AIHC_MACHINE_STACK_NEXT_OFFSET] align 1 word
  %heap_word = ptr.to_int %hp
  %heap_end_word = ptr.to_int %hp_limit
  %heap_room = sub i64 %heap_end_word, %heap_word
  %heap_fits = ge.u i64 %heap_room, @AIHC_EVAL_WAITER_BYTES
  br %heap_fits, block(%current, %continuation), collect

collect:
  %current_word = ptr.to_int %current
  store i64 %current_word, [%roots] align 8
  %continuation_word = ptr.to_int %continuation
  store i64 %continuation_word, [%roots + 8] align 8
  ; The value and continuation carry the required static reference tables.
  call @aihc_heap_collect(%machine, @AIHC_EVAL_WAITER_WORDS, 2, %roots, null)
  %moved_value_word = load i64 [%roots] align 8
  %moved_value = ptr.from_int %moved_value_word
  %moved_continuation_word = load i64 [%roots + 8] align 8
  %moved_continuation = ptr.from_int %moved_continuation_word
  jump block(%moved_value, %moved_continuation)

block(%live_value: ptr, %live_continuation: ptr):
  %result = call @aihc_block_on_blackhole(%machine, %live_value, %live_continuation)
  tailcall @aihc_lir_resume(%machine, %result)

ready:
  tailcall @aihc_lir_continue_p(%machine, %hp, %hp_limit, %sp, %sp_limit, %continuation, %current)
}

; Evaluate a value whose thunk, if it has one, no other evaluation reaches.
; The compiler proved this, and it proved that the thunk gives a value in
; weak-head normal form. Thus the thunk gets no update frame, no
; evaluation mark, and no heap reservation: its entry continues directly to
; the continuation of this evaluation. A value that the ordinary
; evaluation must look at, such as an indirection or a blackhole, goes to
; @aihc_lir_eval. These values do not occur when the proof is correct.
export func @aihc_lir_eval_single_entry(%machine: ptr, %hp: ptr, %hp_limit: ptr, %sp: ptr, %sp_limit: ptr, %value: ptr, %continuation: ptr) {
entry:
  %header_word = call @aihc_object_header_word(%value)
  %evaluating = call @aihc_header_is_evaluating(%header_word)
  br %evaluating, shared, inspect

inspect:
  %header = call @aihc_info_table_of_header(%header_word)
  %kind = call @aihc_info_kind(%header)
  switch i64 %kind {
    @AIHC_OBJECT_THUNK -> enter
    @AIHC_OBJECT_INDIRECTION -> shared
    @AIHC_OBJECT_BLACKHOLE -> shared
    default -> ready
  }

enter:
  %entry = call @aihc_info_entry(%header)
  tailcall.indirect %entry(%machine, %hp, %hp_limit, %sp, %sp_limit, %value, %continuation) : (ptr, ptr, ptr, ptr, ptr, ptr, ptr)

shared:
  tailcall @aihc_lir_eval(%machine, %hp, %hp_limit, %sp, %sp_limit, %value, %continuation)

ready:
  tailcall @aihc_lir_continue_p(%machine, %hp, %hp_limit, %sp, %sp_limit, %continuation, %value)
}

; A null resumption returns control to the host. The machine holds the
; context of the thread there.
; Clear the selected record before the next scheduler operation. The record
; can select another thread, so the context comes from the machine after the
; record is taken: the heap context, and the stack pointer of the thread
; that runs next. A resumption that continues a frame sets the stack pointer
; to that frame when it enters it.
export func @aihc_lir_resume(%machine: ptr, %resume: ptr) {
entry:
  %slots = stack.alloc 40 align 8
  %no_resume = eq ptr %resume, null
  br %no_resume, suspend, dispatch

suspend:
  return

dispatch:
  call @aihc_lir_take_resume(%machine, %resume, %slots)
  %kind = load i64 [%slots] align 8
  %function_word = load i64 [%slots + 8] align 8
  %function = ptr.from_int %function_word
  %continuation_word = load i64 [%slots + 16] align 8
  %continuation = ptr.from_int %continuation_word
  %value = load i64 [%slots + 24] align 8
  %count = load i64 [%slots + 32] align 8
  %hp = load ptr [%machine + @AIHC_MACHINE_HEAP_NEXT_OFFSET] align 1 word
  %hp_limit = load ptr [%machine + @AIHC_MACHINE_HEAP_LIMIT_OFFSET] align 1 word
  %sp = load ptr [%machine + @AIHC_MACHINE_STACK_NEXT_OFFSET] align 1 word
  ; The stack pointer can be the end of a full chunk, so the limit comes
  ; from the byte before it.
  %sp_below = ptr.add %sp, -1
  %sp_limit = call @aihc_stack_chunk_end(%sp_below)
  switch i64 %kind {
    @AIHC_RESUME_APPLY -> apply
    @AIHC_RESUME_CONTINUE -> continue
    @AIHC_RESUME_RAISE -> raise
    default -> invalid
  }

apply:
  switch i64 %count {
    0 -> apply_zero
    1 -> apply_one
    default -> invalid
  }

apply_zero:
  tailcall @aihc_lir_apply_(%machine, %hp, %hp_limit, %sp, %sp_limit, %function, %continuation)

apply_one:
  tailcall @aihc_lir_apply_slot(%machine, %hp, %hp_limit, %sp, %sp_limit, %function, %continuation, %value)

continue:
  switch i64 %count {
    0 -> continue_zero
    1 -> continue_one
    default -> invalid
  }

continue_zero:
  tailcall @aihc_lir_continue_(%machine, %hp, %hp_limit, %sp, %sp_limit, %function)

continue_one:
  tailcall @aihc_lir_continue_slot(%machine, %hp, %hp_limit, %sp, %sp_limit, %function, %value)

raise:
  %result = call @aihc_raise(%machine, %function, %continuation)
  tailcall @aihc_lir_resume(%machine, %result)

invalid:
  call @aihc_no_match()
  trap "invalid scheduler resumption"
}

export func @aihc_lir_quotrem2(%high: i64, %low: i64, %divisor: i64) -> (i64, i64) {
entry:
  jump loop(%high, %low, 0, @WORD_BITS)

loop(%h: i64, %l: i64, %q: i64, %n: i64):
  %done = eq i64 %n, 0
  br %done, finish(%q, %h), step

step:
  %top = shr.u i64 %h, @WORD_HIGH_BIT
  %top_set = ne i64 %top, 0
  %carry = shr.u i64 %l, @WORD_HIGH_BIT
  %shifted_high = shl i64 %h, 1
  %next_high = or i64 %shifted_high, %carry
  %next_low = shl i64 %l, 1
  %next_quotient = shl i64 %q, 1
  %next_count = sub i64 %n, 1
  %fits = ge.u i64 %next_high, %divisor
  %subtract = or i1 %top_set, %fits
  br %subtract, subtract(%next_high, %next_low, %next_quotient, %next_count), loop(%next_high, %next_low, %next_quotient, %next_count)

subtract(%h_2: i64, %l_2: i64, %q_2: i64, %n_2: i64):
  %reduced = sub i64 %h_2, %divisor
  %set_quotient = or i64 %q_2, 1
  jump loop(%reduced, %l_2, %set_quotient, %n_2)

finish(%quotient: i64, %remainder: i64):
  return %quotient, %remainder
}

; A C function, so that a caller keeps its values in the registers a C
; call preserves.
export func @aihc_lir_cstring_length(%address: ptr) -> i64 cc c {
entry:
  jump loop(%address, 0)

loop(%current: ptr, %count: i64):
  %byte = load i8 [%current] align 1
  %at_end = eq i8 %byte, 0
  br %at_end, finish(%count), step

step:
  %next_address = ptr.add %current, 1
  %next_count = add i64 %count, 1
  jump loop(%next_address, %next_count)

finish(%length: i64):
  return %length
}

export func @aihc_lir_continue_(%machine: ptr, %hp: ptr, %hp_limit: ptr, %sp: ptr, %sp_limit: ptr, %continuation: ptr) {
entry:
  jump loop(%continuation)

loop(%current: ptr):
  %header = call @aihc_info_table(%current)
  %follows = call @aihc_follows_indirection(%header)
  br %follows, indirection, enter

indirection:
  %next = call @aihc_indirection_target(%current)
  jump loop(%next)

enter:
  ; Entering a frame pops it and every frame above it: the frame is the new
  ; stack pointer, and its chunk gives the stack limit. The stack pointer is
  ; a value of its own, so the frame can stay in the register of the object
  ; argument and only the copy moves.
  %entered_sp = ptr.add %current, 0
  %entered_limit = call @aihc_stack_chunk_end(%current)
  %entry = call @aihc_info_entry(%header)
  tailcall.indirect %entry(%machine, %hp, %hp_limit, %entered_sp, %entered_limit, %current, null) : (ptr, ptr, ptr, ptr, ptr, ptr, ptr)
}

export func @aihc_lir_continue_i(%machine: ptr, %hp: ptr, %hp_limit: ptr, %sp: ptr, %sp_limit: ptr, %continuation: ptr, %value: i64) {
entry:
  jump loop(%continuation)

loop(%current: ptr):
  %header = call @aihc_info_table(%current)
  %follows = call @aihc_follows_indirection(%header)
  br %follows, indirection, enter

indirection:
  %next = call @aihc_indirection_target(%current)
  jump loop(%next)

enter:
  ; Entering a frame pops it and every frame above it: the frame is the new
  ; stack pointer, and its chunk gives the stack limit. The stack pointer is
  ; a value of its own, so the frame can stay in the register of the object
  ; argument and only the copy moves.
  %entered_sp = ptr.add %current, 0
  %entered_limit = call @aihc_stack_chunk_end(%current)
  %entry = call @aihc_info_entry(%header)
  tailcall.indirect %entry(%machine, %hp, %hp_limit, %entered_sp, %entered_limit, %current, null, %value) : (ptr, ptr, ptr, ptr, ptr, ptr, ptr, i64)
}

export func @aihc_lir_continue_p(%machine: ptr, %hp: ptr, %hp_limit: ptr, %sp: ptr, %sp_limit: ptr, %continuation: ptr, %value: ptr) {
entry:
  jump loop(%continuation)

loop(%current: ptr):
  %header = call @aihc_info_table(%current)
  %follows = call @aihc_follows_indirection(%header)
  br %follows, indirection, enter

indirection:
  %next = call @aihc_indirection_target(%current)
  jump loop(%next)

enter:
  ; Entering a frame pops it and every frame above it: the frame is the new
  ; stack pointer, and its chunk gives the stack limit. The stack pointer is
  ; a value of its own, so the frame can stay in the register of the object
  ; argument and only the copy moves.
  %entered_sp = ptr.add %current, 0
  %entered_limit = call @aihc_stack_chunk_end(%current)
  %entry = call @aihc_info_entry(%header)
  tailcall.indirect %entry(%machine, %hp, %hp_limit, %entered_sp, %entered_limit, %current, null, %value) : (ptr, ptr, ptr, ptr, ptr, ptr, ptr, ptr)
}

; Arity counts application stages, not the number of Lir values.
; Each common shape below supplies one application stage.
export func @aihc_lir_apply_(%machine: ptr, %hp: ptr, %hp_limit: ptr, %sp: ptr, %sp_limit: ptr, %function: ptr, %continuation: ptr) {
entry:
  %slot = stack.alloc 8 align 8
  jump loop(%function)

loop(%current: ptr):
  %header = call @aihc_info_table(%current)
  %kind = call @aihc_info_kind(%header)
  %indirection = eq i64 %kind, @AIHC_OBJECT_INDIRECTION
  br %indirection, indirection, apply

indirection:
  %next = call @aihc_indirection_target(%current)
  jump loop(%next)

apply:
  %arity = call @aihc_info_arity(%header)
  %closure = eq i64 %kind, @AIHC_OBJECT_CLOSURE
  %saturated = eq i64 %arity, 1
  %fast = and i1 %closure, %saturated
  br %fast, fast, slow

fast:
  %entry = call @aihc_info_entry(%header)
  tailcall.indirect %entry(%machine, %hp, %hp_limit, %sp, %sp_limit, %current, %continuation) : (ptr, ptr, ptr, ptr, ptr, ptr, ptr)

; The runtime can allocate and collect, so the machine gets the context
; first and the heap context comes back after.
slow:
  store ptr %continuation, [%slot] align 8
  store ptr %hp, [%machine + @AIHC_MACHINE_HEAP_NEXT_OFFSET] align 1 word
  store ptr %sp, [%machine + @AIHC_MACHINE_STACK_NEXT_OFFSET] align 1 word
  %result = call @aihc_apply_slow(%machine, %current, 1, 0, null, %slot)
  %adjusted = load ptr [%slot] align 8
  %applied_hp = load ptr [%machine + @AIHC_MACHINE_HEAP_NEXT_OFFSET] align 1 word
  %applied_hp_limit = load ptr [%machine + @AIHC_MACHINE_HEAP_LIMIT_OFFSET] align 1 word
  tailcall @aihc_lir_continue_p(%machine, %applied_hp, %applied_hp_limit, %sp, %sp_limit, %adjusted, %result)
}

export func @aihc_lir_apply_i(%machine: ptr, %hp: ptr, %hp_limit: ptr, %sp: ptr, %sp_limit: ptr, %function: ptr, %continuation: ptr, %value: i64) {
entry:
  %arguments = stack.alloc 8 align 8
  %slot = stack.alloc 8 align 8
  jump loop(%function)

loop(%current: ptr):
  %header = call @aihc_info_table(%current)
  %kind = call @aihc_info_kind(%header)
  %indirection = eq i64 %kind, @AIHC_OBJECT_INDIRECTION
  br %indirection, indirection, apply

indirection:
  %next = call @aihc_indirection_target(%current)
  jump loop(%next)

apply:
  %arity = call @aihc_info_arity(%header)
  %closure = eq i64 %kind, @AIHC_OBJECT_CLOSURE
  %saturated = eq i64 %arity, 1
  %fast = and i1 %closure, %saturated
  br %fast, fast, slow

fast:
  %entry = call @aihc_info_entry(%header)
  tailcall.indirect %entry(%machine, %hp, %hp_limit, %sp, %sp_limit, %current, %continuation, %value) : (ptr, ptr, ptr, ptr, ptr, ptr, ptr, i64)

; The runtime can allocate and collect, so the machine gets the context
; first and the heap context comes back after.
slow:
  store i64 %value, [%arguments] align 8
  store ptr %continuation, [%slot] align 8
  store ptr %hp, [%machine + @AIHC_MACHINE_HEAP_NEXT_OFFSET] align 1 word
  store ptr %sp, [%machine + @AIHC_MACHINE_STACK_NEXT_OFFSET] align 1 word
  %result = call @aihc_apply_slow(%machine, %current, 1, 1, %arguments, %slot)
  %adjusted = load ptr [%slot] align 8
  %applied_hp = load ptr [%machine + @AIHC_MACHINE_HEAP_NEXT_OFFSET] align 1 word
  %applied_hp_limit = load ptr [%machine + @AIHC_MACHINE_HEAP_LIMIT_OFFSET] align 1 word
  tailcall @aihc_lir_continue_p(%machine, %applied_hp, %applied_hp_limit, %sp, %sp_limit, %adjusted, %result)
}

export func @aihc_lir_apply_p(%machine: ptr, %hp: ptr, %hp_limit: ptr, %sp: ptr, %sp_limit: ptr, %function: ptr, %continuation: ptr, %value: ptr) {
entry:
  %arguments = stack.alloc 8 align 8
  %slot = stack.alloc 8 align 8
  jump loop(%function)

loop(%current: ptr):
  %header = call @aihc_info_table(%current)
  %kind = call @aihc_info_kind(%header)
  %indirection = eq i64 %kind, @AIHC_OBJECT_INDIRECTION
  br %indirection, indirection, apply

indirection:
  %next = call @aihc_indirection_target(%current)
  jump loop(%next)

apply:
  %arity = call @aihc_info_arity(%header)
  %closure = eq i64 %kind, @AIHC_OBJECT_CLOSURE
  %saturated = eq i64 %arity, 1
  %fast = and i1 %closure, %saturated
  br %fast, fast, slow

fast:
  %entry = call @aihc_info_entry(%header)
  tailcall.indirect %entry(%machine, %hp, %hp_limit, %sp, %sp_limit, %current, %continuation, %value) : (ptr, ptr, ptr, ptr, ptr, ptr, ptr, ptr)

; The runtime can allocate and collect, so the machine gets the context
; first and the heap context comes back after.
slow:
  %argument_word = ptr.to_int %value
  store i64 %argument_word, [%arguments] align 8
  store ptr %continuation, [%slot] align 8
  store ptr %hp, [%machine + @AIHC_MACHINE_HEAP_NEXT_OFFSET] align 1 word
  store ptr %sp, [%machine + @AIHC_MACHINE_STACK_NEXT_OFFSET] align 1 word
  %result = call @aihc_apply_slow(%machine, %current, 1, 1, %arguments, %slot)
  %adjusted = load ptr [%slot] align 8
  %applied_hp = load ptr [%machine + @AIHC_MACHINE_HEAP_NEXT_OFFSET] align 1 word
  %applied_hp_limit = load ptr [%machine + @AIHC_MACHINE_HEAP_LIMIT_OFFSET] align 1 word
  tailcall @aihc_lir_continue_p(%machine, %applied_hp, %applied_hp_limit, %sp, %sp_limit, %adjusted, %result)
}

; The next-stage bitmap selects a pointer or an integer argument.
; Follow indirections before the bitmap check.
export func @aihc_lir_continue_slot(%machine: ptr, %hp: ptr, %hp_limit: ptr, %sp: ptr, %sp_limit: ptr, %continuation: ptr, %value: i64) {
entry:
  jump loop(%continuation)

loop(%current: ptr):
  %header = call @aihc_info_table(%current)
  %kind = call @aihc_info_kind(%header)
  %indirection = eq i64 %kind, @AIHC_OBJECT_INDIRECTION
  %frame = call @aihc_info_frame(%header)
  %forward = eq i64 %frame, @AIHC_FRAME_FORWARD
  %follows = or i1 %indirection, %forward
  br %follows, indirection, check

indirection:
  %next = call @aihc_indirection_target(%current)
  jump loop(%next)

check:
  %next_info = call @aihc_info_next(%header)
  %has_next = ne ptr %next_info, null
  br %has_next, count, word

count:
  %kind_is_partial = eq i64 %kind, @AIHC_OBJECT_PARTIAL_CONSTRUCTOR
  br %kind_is_partial, partial_count, info_count

partial_count:
  %applied = load i64 [%current + 8] align 8
  jump bitmap(%applied)

info_count:
  %count = call @aihc_info_count(%header)
  jump bitmap(%count)

bitmap(%count_2: i64):
  %bitmap = call @aihc_info_bitmap(%next_info)
  %entry = ptr.add %bitmap, %count_2
  %flag = load i8 [%entry] align 1
  %is_pointer = ne i8 %flag, 0
  br %is_pointer, pointer, word

pointer:
  %pointer = ptr.from_int %value
  tailcall @aihc_lir_continue_p(%machine, %hp, %hp_limit, %sp, %sp_limit, %current, %pointer)

word:
  tailcall @aihc_lir_continue_i(%machine, %hp, %hp_limit, %sp, %sp_limit, %current, %value)
}

export func @aihc_lir_apply_slot(%machine: ptr, %hp: ptr, %hp_limit: ptr, %sp: ptr, %sp_limit: ptr, %function: ptr, %continuation: ptr, %value: i64) {
entry:
  jump loop(%function)

loop(%current: ptr):
  %header = call @aihc_info_table(%current)
  %kind = call @aihc_info_kind(%header)
  %indirection = eq i64 %kind, @AIHC_OBJECT_INDIRECTION
  br %indirection, indirection, check

indirection:
  %next = call @aihc_indirection_target(%current)
  jump loop(%next)

check:
  %next_info = call @aihc_info_next(%header)
  %has_next = ne ptr %next_info, null
  br %has_next, count, word

count:
  %kind_is_partial = eq i64 %kind, @AIHC_OBJECT_PARTIAL_CONSTRUCTOR
  br %kind_is_partial, partial_count, info_count

partial_count:
  %applied = load i64 [%current + 8] align 8
  jump bitmap(%applied)

info_count:
  %count = call @aihc_info_count(%header)
  jump bitmap(%count)

bitmap(%count_2: i64):
  %bitmap = call @aihc_info_bitmap(%next_info)
  %entry = ptr.add %bitmap, %count_2
  %flag = load i8 [%entry] align 1
  %is_pointer = ne i8 %flag, 0
  br %is_pointer, pointer, word

pointer:
  %pointer = ptr.from_int %value
  tailcall @aihc_lir_apply_p(%machine, %hp, %hp_limit, %sp, %sp_limit, %current, %continuation, %pointer)

word:
  tailcall @aihc_lir_apply_i(%machine, %hp, %hp_limit, %sp, %sp_limit, %current, %continuation, %value)
}

; The update frame stores the parent continuation and the entered thunk.
; Complete the blackhole update before evaluation of the result.
; Eval creates another update frame only if it enters another thunk.
; The update neither allocates nor reads the stack pointer, so the machine
; does not need the context for it.
extern func @aihc_heap_collect(ptr, i64, i64, ptr, ptr) cc c
extern func @aihc_update_blackhole(ptr, ptr, ptr) cc c
extern func @aihc_lir_enter_2_1(ptr, ptr, ptr, ptr, ptr, ptr, ptr, ptr)

export func @aihc_lir_cps_update(%machine: ptr, %hp: ptr, %hp_limit: ptr, %sp: ptr, %sp_limit: ptr, %outer: ptr, %blackhole: ptr, %result: ptr) {
entry:
  call @aihc_update_blackhole(%machine, %blackhole, %result)
  tailcall @aihc_lir_eval(%machine, %hp, %hp_limit, %sp, %sp_limit, %result, %outer)
}

data @aihc_lir_cps_update_bitmap align 1 = {
  bytes "\x01\x01"
}

data @aihc_lir_cps_update_applied_bitmap align 1 = {
  bytes "\x01\x01\x01"
}

; The closure before the thunk's result is applied to it: two stored fields
; and one still wanted.
export data @aihc_lir_cps_update_info align 8 = {
  code @aihc_lir_cps_update,              ; identity
  ptr @aihc_lir_cps_update_bitmap,        ; field_is_pointer
  ptr @aihc_lir_cps_update_applied_info,  ; next
  code @aihc_lir_enter_2_1,               ; backend_entry
  ptr null,                               ; srt
  i8 2,                                   ; field_count
  i8 1,                                   ; remaining_arity
  i8 @AIHC_FRAME_UPDATE,                  ; frame_kind
  i8 @AIHC_OBJECT_CLOSURE,                ; object_kind
  i8 @AIHC_NEEDS_EVAL_NONE                ; needs_eval
}

; The saturated stage the collector reads the full width from.
export data @aihc_lir_cps_update_applied_info align 8 = {
  code @aihc_lir_cps_update,
  ptr @aihc_lir_cps_update_applied_bitmap,
  ptr null,
  code null,
  ptr null,
  i8 3,
  i8 0,
  i8 @AIHC_FRAME_UPDATE,
  i8 @AIHC_OBJECT_CLOSURE,
  i8 @AIHC_NEEDS_EVAL_NONE
}
