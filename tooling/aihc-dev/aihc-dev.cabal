cabal-version: 3.8
name: aihc-dev
version: 0.1.0.0
build-type: Simple
license: Unlicense
license-file: LICENSE
author: David Himmelstrup
maintainer: lemmih@gmail.com
category: Development
synopsis: Developer tools for the aihc compiler

library extract-hi
  hs-source-dirs: src
  exposed-modules:
    Aihc.Dev.ExtractHi
    Aihc.Dev.ExtractHi.Compare
    Aihc.Dev.ExtractHi.ToResolveIface
    Aihc.Dev.ExtractHi.Types

  other-modules:
    Aihc.Dev.ExtractHi.GhcSession

  build-depends:
    Cabal-syntax >=3.14 && <3.17,
    aeson >=2.0 && <2.3,
    aihc-parser,
    base >=4.16 && <5,
    bytestring >=0.10.8 && <0.13,
    containers >=0.5 && <0.8,
    directory >=1.2.3 && <1.5,
    filepath >=1.3.0.1 && <1.6,
    ghc >=9.12 && <9.13,
    prettyprinter,
    process >=1.6 && <1.8,
    text >=1.2.3 && <2.2,

  default-extensions: OverloadedStrings
  ghc-options: -Wall
  default-language: GHC2021

library fuzz
  hs-source-dirs: src
  exposed-modules:
    Aihc.Dev.Fuzz
    Aihc.Dev.Fuzz.CLI
    Aihc.Dev.Fuzz.Registry
    Aihc.Dev.Fuzz.TUI

  build-depends:
    QuickCheck >=2.14 && <2.19,
    aihc-grin:fuzz,
    aihc-tc:fuzz,
    async >=2.2 && <2.3,
    base >=4.16 && <5,
    containers >=0.5 && <0.8,
    optparse-applicative >=0.16 && <0.19,
    stm >=2.5 && <2.6,
    terminal-size >=0.3.2 && <0.4,
    time >=1.9 && <1.15,
    unix >=2.7 && <2.9,

  ghc-options: -Wall
  default-language: GHC2021

executable aihc-dev
  main-is: Main.hs
  hs-source-dirs:
    exe
    app/resolve-stackage-progress
    app/tc-stackage-progress

  other-modules:
    BootInterface
    ResolvePackage
    ResolveStackageProgress
    TcStackageProgress

  build-depends:
    Cabal-syntax >=3.14 && <3.17,
    aeson >=2.0 && <2.3,
    aeson-pretty >=0.8 && <0.9,
    aihc,
    aihc-cpp,
    aihc-dev:extract-hi,
    aihc-dev:fuzz,
    aihc-hackage,
    aihc-parser,
    aihc-resolve,
    aihc-tc,
    async,
    base >=4.16 && <5,
    bytestring >=0.10.8 && <0.13,
    containers >=0.5 && <0.8,
    deepseq,
    directory >=1.2.3 && <1.5,
    filepath >=1.3.0.1 && <1.6,
    optparse-applicative >=0.16 && <0.19,
    prettyprinter,
    process >=1.6 && <1.8,
    text >=1.2.3 && <2.2,
    time,
    yaml >=0.11 && <0.12,

  default-extensions: OverloadedStrings
  ghc-options:
    -Wall
    -threaded
    -rtsopts
    -with-rtsopts=-N

  default-language: GHC2021

test-suite spec
  type: exitcode-stdio-1.0
  hs-source-dirs:
    test
    app/resolve-stackage-progress
    app/tc-stackage-progress

  main-is: Spec.hs
  other-modules:
    BootInterface
    ResolvePackage
    ResolveStackageProgress
    TcStackageProgress
    Test.ExtractHiCompare
    Test.Fuzz
    Test.ResolvePackage
    Test.ResolveStackageProgress.PathsModule
    Test.TcStackageProgress

  build-depends:
    Cabal-syntax >=3.14 && <3.17,
    aeson >=2.0 && <2.3,
    aeson-pretty >=0.8 && <0.9,
    aihc,
    aihc-cpp,
    aihc-dev:extract-hi,
    aihc-dev:fuzz,
    aihc-hackage,
    aihc-internal,
    aihc-parser,
    aihc-resolve,
    aihc-tc,
    async,
    base >=4.16 && <5,
    bytestring,
    containers,
    deepseq,
    directory,
    filepath,
    optparse-applicative >=0.16 && <0.19,
    prettyprinter,
    process >=1.6 && <1.8,
    tasty,
    tasty-hunit,
    tasty-quickcheck,
    text >=1.2.3 && <2.2,
    time,
    yaml >=0.11 && <0.12,

  ghc-options:
    -Wall
    -rtsopts
    -with-rtsopts=-M10G

  default-language: GHC2021
