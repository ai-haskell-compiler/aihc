cabal-version: 3.8
name: aihc-hackage-fetch
version: 0.1.0.0
build-type: Simple
license: Unlicense
license-file: LICENSE
author: David Himmelstrup
maintainer: lemmih@gmail.com
category: Development
synopsis: Read the Hackage index and download Hackage releases
description:
  This package holds the network, tar, and zlib code of the aihc tools.
  Build aihc with the Cabal flag -hackage to leave it out.

library
  exposed-modules:
    Aihc.Hackage.Download
    Aihc.Hackage.Fetch
    Aihc.Hackage.Index
    Aihc.Hackage.IndexCache

  hs-source-dirs: src
  build-depends:
    aihc-hackage,
    base >=4.16 && <5,
    bytestring >=0.10.8 && <0.13,
    containers >=0.5 && <0.9,
    directory >=1.2.3 && <1.5,
    filepath >=1.3.0.1 && <1.6,
    http-client >=0.5 && <0.8,
    http-client-tls >=0.2 && <0.4,
    http-types >=0.9 && <0.13,
    tar >=0.5 && <0.7,
    time >=1.9 && <1.15,
    zlib >=0.5.4 && <0.8,

  ghc-options: -Wall
  default-language: GHC2021

test-suite spec
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Spec.hs
  build-depends:
    aihc-hackage,
    aihc-hackage-fetch,
    base >=4.16 && <5,
    bytestring,
    containers,
    directory,
    filepath,
    hedgehog,
    tar,
    tasty,
    tasty-hedgehog,
    tasty-hunit,
    zlib,

  ghc-options:
    -Wall
    -threaded
    -rtsopts
    "-with-rtsopts=-N -M10G"

  default-language: GHC2021
