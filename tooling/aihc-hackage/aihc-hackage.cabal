cabal-version: 3.8
name: aihc-hackage
version: 0.1.0.0
build-type: Simple
license: Unlicense
license-file: LICENSE
author: David Himmelstrup
maintainer: lemmih@gmail.com
category: Development
synopsis: Shared cabal-file utilities for Hackage packages

library
  exposed-modules:
    Aihc.Hackage.Cabal
    Aihc.Hackage.Cache
    Aihc.Hackage.Cpp
    Aihc.Hackage.Headers
    Aihc.Hackage.Preprocessor
    Aihc.Hackage.Release
    Aihc.Hackage.Source
    Aihc.Hackage.Types
    Aihc.Hackage.Util

  hs-source-dirs: src
  build-depends:
    Cabal >=3.14 && <3.17,
    Cabal-syntax >=3.14 && <3.17,
    base >=4.16 && <5,
    bytestring >=0.10.8 && <0.13,
    containers >=0.5 && <0.9,
    directory >=1.2.3 && <1.5,
    filepath >=1.3.0.1 && <1.6,
    text >=1.2.3 && <2.2,

  ghc-options: -Wall
  default-language: GHC2021

test-suite spec
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Spec.hs
  build-depends:
    Cabal-syntax >=3.14 && <3.17,
    aihc-cpp >=2.0 && <2.1,
    aihc-hackage,
    base >=4.16 && <5,
    bytestring,
    containers,
    directory,
    filepath,
    hedgehog,
    tasty,
    tasty-hedgehog,
    tasty-hunit,
    text,

  ghc-options:
    -Wall
    -threaded
    -rtsopts
    "-with-rtsopts=-N -M10G"

  default-language: GHC2021
