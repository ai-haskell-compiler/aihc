cabal-version: 3.8
name: aihc-package-plan
version: 0.1.0.0
build-type: Simple
license: Unlicense
license-file: LICENSE
author: David Himmelstrup
maintainer: lemmih@gmail.com
category: Development
synopsis: Dependency resolution and source loading shared by the aihc tools
extra-source-files:
  test/fixtures/locks/hackage/dep-1.0.cabal
  test/fixtures/locks/local/root.cabal

flag embed-core-libs
  description:
    Put the core-libs sources into the library, for a release executable
    that needs no checkout. The build must have the repository checkout.

  default: False
  manual: True

library
  exposed-modules:
    Aihc.PackagePlan
    Aihc.PackagePlan.Diagnostic
    Aihc.PackagePlan.Lock
    Aihc.PackagePlan.Solver
    Aihc.PackagePlan.Source

  other-modules:
    Aihc.PackagePlan.EmbeddedCoreLibs

  hs-source-dirs: src
  build-depends:
    aeson >=2.0 && <2.3,
    aihc-cabal-syntax >=2.0 && <2.1,
    aihc-cpp,
    aihc-hackage,
    aihc-parser,
    base >=4.16 && <5,
    bytestring >=0.10.8 && <0.13,
    containers >=0.5 && <0.9,
    cryptohash-sha256 >=0.11 && <0.12,
    deepseq,
    directory >=1.2.3 && <1.5,
    filepath >=1.3.0.1 && <1.6,
    text >=2.1.4 && <2.2,
    time >=1.9 && <1.15,
    transformers,

  default-extensions: OverloadedStrings
  ghc-options: -Wall
  default-language: GHC2021

  if flag(embed-core-libs)
    hs-source-dirs: src-embedded
    build-depends:
      file-embed >=0.0.15 && <0.1
  else
    hs-source-dirs: src-not-embedded

test-suite spec
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Spec.hs
  build-depends:
    aihc-cabal-syntax,
    aihc-hackage,
    aihc-hackage-fetch,
    aihc-package-plan,
    base >=4.16 && <5,
    bytestring,
    containers,
    directory,
    filepath,
    hedgehog,
    tasty,
    tasty-hedgehog,
    tasty-hunit,

  ghc-options:
    -Wall
    -threaded
    -rtsopts
    -with-rtsopts=-N

  default-language: GHC2021
