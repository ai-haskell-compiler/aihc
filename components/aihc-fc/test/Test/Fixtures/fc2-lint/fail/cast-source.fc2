scope 1 = "" Test
scope 2 = "aihc-prim" GHC.Types

module 1.Test where

pub type 1.tBool :: 2.tType {
    pub 1.vFalse :: 1.tBool
    pub 1.vTrue :: 1.tBool
}

pub type 1.tInt :: 2.tType {
    pub 1.vI :: 1.tInt
}

pub type 1.tAge :: 2.tType {}

axiom 1.$ax$Age : 1.tAge ~R 1.tInt

val 1.vbad :: 1.tAge
 = 1.vTrue ▷ sym (axiom-co 1.$ax$Age)
