cabal-version: 3.8
name: aihc-fc
version: 0.1.0.0
build-type: Simple
license: Unlicense
license-file: LICENSE
author: David Himmelstrup
maintainer: lemmih@gmail.com
category: Development
synopsis: System FC core language with desugaring and lint

library
  exposed-modules:
    Aihc.Fc
    Aihc.Fc.Axiom
    Aihc.Fc.DeadCode
    Aihc.Fc.Desugar
    Aihc.Fc.Desugar.Expr
    Aihc.Fc.Desugar.Match
    Aihc.Fc.Eval
    Aihc.Fc.Lint
    Aihc.Fc.Lower
    Aihc.Fc.Main
    Aihc.Fc.Merge
    Aihc.Fc.Newtype
    Aihc.Fc.Optimize
    Aihc.Fc.Parser
    Aihc.Fc.Pretty
    Aihc.Fc.Subst
    Aihc.Fc.Syntax
    Aihc.Fc2
    Aihc.Fc2.Convert
    Aihc.Fc2.Desugar
    Aihc.Fc2.Lint
    Aihc.Fc2.Name
    Aihc.Fc2.Parser
    Aihc.Fc2.Pretty
    Aihc.Fc2.Syntax
    Aihc.Fc2.TypeOf
    Aihc.Fc2.Wired

  other-modules:
    Aihc.Fc.Desugar.Deriving
    Aihc.Fc.Desugar.Deriving.AnyClass
    Aihc.Fc.Desugar.Deriving.StockEq
    Aihc.Fc.Desugar.Dictionary
    Aihc.Fc.External
    Aihc.Fc2.Desugar.ConvertCore
    Aihc.Fc2.Desugar.Core
    Aihc.Fc2.Desugar.Core.Deriving
    Aihc.Fc2.Desugar.Core.Deriving.AnyClass
    Aihc.Fc2.Desugar.Core.Deriving.StockEq
    Aihc.Fc2.Desugar.Core.Dictionary
    Aihc.Fc2.Desugar.Core.Expr
    Aihc.Fc2.Desugar.Core.External
    Aihc.Fc2.Desugar.Core.Lower
    Aihc.Fc2.Desugar.Core.Match
    Aihc.Fc2.Desugar.Core.Newtype
    Aihc.Fc2.Desugar.Core.Subst
    Aihc.Fc2.Desugar.Core.Syntax

  hs-source-dirs: src
  build-depends:
    aihc-parser,
    aihc-resolve,
    aihc-tc,
    base >=4.16 && <5,
    bytestring,
    containers,
    directory,
    filepath,
    libffi >=0.2 && <0.3,
    megaparsec >=9.0 && <10,
    text >=1.2,
    transformers,
    unix,

  ghc-options: -Wall
  default-language: GHC2021

test-suite spec
  type: exitcode-stdio-1.0
  hs-source-dirs:
    test
    common
    ../../test/support

  main-is: Spec.hs
  other-modules:
    Aihc.Testing.EvalFixture
    Fc2Golden
    FcGolden
    Test.Fc.Properties
    Test.Fc.Suite
    Test.Fc2.Properties
    Test.Fc2.Suite

  build-depends:
    aeson,
    aihc-fc,
    aihc-parser,
    aihc-resolve,
    aihc-tc,
    base >=4.16 && <5,
    bytestring,
    containers,
    directory,
    filepath,
    hedgehog,
    libffi >=0.2 && <0.3,
    tasty,
    tasty-hedgehog,
    tasty-hunit,
    text,
    unix,
    yaml,

  ghc-options:
    -Wall
    -threaded
    -rtsopts
    "-with-rtsopts=-N -M10G"

  default-language: GHC2021
