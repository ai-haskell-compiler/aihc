cabal-version: 3.8
name: aihc-native
version: 0.1.0.0
build-type: Simple
license: Unlicense
license-file: LICENSE
author: David Himmelstrup
maintainer: lemmih@gmail.com
category: Development
synopsis: Shared backend compilation support for AIHC
data-files:
  runtime/aihc_gc_calloc.c
  runtime/aihc_gc_semispace.c
  runtime/aihc_host_posix.c
  runtime/aihc_host_wasip3.c
  runtime/aihc_runtime.c
  runtime/aihc_runtime.h
  runtime/aihc_runtime_internal.h
  runtime/aihc_runtime_trampoline.c
  runtime/aihc_runtime_trampoline.h
  runtime/aihc_snapshot.c
  runtime/aihc_snapshot.h

library
  exposed-modules:
    Aihc.Native
    Aihc.Native.BlockLayout
    Aihc.Native.RegisterAllocate

  other-modules: Paths_aihc_native
  autogen-modules: Paths_aihc_native
  hs-source-dirs: src
  build-depends:
    aihc-grin,
    aihc-tc,
    base >=4.16 && <5,
    bytestring,
    containers,
    filepath,
    text,

  ghc-options: -Wall
  default-language: GHC2021

test-suite spec
  type: exitcode-stdio-1.0
  hs-source-dirs: test
  main-is: Spec.hs
  other-modules:
    Test.Native.BlockLayout
    Test.Native.Compiler
    Test.Native.Primitive
    Test.Native.RegisterAllocate

  build-depends:
    aihc-grin,
    aihc-native,
    aihc-tc,
    base >=4.16 && <5,
    containers,
    tasty,
    tasty-hunit,
    tasty-quickcheck,
    text,

  ghc-options: -Wall
  default-language: GHC2021
