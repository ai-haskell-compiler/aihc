scope 1 = "" Test
scope 2 = "aihc-prim" GHC.Types

pub type 1.tBool :: 2.tType {
    pub 1.vFalse :: 1.tBool
    pub 1.vTrue :: 1.tBool
}

pub val 1.vnot :: 1.tBool 2.→ 1.tBool
 = λ(x : 1.tBool).
  case x as (scrutinee : 1.tBool) return (1.tBool) of {
    1.vFalse →
      1.vTrue;
    1.vTrue →
      1.vFalse
  }

pub val 1.vanswer :: 1.tBool
 = 1.vnot 1.vFalse
