cabal-version: 3.8
name: aihc-grin
version: 0.1.0.0
build-type: Simple
license: Unlicense
license-file: LICENSE
author: David Himmelstrup
maintainer: lemmih@gmail.com
category: Development
synopsis: Strict graph-reduction intermediate language for AIHC
extra-source-files:
  test/Test/Fixtures/fc2-grin/basic.fc2
  test/Test/Fixtures/fc2-grin/basic.grin

flag fuzz
  description: Build the developer-only Hedgehog property registry
  default: False
  manual: True

library
  exposed-modules:
    Aihc.Grin
    Aihc.Grin.Anf
    Aihc.Grin.Cps
    Aihc.Grin.Gc
    Aihc.Grin.Interpret
    Aihc.Grin.Lint
    Aihc.Grin.Lower2
    Aihc.Grin.Parser
    Aihc.Grin.Pretty
    Aihc.Grin.Snapshot
    Aihc.Grin.Syntax

  other-modules:
    Aihc.Grin.Analysis
    Aihc.Grin.Lower
    Aihc.Grin.Lower.Syntax

  hs-source-dirs: src
  build-depends:
    aihc-fc,
    aihc-resolve,
    aihc-tc,
    base >=4.16 && <5,
    bytestring,
    containers,
    libffi >=0.2 && <0.3,
    megaparsec >=9.0 && <10,
    text >=1.2,
    transformers,
    unix,

  ghc-options: -Wall
  default-language: GHC2021

library fuzz
  if !flag(fuzz)
    buildable: False
  visibility: public
  hs-source-dirs:
    fuzz
    test

  exposed-modules:
    Aihc.Grin.Fuzz

  other-modules:
    Test.Grin.Arbitrary

  build-depends:
    aihc-grin,
    aihc-tc,
    base >=4.16 && <5,
    bytestring,
    hedgehog,
    tasty-hedgehog,
    text,

  ghc-options: -Wall
  default-language: GHC2021

test-suite spec
  type: exitcode-stdio-1.0
  hs-source-dirs:
    test
    ../../test/support

  main-is: Spec.hs
  other-modules:
    Test.Grin.Arbitrary

  build-depends:
    aihc-fc,
    aihc-grin,
    aihc-tc,
    base >=4.16 && <5,
    bytestring,
    containers,
    directory,
    filepath,
    hedgehog,
    tasty,
    tasty-hedgehog,
    tasty-hunit,
    text,

  ghc-options:
    -Wall
    -threaded
    -rtsopts
    "-with-rtsopts=-N -M10G"

  default-language: GHC2021
